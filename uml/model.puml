@startuml model
' Class model of the amusement park application (package es.upm.parque),
' documenting the current implementation.
' Conventions:
' - attributes only of primitive, value (String, LocalDate, BigDecimal, Path) or enumeration type;
'   references to other classes are drawn as relationships named after the holding attribute;
' - the "x" end marks the class that does not hold the reference (direction of navigation);
'   aggregation/composition diamonds sit on the holder;
' - no methods; usage (dashed) arrows only for classes that have no incoming relationship.
hide empty members
skinparam classAttributeIconSize 0

package es.upm.parque {
  class App
}

package es.upm.parque.presentation {
  class CommandProcessor {
    exitRequested : boolean
  }
  class ExecutionOptions {
    fly : boolean
    inputFile : String
  }
}

package es.upm.parque.business {
  class ParkException
}

package es.upm.parque.business.model {
  class User {
    name : String
    surname : String
    dni : String
    email : String
    password : String
    phone : String
    card : String
  }
  enum UserField {
    NAME
    SURNAME
    EMAIL
    PASSWORD
    PHONE
    CARD
  }
  class Group {
    id : String
    name : String
  }
  abstract class Ticket {
    id : String
    date : LocalDate
    price : BigDecimal
  }
  class IndividualTicket
  class GroupTicket
  class Attraction {
    id : String
    name : String
    capacity : int
  }
}

package es.upm.parque.business.controller {
  class MainController {
    currentDate : LocalDate
    ticketPrice : BigDecimal
  }
  class UserController
  class GroupController
  class TicketController
  class AttractionController
}

package es.upm.parque.business.validation {
  class UserValidator
}

package es.upm.parque.persistence {
  class UserRepository {
    file : Path
  }
  class GroupRepository {
    file : Path
  }
  class TicketRepository {
    individualFile : Path
    groupFile : Path
  }
  class AttractionRepository {
    file : Path
  }
  class TextFiles
  class DataDirectory
}

' Application wiring
App "0..*" x--> "1" CommandProcessor : processor
CommandProcessor "0..*" x--> "1" UserController : userController
CommandProcessor "0..*" x--> "1" GroupController : groupController
CommandProcessor "0..*" x--> "1" TicketController : ticketController
CommandProcessor "0..*" x--> "1" AttractionController : attractionController
CommandProcessor "0..*" x--> "1" MainController : mainController

' Managers
UserController x--> "1" UserRepository : repository
UserController x--> "0..*" User : users
GroupController x--> "1" GroupRepository : repository
GroupController x--> "1" UserController : userController
GroupController x--> "0..*" Group : groups
TicketController x--> "1" TicketRepository : repository
TicketController x--> "1" UserController : userController
TicketController x--> "1" GroupController : groupController
TicketController x--> "1" MainController : mainController
TicketController x--> "0..*" IndividualTicket : individualTickets
TicketController x--> "0..*" GroupTicket : groupTickets
AttractionController x--> "1" AttractionRepository : repository
AttractionController x--> "1" TicketController : ticketController
AttractionController x--> "1" MainController : mainController
AttractionController x--> "0..*" Attraction : attractions

' Domain
Group "0..*" x--> "0..*" User : members
Ticket <|-- IndividualTicket
Ticket <|-- GroupTicket
IndividualTicket "0..*" x--> "1" User : user
GroupTicket "0..*" o--> "1" Group : group
GroupTicket "1" *--> "0..*" IndividualTicket : tickets
Attraction "0..*" x--> "0..*" User : visitors
RuntimeException <|-- ParkException

' Usage of classes without incoming relationships
App ..> ExecutionOptions
App ..> DataDirectory
UserController ..> UserField
UserController ..> UserValidator
GroupController ..> UserValidator
TicketController ..> UserValidator
AttractionController ..> UserValidator
UserRepository ..> TextFiles
GroupRepository ..> TextFiles
TicketRepository ..> TextFiles
AttractionRepository ..> TextFiles
CommandProcessor ..> ParkException
MainController ..> ParkException
UserController ..> ParkException
GroupController ..> ParkException
TicketController ..> ParkException
AttractionController ..> ParkException
Attraction ..> ParkException
TicketRepository ..> ParkException
@enduml
