@startuml model
' Class model of the amusement park application (es.upm.parque).
' Attributes show only primitive and enumeration values; references to other
' classes are drawn as associations named after the attribute that holds them.
' The "x" end marks the class that does not know the other one.
hide empty methods
skinparam classAttributeIconSize 0

package es.upm.parque {

  class App {
    {static} USERS_FILE : Path
    {static} GROUPS_FILE : Path
    {static} TICKETS_FILE : Path
    {static} GROUP_TICKETS_FILE : Path
  }

  class CommandProcessor {
    exitRequested : boolean
  }

  class MainController {
    currentDate : LocalDate
    ticketPrice : BigDecimal
    {static} DEFAULT_TICKET_PRICE : BigDecimal
  }

  class UserManager
  class UserRepository {
    file : Path
  }

  class GroupManager
  class GroupRepository {
    file : Path
  }

  class TicketManager
  class TicketRepository {
    individualFile : Path
    groupFile : Path
  }

  abstract class Ticket {
    id : String {readOnly}
    date : LocalDate {readOnly}
    price : BigDecimal {readOnly}
  }

  class IndividualTicket
  class GroupTicket

  class User {
    name : String
    surname : String
    dni : String {readOnly}
    email : String
    password : String
    phone : String
    card : String
  }

  enum UserField {
    NAME
    SURNAME
    EMAIL
    PASSWORD
    PHONE
    CARD
  }

  class Group {
    id : String {readOnly}
    name : String {readOnly}
  }

  class UserValidator <<utility>>
  class ParkException
}

App "0..*" x--> "1" CommandProcessor : processor
CommandProcessor "0..*" x--> "1" UserManager : userManager
CommandProcessor "0..*" x--> "1" GroupManager : groupManager
CommandProcessor "0..*" x--> "1" MainController : mainController
UserManager "0..1" x--> "1" UserRepository : repository
UserManager "0..1" x--> "0..*" User : users
GroupManager "0..1" x--> "1" GroupRepository : repository
GroupManager "0..*" x--> "1" UserManager : userManager
GroupManager "0..1" x--> "0..*" Group : groups
Group "0..*" x--> "0..*" User : members
CommandProcessor "0..*" x--> "1" TicketManager : ticketManager
TicketManager "0..1" x--> "1" TicketRepository : repository
TicketManager "0..*" x--> "1" UserManager : userManager
TicketManager "0..*" x--> "1" MainController : mainController
TicketManager "0..*" x--> "1" GroupManager : groupManager
TicketManager "0..1" x--> "0..*" IndividualTicket : individualTickets
TicketManager "0..1" x--> "0..*" GroupTicket : groupTickets
Ticket <|-- IndividualTicket
Ticket <|-- GroupTicket
IndividualTicket "0..*" x--> "1" User : user
GroupTicket "0..*" o--> "1" Group : group
GroupTicket "1" *--> "0..*" IndividualTicket : tickets
RuntimeException <|-- ParkException
UserManager ..> UserField
UserManager ..> UserValidator
@enduml
