@startuml model
' Class model of the amusement-park application, derived from the current source code and organised by layer.
' Notation: no methods; attributes are primitive-like values or enumerations; every object reference is a
' relationship labelled with the holder's field name. Plain associations mark the holder end with a cross (x)
' and the referenced end with an arrow; aggregations/compositions mark the holder end with the diamond.
' Usage (dependency) arrows are drawn only for classes that have no incoming relationship.
hide empty members
skinparam classAttributeIconSize 0
set separator none

package com.parque {
  class App
  class ApplicationContext
}

package com.parque.presentation {
  class CommandRunner {
    -out : PrintStream
    -err : PrintStream
  }

  class CommandProcessor {
    -exitRequested : boolean
  }

  class HelpGenerator

  interface HelpFormatter

  class SyntaxHelpFormatter

  class ExtendedHelpFormatter

  class CommandCatalog

  class CommandInfo {
    -syntax : String
    -description : String
  }
}

package com.parque.business.controller {
  class ParkController <<Singleton>> {
    -currentDate : LocalDate
    -ticketPrice : BigDecimal
  }
}

package com.parque.business.model {
  class User {
    -name : String
    -surname : String
    -dni : String
    -email : String
    -password : String
    -phone : String
    -card : String
  }

  enum UserField {
    NAME
    SURNAME
    EMAIL
    PASSWORD
    PHONE
    CARD
  }

  class Group {
    -id : String
    -name : String
  }

  abstract class Ticket {
    -id : String
    -date : LocalDate
  }

  class IndividualTicket {
    -holderDni : String
    -price : BigDecimal
  }

  class GroupTicket {
    -groupId : String
    -unitPrice : BigDecimal
    -total : BigDecimal
  }

  class Attraction {
    -id : String
    -name : String
    -capacity : int
  }

  abstract class Pass {
    -id : String
    -price : BigDecimal
    -consumed : boolean
  }

  class SpeedPass

  class SpecialPass

  class Invoice {
    -recipient : String
    -total : BigDecimal
  }

  class InvoiceSection {
    -title : String
  }

  class InvoiceLine {
    -description : String
    -amount : BigDecimal
  }
}

package com.parque.business.service {
  class UserValidator
  class UserService
  interface PasswordHasher
  class BCryptPasswordHasher {
    -logRounds : int
  }
  class GroupService
  class TicketService
  class AttractionService
  class PassService
  class InvoiceDirector
  abstract class InvoiceBuilder {
    -recipient : String
  }
  class UserInvoiceBuilder
  class GroupInvoiceBuilder
}

package com.parque.persistence {
  class DataDirectory
  class UserRepository {
    -file : Path
  }
  class GroupRepository {
    -file : Path
  }
  class TicketRepository {
    -file : Path
  }
  class GroupTicketRepository {
    -file : Path
  }
  class AttractionRepository {
    -file : Path
  }
  class PassRepository {
    -file : Path
  }
}

' Inheritance
Ticket <|-- IndividualTicket
Ticket <|-- GroupTicket
InvoiceBuilder <|-- UserInvoiceBuilder
InvoiceBuilder <|-- GroupInvoiceBuilder

' Presentation
CommandRunner "0..*" x--> "1" CommandProcessor : processor
CommandProcessor "1" x--> "1" ParkController : controller
CommandProcessor "0..*" x--> "1" HelpGenerator : help
CommandProcessor "0..*" x--> "1" HelpGenerator : extendedHelp
HelpGenerator "0..*" x--> "1" CommandCatalog : catalog
HelpGenerator "0..*" x--> "1" HelpFormatter : formatter
CommandCatalog "1" *--> "0..*" CommandInfo : commands
HelpFormatter <|.. SyntaxHelpFormatter
HelpFormatter <|.. ExtendedHelpFormatter

'' Main controller (Singleton per execution, collaborators injected at startup)
ParkController "1" x--> "0..1" ParkController : instance
ParkController "1" x--> "1" InvoiceDirector : invoiceDirector
ParkController "1" x--> "1" UserService : users
ParkController "1" x--> "1" GroupService : groups
ParkController "1" x--> "1" TicketService : tickets
ParkController "1" x--> "1" AttractionService : attractions
ParkController "1" x--> "1" PassService : passes

' Users
UserService "1" x--> "1" UserRepository : repository
UserService "0..*" x--> "1" PasswordHasher : hasher
PasswordHasher <|.. BCryptPasswordHasher
UserService "1" o--> "0..*" User : users

' Groups
GroupService "1" x--> "1" GroupRepository : repository
GroupService "0..*" x--> "1" UserService : users
GroupService "1" o--> "0..*" Group : groups
Group "0..*" o--> "0..*" User : members

' Tickets
TicketService "1" x--> "1" TicketRepository : repository
TicketService "1" x--> "1" GroupTicketRepository : groupRepository
TicketService "0..*" x--> "1" UserService : users
TicketService "0..*" x--> "1" GroupService : groups
TicketService "1" o--> "0..*" IndividualTicket : tickets
TicketService "1" o--> "0..*" GroupTicket : groupTickets
IndividualTicket "0..*" x--> "0..1" User : user
GroupTicket "0..*" o--> "0..1" Group : group
GroupTicket "0..1" *--> "1..*" IndividualTicket : constituents

' Attractions
AttractionService "1" x--> "1" AttractionRepository : repository
AttractionService "1" o--> "0..*" Attraction : attractions
Attraction "0..*" o--> "0..*" User : present

''' Passes
Pass <|-- SpeedPass
Pass <|-- SpecialPass
Pass "0..*" x--> "1" IndividualTicket : ticket
PassService "1" x--> "1" PassRepository : repository
PassService "0..*" x--> "1" TicketService : tickets
PassService "1" o--> "0..*" Pass : passes
UserInvoiceBuilder "0..*" o--> "0..*" Pass : passes

' Invoices
Invoice "1" *--> "0..*" InvoiceSection : sections
InvoiceSection "1" *--> "1..*" InvoiceLine : lines
InvoiceBuilder "1" *--> "0..*" InvoiceSection : sections
UserInvoiceBuilder "0..*" x--> "1" User : user
UserInvoiceBuilder "0..*" o--> "0..*" IndividualTicket : directTickets
GroupInvoiceBuilder "0..*" x--> "1" Group : group
GroupInvoiceBuilder "0..*" o--> "0..*" GroupTicket : groupTickets

' Usage of classes without incoming relationships
App ..> CommandRunner : <<use>>
App ..> DataDirectory : <<use>>
App ..> ApplicationContext : <<use>>
PassService ..> SpeedPass : <<use>>
PassService ..> SpecialPass : <<use>>
PassRepository ..> SpeedPass : <<use>>
PassRepository ..> SpecialPass : <<use>>
ApplicationContext ..> BCryptPasswordHasher : <<use>>
ApplicationContext ..> SyntaxHelpFormatter : <<use>>
ApplicationContext ..> ExtendedHelpFormatter : <<use>>
User ..> UserField : <<use>>
UserService ..> UserField : <<use>>
ParkController ..> UserField : <<use>>
CommandProcessor ..> UserField : <<use>>
UserService ..> UserValidator : <<use>>
GroupService ..> UserValidator : <<use>>
TicketService ..> UserValidator : <<use>>
AttractionService ..> UserValidator : <<use>>
ParkController ..> UserInvoiceBuilder : <<use>>
ParkController ..> GroupInvoiceBuilder : <<use>>
ParkController ..> Invoice : <<use>>
@enduml
