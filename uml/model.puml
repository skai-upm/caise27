@startuml model
' Amusement park - class model of the current implementation (layered packages)
hide empty members
hide circle
skinparam classAttributeIconSize 0

package es.upm.parque {
  class App
}

package es.upm.parque.presentation {
  class BusinessControllers <<record>>
  class CommandRunner
  class CommandProcessor {
    exitRequested : boolean
  }
}

package es.upm.parque.presentation.help {
  class HelpGenerator
  class CommandCatalog
  class CommandInfo {
    operation : String
    syntax : String
    description : String
  }
  interface HelpFormatter
  class SyntaxHelpFormatter
  class ExtendedHelpFormatter
}

package es.upm.parque.business {
  class BusinessException
}

package es.upm.parque.business.controller {
  class UserController <<Singleton>>
  class GroupController <<Singleton>>
  class TicketController <<Singleton>> {
    currentPrice : BigDecimal
  }
  class AttractionController <<Singleton>>
  class InvoiceController <<Singleton>>
  class PassController <<Singleton>>
}

package es.upm.parque.business.invoice {
  interface InvoiceBuilder
  class TextInvoiceBuilder {
    title : String
    recipient : String
    sectionTitle : String
    total : BigDecimal
  }
  class Invoice {
    title : String
    recipient : String
    total : BigDecimal
  }
  class InvoiceSection {
    title : String
  }
  class InvoiceLine {
    description : String
    amount : BigDecimal
  }
}

package es.upm.parque.business.security {
  class PasswordHasher {
    logRounds : int
  }
}

package es.upm.parque.business.validation {
  class UserValidator
}

package es.upm.parque.business.model {
  class SystemDate {
    current : LocalDate
  }
  class User {
    name : String
    surname : String
    dni : String
    email : String
    password : String
    phone : String
    card : String
  }
  enum UserField {
    NAME
    SURNAME
    EMAIL
    PASSWORD
    PHONE
    CARD
  }
  class Group {
    id : String
    name : String
  }
  abstract class Ticket {
    id : String
    date : LocalDate
  }
  class IndividualTicket {
    price : BigDecimal
  }
  class GroupTicket {
    discountPercent : int
  }
  abstract class Pass {
    id : String
    price : BigDecimal
    consumed : boolean
  }
  class SpeedPass
  class SpecialPass
  class Attraction {
    id : String
    name : String
    capacity : int
  }
}

package es.upm.parque.persistence {
  class UserRepository {
    file : Path
  }
  class GroupRepository {
    file : Path
  }
  class TicketRepository {
    ticketsFile : Path
    groupTicketsFile : Path
  }
  class PassRepository {
    file : Path
  }
  class AttractionRepository {
    file : Path
  }
}

' Inheritance
Ticket <|-- IndividualTicket
Ticket <|-- GroupTicket
Pass <|-- SpeedPass
Pass <|-- SpecialPass
RuntimeException <|-- BusinessException
InvoiceBuilder <|.. TextInvoiceBuilder
HelpFormatter <|.. SyntaxHelpFormatter
HelpFormatter <|.. ExtendedHelpFormatter

' Associations (cross = holder of the attribute, arrow = navigable end)
CommandRunner x--> "1" CommandProcessor : processor
CommandProcessor x--> "1" UserController : userController
CommandProcessor x--> "1" GroupController : groupController
CommandProcessor x--> "1" TicketController : ticketController
CommandProcessor x--> "1" AttractionController : attractionController
CommandProcessor x--> "1" InvoiceController : invoiceController
CommandProcessor x--> "1" SystemDate : systemDate
CommandProcessor x--> "1" HelpGenerator : helpGenerator
HelpGenerator x--> "1" CommandCatalog : catalog
HelpGenerator x--> "0..*" HelpFormatter : formatters
CommandCatalog x--> "0..*" CommandInfo : commands

UserController x--> "1" UserRepository : repository
UserController x--> "1" PasswordHasher : hasher
UserController x--> "0..*" User : users

GroupController x--> "1" GroupRepository : repository
GroupController x--> "1" UserController : userController
GroupController x--> "0..*" Group : groups
Group x--> "0..*" User : members

TicketController x--> "1" TicketRepository : repository
TicketController x--> "1" UserController : userController
TicketController x--> "1" GroupController : groupController
TicketController x--> "1" SystemDate : systemDate
TicketController x--> "0..*" Ticket : tickets
IndividualTicket x--> "1" User : user
GroupTicket o--> "1" Group : group
GroupTicket "1" *--> "1..*" IndividualTicket : tickets

AttractionController x--> "1" AttractionRepository : repository
AttractionController x--> "1" TicketController : ticketController
AttractionController x--> "1" SystemDate : systemDate
AttractionController x--> "0..*" Attraction : attractions
Attraction x--> "0..*" User : visitors

InvoiceController x--> "1" UserController : userController
InvoiceController x--> "1" GroupController : groupController
InvoiceController x--> "1" TicketController : ticketController
InvoiceController x--> "1" InvoiceBuilder : builder
TextInvoiceBuilder x--> "0..*" InvoiceSection : sections
TextInvoiceBuilder x--> "0..*" InvoiceLine : sectionLines
Invoice "1" *--> "0..*" InvoiceSection : sections
InvoiceSection "1" *--> "1..*" InvoiceLine : lines

CommandProcessor x--> "1" PassController : passController
InvoiceController x--> "1" PassController : passController
PassController x--> "1" PassRepository : repository
PassController x--> "1" TicketController : ticketController
PassController x--> "1" SystemDate : systemDate
PassController x--> "0..*" Pass : passes
Pass x--> "1" IndividualTicket : ticket
BusinessControllers x--> "1" UserController : users
BusinessControllers x--> "1" GroupController : groups
BusinessControllers x--> "1" TicketController : tickets
BusinessControllers x--> "1" AttractionController : attractions
BusinessControllers x--> "1" InvoiceController : invoices
BusinessControllers x--> "1" PassController : passes

' Usage of classes without incoming relationships
App ..> CommandRunner
App ..> BusinessControllers
CommandProcessor ..> BusinessControllers
TextInvoiceBuilder ..> Invoice
InvoiceController ..> BusinessException
UserController ..> UserValidator
UserController ..> UserField
UserController ..> BusinessException
GroupController ..> BusinessException
TicketController ..> BusinessException
AttractionController ..> BusinessException
Attraction ..> BusinessException

@enduml
