@startuml model
' Amusement park - class model of the current implementation (package es.upm.etsisi.amusementpark).
' Notation: no methods; attributes only of primitive, String, value or enum types; references to model
' classes drawn as lines named after the holder's attribute, with a cross (or diamond) at the holder end.
hide empty members
hide circle
skinparam classAttributeIconSize 0

package es.upm.etsisi.amusementpark {

  class App

  note top of App
    Entry point: java -jar amusement-park.jar [commandFile]
  end note

  class CommandProcessor {
    - exitRequested : boolean
    - currentDate : LocalDate
    - currentPrice : BigDecimal
  }

  class User {
    - name : String
    - surname : String
    - dni : String
    - email : String
    - password : String
    - phone : String
    - card : String
  }

  enum UserField {
    NAME
    SURNAME
    EMAIL
    PASSWORD
    PHONE
    CARD
  }

  class UserValidator

  class UserService

  class UserFileStorage {
    - file : Path
  }

  class Group {
    - id : String
    - name : String
  }

  class GroupService

  class GroupFileStorage {
    - file : Path
  }

  abstract class ParkTicket {
    - id : String
    - date : LocalDate
  }

  class Ticket {
    - price : BigDecimal
    - ownerDni : String
  }

  class GroupTicket {
    - groupId : String
    - unitPrice : BigDecimal
    - price : BigDecimal
  }

  class TicketService

  class TicketFileStorage {
    - file : Path
  }

  class GroupTicketFileStorage {
    - file : Path
  }

  class Attraction {
    - id : String
    - name : String
    - capacity : int
  }

  class AttractionService

  class AttractionFileStorage {
    - file : Path
  }
}

' --- inheritance
ParkTicket <|-- Ticket
ParkTicket <|-- GroupTicket

' --- controller
CommandProcessor x--> "1" UserService : users
CommandProcessor x--> "1" GroupService : groups
CommandProcessor x--> "1" TicketService : tickets
CommandProcessor x--> "1" AttractionService : attractions

' --- users
UserService x--> "1" UserFileStorage : storage
UserService o--> "*" User : users

' --- groups
GroupService x--> "1" GroupFileStorage : storage
GroupService x--> "1" UserService : users
GroupService o--> "*" Group : groups
Group o--> "*" User : members

' --- tickets
TicketService x--> "1" TicketFileStorage : storage
TicketService x--> "1" GroupTicketFileStorage : groupStorage
TicketService x--> "1" UserService : users
TicketService o--> "*" Ticket : tickets
TicketService o--> "*" GroupTicket : groupTickets
Ticket x--> "0..1" User : user
GroupTicket o--> "0..1" Group : group
GroupTicket *--> "1..*" Ticket : tickets

' --- attractions
AttractionService x--> "1" AttractionFileStorage : storage
AttractionService o--> "*" Attraction : attractions
Attraction o--> "*" User : present

' --- usage of classes without incoming relationships
App ..> CommandProcessor : creates
UserService ..> UserValidator
GroupService ..> UserValidator
TicketService ..> UserValidator
AttractionService ..> UserValidator
User ..> UserField
UserService ..> UserField
CommandProcessor ..> UserField
@enduml
