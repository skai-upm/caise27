@startuml
title Amusement Park - class model (Delivery 3)

skinparam classAttributeIconSize 0
hide empty methods

package "es.upm.amusementpark.business.model" {
  class User {
    - firstName : String
    - surnames : String
    - {final} dni : String
    - email : String
    - passwordHash : String
    - phone : String
    - card : String
  }

  enum UserField {
    NAME
    SURNAME
    EMAIL
    PASSWORD
    PHONE
    CARD
  }

  class Group {
    - identifier : String
    - name : String
  }

  abstract class Ticket {
    - identifier : String
    - date : LocalDate
    - price : BigDecimal
  }

  class IndividualTicket {
  }

  class GroupTicket {
  }

  abstract class Pass {
    - identifier : String
    - price : BigDecimal
    - consumed : boolean
  }

  class SpeedPass
  class SpecialPass

  interface AccessTicket
  interface IndividualAccess
  interface GroupAccess
  interface PassLookup
  class Entry <<record>>

  abstract class Attraction<T extends AccessTicket> {
    - identifier : String
    - name : String
    - capacity : int
    - accessType : Class<T>
  }
  class GeneralAttraction
  class IndividualAttraction
  class GroupAttraction
  class SpecialAttraction

  enum AttractionType {
    GENERAL
    INDIVIDUAL
    GROUP
    SPECIAL
  }
}

package "es.upm.amusementpark.business.control" {
  class InvoiceController <<singleton>>
  class ParkController <<singleton>> {
    - {static} DEFAULT_PRICE : BigDecimal
    - currentDate : LocalDate
    - basePrice : BigDecimal
  }
}

package "es.upm.amusementpark.business.validation" {
  class UserDataValidator <<utility>>
}

package "es.upm.amusementpark.business.security" {
  class PasswordProtector
}

package "es.upm.amusementpark.business.repository" {
  interface UserRepository
  interface GroupRepository
  interface TicketRepository
  interface AttractionRepository
  interface PassRepository
  class Repositories <<record>>
}

package "es.upm.amusementpark.business.invoice" {
  class Invoice {
    - title : String
    - total : BigDecimal
  }
  class InvoiceSection {
    - title : String
  }
  class InvoiceLine {
    - description : String
    - amount : BigDecimal
  }
  abstract class InvoiceBuilder {
    - title : String
  }
  class UserInvoiceBuilder
  class GroupInvoiceBuilder
  class InvoiceDirector
}

package "es.upm.amusementpark.business.exception" {
  class ParkException
  class ElementNotFoundException
  class DuplicateElementException
  class InvalidValueException
  class OperationNotAllowedException
}

package "es.upm.amusementpark.persistence" {
  abstract class TextFileRepository {
    - file : Path
  }
  class DataDirectories <<utility>>
  class PersistenceException
  class TextFileUserRepository
  class TextFileGroupRepository
  class TextFileTicketRepository
  class TextFileAttractionRepository
  class TextFilePassRepository
  class TextFileRepositories <<factory>>
}

package "es.upm.amusementpark.presentation" {
  class CommandProcessor {
    - out : PrintStream
  }
  class InvalidCommandException
  class CommandInfo <<record>> {
    - syntax : String
    - description : String
  }
  class CommandCatalog
  interface HelpFormatter
  class SyntaxHelpFormatter
  class ExtendedHelpFormatter
  class HelpGenerator
}

package "es.upm.amusementpark" {
  class App
}

' --- ticket hierarchy
Ticket <|-- IndividualTicket
Ticket <|-- GroupTicket

' --- relationships among users, groups, tickets and attractions (unidirectional)
IndividualTicket --> "1" User : user
GroupTicket *--> "1..*" IndividualTicket : composition
GroupTicket --> "0..1" Group : group
Group o--> "0..*" User : members
Attraction --> "0..*" User : occupants
AccessTicket <|-- IndividualAccess
AccessTicket <|-- GroupAccess
AccessTicket <|.. Ticket
IndividualAccess <|.. IndividualTicket
GroupAccess <|.. GroupTicket
Attraction <|-- GeneralAttraction : <T = AccessTicket>
Attraction <|-- IndividualAttraction : <T = IndividualAccess>
Attraction <|-- GroupAttraction : <T = GroupAccess>
Attraction <|-- SpecialAttraction : <T = IndividualAccess>
Attraction ..> PassLookup : finds passes to consume
Attraction ..> Entry : returns
Entry --> "0..*" User : entrants
Entry --> "0..*" Pass : consumedPasses
Attraction ..> AttractionType : type
ParkController ..|> PassLookup : provides
Pass <|-- SpeedPass
Pass <|-- SpecialPass
Pass --> "1" IndividualTicket : ticket
SpeedPass "0..*" --> "1" IndividualTicket : any number per ticket
SpecialPass "0..1" --> "1" IndividualTicket : at most one per ticket

' --- central management
ParkController o--> "0..*" User : users
ParkController o--> "0..*" Group : groups
ParkController o--> "0..*" Ticket : tickets
ParkController o--> "0..*" Attraction : attractions
ParkController o--> "0..*" Pass : passes

' --- persistence
TextFileRepository <|-- TextFileUserRepository
TextFileRepository <|-- TextFileGroupRepository
TextFileRepository <|-- TextFileTicketRepository
TextFileRepository <|-- TextFileAttractionRepository
TextFileRepository <|-- TextFilePassRepository
PassRepository <|.. TextFilePassRepository
Repositories --> "1" PassRepository : passes
UserRepository <|.. TextFileUserRepository
GroupRepository <|.. TextFileGroupRepository
TicketRepository <|.. TextFileTicketRepository
AttractionRepository <|.. TextFileAttractionRepository
Repositories --> "1" UserRepository : users
Repositories --> "1" GroupRepository : groups
Repositories --> "1" TicketRepository : tickets
Repositories --> "1" AttractionRepository : attractions
TextFileRepositories ..> Repositories : creates
ParkController --> "0..1" Repositories : injected
ParkController *--> "1" PasswordProtector : passwords
ParkController ..> UserDataValidator : validates
ParkController ..> UserField : updates

''' --- invoices (Builder)
InvoiceBuilder <|-- UserInvoiceBuilder
InvoiceBuilder <|-- GroupInvoiceBuilder
InvoiceBuilder *--> "0..*" InvoiceSection : sections
Invoice *--> "0..*" InvoiceSection : sections
InvoiceSection *--> "1..*" InvoiceLine : lines
InvoiceBuilder ..> Invoice : builds
InvoiceDirector ..> UserInvoiceBuilder : directs
InvoiceDirector ..> GroupInvoiceBuilder : directs
InvoiceController --> "1" ParkController : injected
InvoiceController --> "1" InvoiceDirector : injected

' --- exceptions
RuntimeException <|-- ParkException
ParkException <|-- ElementNotFoundException
ParkException <|-- DuplicateElementException
ParkException <|-- InvalidValueException
ParkException <|-- OperationNotAllowedException
RuntimeException <|-- PersistenceException
RuntimeException <|-- InvalidCommandException
ParkController ..> ParkException : throws
TextFileRepository ..> PersistenceException : throws

' --- command interface
CommandProcessor --> "1" ParkController : park
CommandProcessor --> "1" InvoiceController : invoices
CommandProcessor --> "1" HelpGenerator : help
CommandProcessor --> "1" HelpGenerator : extendedHelp
HelpGenerator --> "1" CommandCatalog : catalog
HelpGenerator --> "1" HelpFormatter : formatter (injected)
HelpFormatter <|.. SyntaxHelpFormatter
HelpFormatter <|.. ExtendedHelpFormatter
CommandCatalog *--> "1..*" CommandInfo : commands
App ..> CommandProcessor : creates
App ..> TextFileRepositories : creates and injects repositories
App ..> DataDirectories : selects data directory

@enduml
