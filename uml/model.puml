@startuml model
' Amusement Park - Delivery 2 class model (package es.upm.etsisi.park).
' Methods and constructors are omitted; only relevant attributes are shown.
hide empty members
skinparam classAttributeIconSize 0

package es.upm.etsisi.park {
  class Park <<singleton>> {
    - {static} INSTANCE : Park
    - currentDate : LocalDate
    - basePrice : BigDecimal
  }

  class User {
    - firstName : String
    - surnames : String
    - dni : String {readOnly}
    - email : String
    - password : String
    - phone : String
    - card : String
  }

  enum UserField {
    NAME
    SURNAME
    EMAIL
    PASSWORD
    PHONE
    CARD
  }

  class Group {
    - id : String
    - name : String
  }

  abstract class Ticket {
    - id : String
    - date : LocalDate
  }

  class IndividualTicket {
    - basePrice : BigDecimal
    - discountPercent : int
  }

  class GroupTicket

  class Attraction {
    - id : String
    - name : String
    - capacity : int
  }

  class ValidationException

  class UserService
  class SystemService
  class GroupService
  class TicketService
  class AttractionService
  class UserValidator <<utility>>

  class ParkStorage
  abstract class TextFileRepository
  class UserRepository
  class GroupRepository
  class TicketRepository
  class AttractionRepository

  class App
  class CommandRunner
  class CommandProcessor
}

' ---- ticket hierarchy ----
Ticket <|-- IndividualTicket
Ticket <|-- GroupTicket

' ---- domain relationships (directions as implemented) ----
Park "1" o--> "0..*" User : users
Park "1" o--> "0..*" Group : groups
Park "1" o--> "0..*" Ticket : tickets\n(standalone and group)
Park "1" o--> "0..*" Attraction : attractions
Park --> "1" ParkStorage : storage

Group "0..*" --> "0..*" User : members
IndividualTicket "0..*" --> "1" User : user
GroupTicket "1" *--> "1..*" IndividualTicket : composition
GroupTicket "0..*" --> "0..1" Group : group
Attraction "0..*" --> "0..*" User : occupants

' ---- services ----
UserService --> "1" Park : park
SystemService --> "1" Park : park
GroupService --> "1" Park : park
TicketService --> "1" Park : park
AttractionService --> "1" Park : park
UserService ..> UserField
UserService ..> UserValidator
Exception <|-- ValidationException

' ---- persistence ----
TextFileRepository <|-- UserRepository
TextFileRepository <|-- GroupRepository
TextFileRepository <|-- TicketRepository
TextFileRepository <|-- AttractionRepository
ParkStorage "1" *--> "1" UserRepository : users
ParkStorage "1" *--> "1" GroupRepository : groups
ParkStorage "1" *--> "1" TicketRepository : tickets
ParkStorage "1" *--> "1" AttractionRepository : attractions

' ---- application ----
App ..> Park : getInstance()
App ..> CommandRunner
CommandRunner --> "1" CommandProcessor : processor
CommandProcessor --> "1" UserService : users
CommandProcessor --> "1" SystemService : system
CommandProcessor --> "1" GroupService : groups
CommandProcessor --> "1" TicketService : tickets
CommandProcessor --> "1" AttractionService : attractions
@enduml
