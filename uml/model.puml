@startuml model
title Amusement Park - Delivery 3 class model
hide empty methods
hide empty members
skinparam classAttributeIconSize 0

package "es.upm.amusementpark.business.model" {
  class User {
    - firstName : String
    - surnames : String
    - dni : String {readOnly}
    - email : String
    - password : String
    - phone : String
    - cardNumber : String
  }

  enum UserField {
    NAME
    SURNAME
    EMAIL
    PASSWORD
    PHONE
    CARD
  }

  class UserValidator <<utility>> {
    - {static} DNI_LETTERS : String
  }

  class Group {
    - id : String {readOnly}
    - name : String
  }

  interface AttractionAccess
  interface IndividualAccess
  interface GroupAccess

  abstract class Ticket {
    - id : String {readOnly}
    - date : LocalDate {readOnly}
    - basePrice : BigDecimal {readOnly}
    - discountRate : BigDecimal {readOnly}
  }

  class IndividualTicket
  class GroupTicket

  abstract class Pass {
    - id : String {readOnly}
    - price : BigDecimal {readOnly}
    - consumed : boolean
  }

  class SpeedPass
  class SpecialPass

  enum AttractionType {
    GENERAL
    INDIVIDUAL
    GROUP
    SPECIAL
  }

  abstract class Attraction<T extends AttractionAccess> {
    - id : String {readOnly}
    - name : String
    - capacity : int {readOnly}
    - accessType : Class<T> {readOnly}
  }

  class GeneralAttraction
  class IndividualAttraction
  class GroupAttraction
  class SpecialAttraction

  interface PassLookup <<functional>>

  class EntryResult <<record>>
}

package "es.upm.amusementpark.business.invoice" {
  interface InvoiceBuilder
  class StandardInvoiceBuilder
  class Invoice {
    - type : Type {readOnly}
    - total : BigDecimal {readOnly}
  }
  class InvoiceSection <<record>> {
    - title : String
  }
  class InvoiceItem <<record>> {
    - description : String
    - amount : BigDecimal
  }
  class InvoiceController <<singleton>>
}

package "es.upm.amusementpark.business.controller" {
  class ParkController <<singleton>> {
    - currentDate : LocalDate
    - currentPrice : BigDecimal
  }
  class UserController <<singleton>>
  class GroupController <<singleton>>
  class TicketController <<singleton>>
  class PassController <<singleton>>
  class AttractionController <<singleton>>
  class ApplicationInitializer <<composition root>>
}

package "es.upm.amusementpark.business.security" {
  interface PasswordHasher
  class BCryptPasswordHasher {
    - logRounds : int {readOnly}
  }
}

package "es.upm.amusementpark.business.exception" {
  class ParkException
}

package "es.upm.amusementpark.persistence.repository" {
  class UserRepository
  class GroupRepository
  class TicketRepository
  class PassRepository
  class AttractionRepository
}

package "es.upm.amusementpark.persistence" {
  class DataPaths
  class TemporaryDataDirectory
  class UserFileStore
  class GroupFileStore
  class TicketFileStore
  class PassFileStore
  class AttractionFileStore
}

package "es.upm.amusementpark.presentation" {
  class Main
  class CommandProcessor
  package help {
    class HelpGenerator
    interface HelpFormatter
    class SyntaxHelpFormatter
    class ExtendedHelpFormatter
    class CommandCatalog
  }
}

' ===== tickets, access capabilities and passes =====
Ticket <|-- IndividualTicket
Ticket <|-- GroupTicket
AttractionAccess <|-- IndividualAccess
AttractionAccess <|-- GroupAccess
AttractionAccess <|.. Ticket
IndividualAccess <|.. IndividualTicket
GroupAccess <|.. GroupTicket

IndividualTicket "0..*" --> "1" User : user
GroupTicket "1" *--> "1..*" IndividualTicket : composition
GroupTicket "0..*" --> "0..1" Group : group
Group "0..*" --> "0..*" User : members

Pass <|-- SpeedPass
Pass <|-- SpecialPass
SpeedPass "0..*" --> "1" IndividualTicket : ticket
SpecialPass "0..1" --> "1" IndividualTicket : ticket

' ===== generic attractions =====
Attraction <|-- GeneralAttraction : <<bind>> T = AttractionAccess
Attraction <|-- IndividualAttraction : <<bind>> T = IndividualAccess
Attraction <|-- GroupAttraction : <<bind>> T = GroupAccess
Attraction <|-- SpecialAttraction : <<bind>> T = IndividualAccess
Attraction "0..*" --> "0..*" User : occupants
Attraction ..> AttractionType : type
Attraction ..> PassLookup : uses on entry
Attraction ..> EntryResult : creates
EntryResult --> "1..*" User : users
EntryResult --> "0..*" Pass : consumedPasses
UserValidator ..> User : validates
UserField ..> User : modifiable attributes

' ===== invoices (Builder) =====
InvoiceBuilder <|.. StandardInvoiceBuilder
StandardInvoiceBuilder ..> Invoice : builds
Invoice "1" *--> "0..*" InvoiceSection : sections
InvoiceSection "1" *--> "1..*" InvoiceItem : items
InvoiceController --> "1" InvoiceBuilder : builder (director)
InvoiceController --> UserRepository
InvoiceController --> GroupRepository
InvoiceController --> TicketRepository
InvoiceController --> PassRepository

' ===== controllers and injected dependencies =====
ParkController --> "1" UserRepository : users
ParkController --> "1" GroupRepository : groups
ParkController --> "1" TicketRepository : tickets
ParkController --> "1" AttractionRepository : attractions
UserController --> UserRepository
UserController --> ParkController
UserController --> "1" PasswordHasher : hasher
PasswordHasher <|.. BCryptPasswordHasher
GroupController --> GroupRepository
GroupController --> UserRepository
GroupController --> ParkController
TicketController --> TicketRepository
TicketController --> UserRepository
TicketController --> GroupRepository
TicketController --> ParkController
TicketController --> PassController : cascade refunds
PassController --> PassRepository
PassController --> TicketRepository
PassController --> ParkController
AttractionController --> AttractionRepository
AttractionController --> TicketRepository
AttractionController --> PassRepository
AttractionController --> ParkController
ApplicationInitializer ..> ParkController : injects
ApplicationInitializer ..> UserController : injects
ApplicationInitializer ..> GroupController : injects
ApplicationInitializer ..> TicketController : injects
ApplicationInitializer ..> PassController : injects
ApplicationInitializer ..> AttractionController : injects
ApplicationInitializer ..> InvoiceController : injects
ApplicationInitializer ..> DataPaths
ApplicationInitializer ..> TemporaryDataDirectory : --fly
ApplicationInitializer ..> ParkException
UserRepository o--> "0..*" User
GroupRepository o--> "0..*" Group
TicketRepository o--> "0..*" Ticket
PassRepository o--> "0..*" Pass
AttractionRepository o--> "0..*" Attraction
UserRepository --> "0..1" UserFileStore : store
GroupRepository --> "0..1" GroupFileStore : store
TicketRepository --> "0..1" TicketFileStore : store
PassRepository --> "0..1" PassFileStore : store
AttractionRepository --> "0..1" AttractionFileStore : store

' ===== presentation =====
Main ..> ApplicationInitializer : starts
Main ..> CommandProcessor
CommandProcessor --> "2" HelpGenerator : help, extendedHelp (injected)
HelpGenerator --> "1" HelpFormatter : formatter (injected)
HelpGenerator --> "1" CommandCatalog
HelpFormatter <|.. SyntaxHelpFormatter
HelpFormatter <|.. ExtendedHelpFormatter
CommandProcessor ..> UserController
CommandProcessor ..> GroupController
CommandProcessor ..> TicketController
CommandProcessor ..> PassController
CommandProcessor ..> AttractionController
CommandProcessor ..> InvoiceController
@enduml
