@startuml model
' Class model of the Amusement Park application (Delivery 3).
' Attributes hold only primitive values and enumerations; references to other classes are drawn as
' relationships named after the attribute that holds them, with a cross on the non-navigable end.
' Usage (dependency) arrows are only drawn for classes that have no incoming relationship.
' Classes are grouped below by package (layer) in comments; package frames are not drawn because the bundled
' Smetana layout engine cannot render them.
!pragma layout smetana
skinparam classAttributeIconSize 0
hide methods
hide empty members

' ---- es.upm.parque ----
  class App
  class ParkApplication

' ---- es.upm.parque.presentation ----
  class CommandProcessor {
    finished : boolean
  }
  class ConsoleRunner
  class ParkCommands

' ---- es.upm.parque.presentation.command ----
    interface Command
    class SimpleCommand {
      keyword : String
      syntaxes : List<String>
      description : String
    }
    class CommandRegistry

' ---- es.upm.parque.presentation.help ----
    class HelpGenerator
    interface HelpFormatter
    class SyntaxHelpFormatter
    class ExtendedHelpFormatter

' ---- es.upm.parque.business.controller ----
    class ParkController <<Singleton>> {
      currentDate : LocalDate
      ticketPrice : BigDecimal
    }
    class UserController <<Singleton>>
    class GroupController <<Singleton>>
    class TicketController <<Singleton>>
    class PassController <<Singleton>>
    class AttractionController <<Singleton>>
    class InvoiceController <<Singleton>>

' ---- es.upm.parque.business.model ----
    class User {
      name : String
      surname : String
      dni : String
      email : String
      passwordHash : String
      phone : String
      card : String
    }
    enum UserField {
      NAME
      SURNAME
      EMAIL
      PASSWORD
      PHONE
      CARD
    }
    class Group {
      id : String
      name : String
    }
    interface AccessCapability
    interface IndividualAccess
    interface GroupAccess
    abstract class Ticket {
      id : String
      date : LocalDate
    }
    class IndividualTicket {
      price : BigDecimal
      specialPassPurchased : boolean
    }
    class GroupTicket {
      price : BigDecimal
    }
    abstract class Pass {
      id : String
      price : BigDecimal
      consumed : boolean
    }
    class SpeedPass
    class SpecialPass
    abstract class "Attraction<T extends AccessCapability>" as Attraction {
      id : String
      name : String
      capacity : int
    }
    class GeneralAttraction
    class IndividualAttraction
    class GroupAttraction
    class SpecialAttraction
    enum AttractionType {
      GENERAL
      INDIVIDUAL
      GROUP
      SPECIAL
    }
    class EntryResult <<record>> {
      users : int
    }

' ---- es.upm.parque.business.invoice ----
    interface InvoiceBuilder
    class StandardInvoiceBuilder {
      header : String
    }
    class InvoiceDirector
    class Invoice {
      header : String
    }
    class InvoiceSection <<record>> {
      title : String
    }
    class InvoiceLine <<record>> {
      description : String
      amount : BigDecimal
    }

' ---- es.upm.parque.business.security ----
    interface PasswordEncoder
    class BCryptPasswordEncoder {
      logRounds : int
    }

' ---- es.upm.parque.business.validation ----
    class UserValidator

' ---- es.upm.parque.persistence ----
  interface UserRepository
  interface GroupRepository
  interface TicketRepository
  interface AttractionRepository
  class FileUserRepository
  class FileGroupRepository
  class FileTicketRepository
  class FileAttractionRepository
  class TextFileStore {
    file : Path
  }
  class StoragePaths {
    directory : Path
  }

' ---- Inheritance and realization ----------------------------------------------------------------------
AccessCapability <|-- IndividualAccess
AccessCapability <|-- GroupAccess
AccessCapability <|.. Ticket
Ticket <|-- IndividualTicket
Ticket <|-- GroupTicket
IndividualAccess <|.. IndividualTicket
GroupAccess <|.. GroupTicket
Pass <|-- SpeedPass
Pass <|-- SpecialPass
Attraction <|-- GeneralAttraction : <<bind>> T -> AccessCapability
Attraction <|-- IndividualAttraction : <<bind>> T -> IndividualAccess
Attraction <|-- GroupAttraction : <<bind>> T -> GroupAccess
Attraction <|-- SpecialAttraction : <<bind>> T -> IndividualAccess
Command <|.. SimpleCommand
HelpFormatter <|.. SyntaxHelpFormatter
HelpFormatter <|.. ExtendedHelpFormatter
InvoiceBuilder <|.. StandardInvoiceBuilder
PasswordEncoder <|.. BCryptPasswordEncoder
UserRepository <|.. FileUserRepository
GroupRepository <|.. FileGroupRepository
TicketRepository <|.. FileTicketRepository
AttractionRepository <|.. FileAttractionRepository

' ---- Presentation ------------------------------------------------------------------------------------
ConsoleRunner "0..*" x--> "1" CommandProcessor : processor
CommandProcessor "0..*" x--> "1" CommandRegistry : registry
CommandRegistry "1" x--> "0..*" Command : commands
HelpGenerator "0..*" x--> "1" CommandRegistry : registry
HelpGenerator "0..*" x--> "1" HelpFormatter : formatter

' ---- Controllers -------------------------------------------------------------------------------------
UserController "1" x--> "0..*" User : users
UserController "1" x--> "1" UserRepository : repository
UserController "1" x--> "1" PasswordEncoder : passwordEncoder
UserController "1" x--> "1" ParkController : park
UserController "1" x--> "1" TicketController : tickets
UserController "1" x--> "1" GroupController : groups
GroupController "1" x--> "0..*" Group : groups
GroupController "1" x--> "1" GroupRepository : repository
GroupController "1" x--> "1" ParkController : park
GroupController "1" x--> "1" UserController : users
GroupController "1" x--> "1" TicketController : tickets
TicketController "1" x--> "0..*" IndividualTicket : individualTickets
TicketController "1" x--> "0..*" GroupTicket : groupTickets
TicketController "1" x--> "1" TicketRepository : repository
TicketController "1" x--> "1" ParkController : park
TicketController "1" x--> "1" UserController : users
TicketController "1" x--> "1" GroupController : groups
PassController "1" x--> "1" ParkController : park
PassController "1" x--> "1" TicketController : tickets
AttractionController "1" x--> "0..*" Attraction : attractions
AttractionController "1" x--> "1" AttractionRepository : repository
AttractionController "1" x--> "1" ParkController : park
AttractionController "1" x--> "1" TicketController : tickets
InvoiceController "1" x--> "1" ParkController : park
InvoiceController "1" x--> "1" UserController : users
InvoiceController "1" x--> "1" GroupController : groups
InvoiceController "1" x--> "1" TicketController : tickets
InvoiceController "1" x--> "1" InvoiceDirector : director
InvoiceController "1" x--> "1" InvoiceBuilder : builderFactory

' ---- Domain ------------------------------------------------------------------------------------------
Group "0..*" x--> "0..*" User : members
IndividualTicket "0..*" x--> "1" User : user
IndividualTicket "1" *--> "0..*" SpeedPass : speedPasses
IndividualTicket "1" *--> "0..1" SpecialPass : specialPass
GroupTicket "0..*" o--> "1" Group : group
GroupTicket "1" *--> "0..*" IndividualTicket : tickets
Attraction "0..*" x--> "0..*" User : present
EntryResult "0..*" x--> "0..*" Pass : consumedPasses

' ---- Invoices ----------------------------------------------------------------------------------------
StandardInvoiceBuilder "1" *--> "0..*" InvoiceSection : sections
Invoice "1" *--> "0..*" InvoiceSection : sections
InvoiceSection "1" *--> "0..*" InvoiceLine : lines

' ---- Persistence -------------------------------------------------------------------------------------
FileUserRepository "1" *--> "1" TextFileStore : store
FileGroupRepository "1" *--> "1" TextFileStore : store
FileAttractionRepository "1" *--> "1" TextFileStore : store
FileTicketRepository "1" *--> "1" TextFileStore : ticketStore
FileTicketRepository "1" *--> "1" TextFileStore : groupTicketStore
FileTicketRepository "1" *--> "1" TextFileStore : passStore

' ---- Usage of classes without incoming relationships -------------------------------------------------
App ..> ParkApplication
App ..> ConsoleRunner
App ..> StoragePaths
App ..> BCryptPasswordEncoder
ParkApplication ..> StoragePaths
ParkApplication ..> ParkCommands
ParkApplication ..> FileUserRepository
ParkApplication ..> FileGroupRepository
ParkApplication ..> FileTicketRepository
ParkApplication ..> FileAttractionRepository
ParkApplication ..> SyntaxHelpFormatter
ParkApplication ..> ExtendedHelpFormatter
ParkApplication ..> StandardInvoiceBuilder
ParkCommands ..> SimpleCommand
ParkCommands ..> UserField
UserController ..> UserField
UserController ..> UserValidator
GroupController ..> UserValidator
TicketController ..> UserValidator
AttractionController ..> UserValidator
AttractionController ..> EntryResult
Attraction ..> EntryResult
Attraction ..> AttractionType
FileAttractionRepository ..> AttractionType
StandardInvoiceBuilder ..> Invoice
@enduml
