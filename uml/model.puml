@startuml model
title Amusement Park - class model (layered)
hide empty methods
skinparam classAttributeIconSize 0

package "es.upm.park.business.model" {
  abstract class Ticket {
    - id : String
    - date : LocalDate
    - price : BigDecimal
  }

  class IndividualTicket {
    - ownerEmail : String
    - partOfGroupTicket : boolean
  }

  class GroupTicket {
    - composition : List<IndividualTicket>
    - group : Group [0..1]
  }

  class Group {
    - id : String
    - name : String
    - memberEmails : Set<String>
  }

  interface AccessTicket {
  }
  interface IndividualAccess {
  }
  interface GroupAccess {
  }
  AccessTicket <|-- IndividualAccess
  AccessTicket <|-- GroupAccess
  Ticket ..|> AccessTicket
  IndividualTicket ..|> IndividualAccess
  GroupTicket ..|> GroupAccess

  abstract class Attraction<T extends AccessTicket> {
    - id : String
    - name : String
    - capacity : int
    - accepted : Class<T>
    - occupantEmails : Set<String>
  }
  class GeneralAttraction {
  }
  class IndividualAttraction {
  }
  class GroupAttraction {
  }
  class SpecialAttraction {
  }
  enum AttractionType {
    GENERAL
    INDIVIDUAL
    GROUP
    SPECIAL
  }
  interface EntryRules {
  }
  Attraction <|-- GeneralAttraction : <T = AccessTicket>
  Attraction <|-- IndividualAttraction : <T = IndividualAccess>
  Attraction <|-- GroupAttraction : <T = GroupAccess>
  IndividualAttraction <|-- SpecialAttraction
  AttractionType ..> Attraction : creates
  Attraction ..> EntryRules : uses on admit
  Attraction ..> AccessTicket : admits T

  abstract class Pass {
    - id : String
    - ticket : IndividualTicket
    - price : BigDecimal
    - consumed : boolean
  }
  class SpeedPass {
  }
  class SpecialPass {
  }
  Pass <|-- SpeedPass
  Pass <|-- SpecialPass
  Pass --> "1" IndividualTicket : ticket

  Ticket <|-- IndividualTicket
  Ticket <|-- GroupTicket
  GroupTicket *--> "1..*" IndividualTicket : composition
  GroupTicket --> "0..1" Group : purchaser

  note as UsersNote
    Users are referenced by email:
    Group.memberEmails (0..*), IndividualTicket.ownerEmail (1),
    Attraction.occupantEmails (0..capacity).
    Users keep no references to groups, tickets or attractions;
    a user's tickets are found by traversing the park's tickets.
  end note
  UsersNote .. Group
  UsersNote .. IndividualTicket
  UsersNote .. Attraction
}

package "es.upm.park.business.controller" {
  class ParkController <<singleton>> {
    - {static} INSTANCE : ParkController
    - currentDate : LocalDate
    - basePrice : BigDecimal
    - groups : Map<String, Group>
    - tickets : Map<String, Ticket>
    - attractions : Map<String, Attraction>
    - passes : Map<String, Pass>
    - users : UserDirectory
    - storage : ParkStorage
  }

  class InvoiceController <<singleton>> {
    - {static} INSTANCE : InvoiceController
    - park : ParkController
  }

  interface UserDirectory {
  }

  interface ParkStorage {
  }

  class ParkState <<record>> {
    groups : List<Group>
    tickets : List<Ticket>
    attractions : List<Attraction>
    passes : List<Pass>
  }

  ParkController --> "1" ParkController : INSTANCE
  ParkController o--> "0..*" Group : groups
  ParkController o--> "0..*" Ticket : tickets
  ParkController o--> "0..*" Attraction : attractions
  ParkController ..> EntryRules : provides
  ParkController o--> "0..*" Pass : passes
  ParkController --> "1" UserDirectory : users (injected)
  ParkController --> "1" ParkStorage : storage (injected)
  ParkStorage ..> ParkState : loads / saves
  InvoiceController --> "1" ParkController : park (injected)
}

package "es.upm.park.business.exception" {
  abstract class ParkException {
  }
  class NotFoundException {
  }
  class BusinessRuleException {
  }
  class InvalidInputException {
  }
  class StorageException {
  }
  ParkException <|-- NotFoundException
  ParkException <|-- BusinessRuleException
  ParkException <|-- InvalidInputException
  ParkException <|-- StorageException
  ParkException --|> RuntimeException
}

ParkController ..> ParkException : throws

package "es.upm.park.business.security" {
  class PasswordService {
    - hasher : PasswordHasher
    - policy : PasswordPolicy
  }
  interface PasswordHasher {
  }
  class BCryptPasswordHasher {
  }
  interface PasswordPolicy {
  }
  PasswordService --> "1" PasswordHasher : injected
  PasswordService --> "1" PasswordPolicy : injected
  BCryptPasswordHasher ..|> PasswordHasher
  BCryptPasswordHasher ..> "org.mindrot.jbcrypt.BCrypt" : uses
}

package "es.upm.park.business.invoice" {
  class Invoice {
    - title : String
    - recipient : List<String>
    - sections : List<Section>
  }
  abstract class InvoiceBuilder<B> {
    - title : String
    - recipient : List<String>
    - sections : List<SectionDraft>
  }
  class UserInvoiceBuilder {
  }
  class GroupInvoiceBuilder {
  }
  InvoiceBuilder <|-- UserInvoiceBuilder
  InvoiceBuilder <|-- GroupInvoiceBuilder
  InvoiceBuilder ..> Invoice : builds
  UserInvoiceBuilder ..> IndividualTicket : reads
  UserInvoiceBuilder ..> Pass : reads
  GroupInvoiceBuilder ..> GroupTicket : reads
}

InvoiceController ..> UserInvoiceBuilder : directs
InvoiceController ..> GroupInvoiceBuilder : directs

package "es.upm.park.persistence" {
  class TextParkStorage {
    - groups : GroupRepository
    - tickets : TicketRepository
    - attractions : AttractionRepository
    - passes : PassRepository
  }

  class GroupRepository {
    - file : Path
    - warnings : PrintStream
  }

  class TicketRepository {
    - file : Path
    - warnings : PrintStream
  }

  class AttractionRepository {
    - file : Path
    - warnings : PrintStream
  }

  class PassRepository {
    - file : Path
    - warnings : PrintStream
  }

  class StoragePaths <<record>> {
    directory : Path
  }

  class TextFile <<utility>> {
  }

  TextParkStorage ..|> ParkStorage
  TextParkStorage o--> "1" GroupRepository : injected
  TextParkStorage o--> "1" TicketRepository : injected
  TextParkStorage o--> "1" AttractionRepository : injected
  TextParkStorage o--> "1" PassRepository : injected
  PassRepository ..> TextFile
  GroupRepository ..> TextFile
  TicketRepository ..> TextFile
  AttractionRepository ..> TextFile
  TextFile ..> StorageException : throws
}

package "es.upm.park.presentation" {
  class CommandRunner {
    - processor : CommandProcessor
    - out : PrintStream
  }

  class CommandProcessor {
    - handlers : Map<String, Function>
  }

  class CommandResult <<record>> {
    output : String
    terminate : boolean
  }

  CommandRunner --> "1" CommandProcessor
  CommandProcessor ..> CommandResult : creates
  CommandProcessor --> "2" HelpGenerator : help, extendedHelp (injected)
  CommandProcessor --> "1" ParkController : injected
  CommandProcessor --> "1" InvoiceController : injected
  CommandProcessor ..> ParkException : reports
}

package "es.upm.park.presentation.help" {
  class HelpGenerator {
    - commands : List<CommandDescription>
    - formatter : HelpFormatter
  }
  interface HelpFormatter {
  }
  class SyntaxHelpFormatter {
  }
  class ExtendedHelpFormatter {
  }
  class CommandDescription <<record>> {
    syntax : String
    purpose : String
  }
  class CommandCatalog <<utility>> {
  }
  HelpGenerator --> "1" HelpFormatter : formatter (injected)
  HelpGenerator o--> "*" CommandDescription
  SyntaxHelpFormatter ..|> HelpFormatter
  ExtendedHelpFormatter ..|> HelpFormatter
  CommandCatalog ..> CommandDescription : provides
}

package "es.upm.park" {
  class App {
  }
  class AppConfiguration <<composition root>> {
  }
  App ..> AppConfiguration : configure(dataDir)
  App ..> CommandRunner
  AppConfiguration ..> StoragePaths : creates
  AppConfiguration ..> GroupRepository : creates
  AppConfiguration ..> TicketRepository : creates
  AppConfiguration ..> AttractionRepository : creates
  AppConfiguration ..> PassRepository : creates
  AppConfiguration ..> TextParkStorage : creates
  AppConfiguration ..> ParkController : injects storage
  AppConfiguration ..> InvoiceController : injects park
  AppConfiguration ..> CommandProcessor : creates
  AppConfiguration ..> PasswordService : creates with BCrypt
  AppConfiguration ..> HelpGenerator : creates with formatter
}

class RuntimeException
@enduml
