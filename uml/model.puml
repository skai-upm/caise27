@startuml model
' Amusement park - class model of the current implementation, organised in layers.
' Notation: no methods; attributes only of primitive, String, value or enum types; references to model
' classes drawn as lines named after the holder's attribute, with a cross (or diamond) at the holder end.
hide empty members
hide circle
skinparam classAttributeIconSize 0

package es.upm.etsisi.amusementpark {

  class App

  note top of App
    Entry point and composition root:
    java -jar amusement-park.jar [--fly] [commandFile]
  end note

  package presentation {
    class CommandRunner
    class CommandProcessor {
      - exitRequested : boolean
    }

    package help {
      class HelpGenerator
      interface HelpFormatter
      class SyntaxHelpFormatter
      class ExtendedHelpFormatter
      class CommandCatalog
      class CommandInfo {
        - syntax : String
        - description : String
      }
    }
  }

  package business {
    class UserValidator

    package security {
      interface PasswordHasher
      class BCryptPasswordHasher {
        - logRounds : int
      }
    }

    package controller {
      class ParkController {
        - currentDate : LocalDate
        - currentPrice : BigDecimal
      }
      class UserController
      class PassController
      class EntryResult {
        - admitted : int
      }
      class GroupController
      class TicketController
      class AttractionController
    }

    package model {
      class User {
        - name : String
        - surname : String
        - dni : String
        - email : String
        - password : String
        - phone : String
        - card : String
      }
      enum UserField {
        NAME
        SURNAME
        EMAIL
        PASSWORD
        PHONE
        CARD
      }
      class Group {
        - id : String
        - name : String
      }
      abstract class ParkTicket {
        - id : String
        - date : LocalDate
      }
      class Ticket {
        - price : BigDecimal
        - ownerDni : String
      }
      class GroupTicket {
        - groupId : String
        - unitPrice : BigDecimal
        - price : BigDecimal
      }
      interface AccessTicket
      interface IndividualAccess
      interface GroupAccess
      abstract class "Attraction<T extends AccessTicket>" as Attraction {
        - id : String
        - name : String
        - capacity : int
        - admitted : Class<T>
      }
      class GeneralAttraction
      class IndividualAttraction
      class GroupAttraction
      class SpecialAttraction
      enum AttractionType {
        GENERAL
        INDIVIDUAL
        GROUP
        SPECIAL
      }
      abstract class Pass {
        - id : String
        - price : BigDecimal
        - consumed : boolean
      }
      class SpeedPass
      class SpecialPass
      class Invoice {
        - recipient : String
        - issueDate : LocalDate
      }
      class InvoiceSection {
        - title : String
      }
      class InvoiceLine {
        - description : String
        - amount : BigDecimal
      }
    }

    package invoice {
      interface InvoiceBuilder
      abstract class AbstractInvoiceBuilder {
        - issueDate : LocalDate
      }
      class UserInvoiceBuilder
      class GroupInvoiceBuilder
      class InvoiceDirector
    }
  }

  package persistence {
    interface UserRepository
    interface GroupRepository
    interface TicketRepository
    interface GroupTicketRepository
    interface AttractionRepository
    interface PassRepository
    class UserFileStorage {
      - file : Path
    }
    class GroupFileStorage {
      - file : Path
    }
    class TicketFileStorage {
      - file : Path
    }
    class GroupTicketFileStorage {
      - file : Path
    }
    class AttractionFileStorage {
      - file : Path
    }
    class PassFileStorage {
      - file : Path
    }
  }
}

' --- inheritance and access capabilities
ParkTicket <|-- Ticket
ParkTicket <|-- GroupTicket
AccessTicket <|-- IndividualAccess
AccessTicket <|-- GroupAccess
AccessTicket <|.. ParkTicket
IndividualAccess <|.. Ticket
GroupAccess <|.. GroupTicket
Attraction <|-- GeneralAttraction : <<bind>> T -> AccessTicket
Attraction <|-- IndividualAttraction : <<bind>> T -> IndividualAccess
Attraction <|-- GroupAttraction : <<bind>> T -> GroupAccess
Attraction <|-- SpecialAttraction : <<bind>> T -> IndividualAccess

' --- presentation
CommandProcessor x--> "1" ParkController : park
CommandProcessor x--> "1" UserController : users
CommandProcessor x--> "1" GroupController : groups
CommandProcessor x--> "1" AttractionController : attractions

CommandProcessor x--> "1" HelpGenerator : help
CommandProcessor x--> "1" HelpGenerator : extendedHelp

' --- help (behaviour injected into the generator)
HelpGenerator o--> "*" CommandInfo : commands
HelpGenerator x--> "1" HelpFormatter : formatter
HelpFormatter <|.. SyntaxHelpFormatter
HelpFormatter <|.. ExtendedHelpFormatter

' --- main controller
ParkController x--> "1" UserController : users
ParkController x--> "1" GroupController : groups
ParkController x--> "1" TicketController : tickets
ParkController x--> "1" AttractionController : attractions
ParkController x--> "1" PassController : passes

' --- users
UserController x--> "1" PasswordHasher : hasher
PasswordHasher <|.. BCryptPasswordHasher
UserController x--> "1" UserRepository : storage
UserController o--> "*" User : users

' --- groups
GroupController x--> "1" GroupRepository : storage
GroupController x--> "1" UserController : users
GroupController o--> "*" Group : groups
Group o--> "*" User : members

' --- tickets
TicketController x--> "1" TicketRepository : storage
TicketController x--> "1" GroupTicketRepository : groupStorage
TicketController x--> "1" UserController : users
TicketController o--> "*" Ticket : tickets
TicketController o--> "*" GroupTicket : groupTickets
Ticket x--> "0..1" User : user
GroupTicket o--> "0..1" Group : group
GroupTicket *--> "1..*" Ticket : tickets

' --- passes
Pass <|-- SpeedPass
Pass <|-- SpecialPass
Pass x--> "1" Ticket : ticket
PassController x--> "1" PassRepository : storage
PassController x--> "1" TicketController : tickets
PassController o--> "*" Pass : passes
UserInvoiceBuilder o--> "*" Pass : passes
EntryResult x--> "1" Attraction : attraction
EntryResult o--> "*" Pass : consumed

' --- attractions
AttractionController x--> "1" AttractionRepository : storage
AttractionController o--> "*" Attraction : attractions
Attraction o--> "*" User : present

' --- invoices (Builder)
InvoiceBuilder <|.. AbstractInvoiceBuilder
AbstractInvoiceBuilder <|-- UserInvoiceBuilder
AbstractInvoiceBuilder <|-- GroupInvoiceBuilder
AbstractInvoiceBuilder o--> "*" InvoiceSection : sections
UserInvoiceBuilder x--> "1" User : user
UserInvoiceBuilder o--> "*" Ticket : directTickets
GroupInvoiceBuilder x--> "1" Group : group
GroupInvoiceBuilder o--> "*" GroupTicket : groupTickets
Invoice *--> "*" InvoiceSection : sections
InvoiceSection *--> "*" InvoiceLine : lines

' --- repositories (replaceable, injected at startup)
UserRepository <|.. UserFileStorage
GroupRepository <|.. GroupFileStorage
TicketRepository <|.. TicketFileStorage
GroupTicketRepository <|.. GroupTicketFileStorage
AttractionRepository <|.. AttractionFileStorage
PassRepository <|.. PassFileStorage

' --- singleton controllers: unique instance per execution
UserController x--> "0..1" UserController : instance
GroupController x--> "0..1" GroupController : instance
TicketController x--> "0..1" TicketController : instance
AttractionController x--> "0..1" AttractionController : instance
ParkController x--> "0..1" ParkController : instance
PassController x--> "0..1" PassController : instance

' --- usage of classes without incoming relationships
App ..> UserFileStorage : creates
App ..> GroupFileStorage : creates
App ..> TicketFileStorage : creates
App ..> GroupTicketFileStorage : creates
App ..> AttractionFileStorage : creates
App ..> PassFileStorage : creates
ParkController ..> InvoiceDirector
ParkController ..> EntryResult : creates
InvoiceDirector ..> InvoiceBuilder
AbstractInvoiceBuilder ..> Invoice : builds
App ..> CommandRunner
App ..> CommandProcessor : creates
App ..> SyntaxHelpFormatter : creates
App ..> ExtendedHelpFormatter : creates
App ..> CommandCatalog
Attraction ..> AttractionType
AttractionType ..> GeneralAttraction : creates
AttractionType ..> IndividualAttraction : creates
AttractionType ..> GroupAttraction : creates
AttractionType ..> SpecialAttraction : creates
App ..> BCryptPasswordHasher : creates
CommandRunner ..> CommandProcessor
UserController ..> UserValidator
GroupController ..> UserValidator
TicketController ..> UserValidator
AttractionController ..> UserValidator
User ..> UserField
UserController ..> UserField
CommandProcessor ..> UserField
@enduml
