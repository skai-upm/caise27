@startuml model
title Parque - class model (current implementation)

skinparam classAttributeIconSize 0
hide empty members

package es.upm.parque.presentation {

  class App

  class CommandProcessor {
    - exitRequested : boolean
  }
}

package es.upm.parque.business.controller {

  class ParkController {
    - currentDate : LocalDate
    - currentPrice : BigDecimal
  }

  class UserManager
  class GroupManager
  class TicketManager
  class AttractionManager

  abstract class InvoiceBuilder {
    - issueDate : LocalDate
    - recipient : String
  }

  class UserInvoiceBuilder
  class GroupInvoiceBuilder
  class InvoiceDirector
}

package es.upm.parque.business.model {

  class User {
    - name : String
    - surname : String
    - dni : String
    - email : String
    - password : String
    - phone : String
    - card : String
  }

  enum UserField {
    NAME
    SURNAME
    EMAIL
    PASSWORD
    PHONE
    CARD
  }

  class UserValidator

  class Group {
    - id : String
    - name : String
  }

  interface Admission

  abstract class Ticket {
    - id : String
    - date : LocalDate
  }

  class IndividualTicket {
    - price : BigDecimal
    - ownerDni : String
    - groupTicketId : String
  }

  class GroupTicket {
    - groupId : String
    - basePrice : BigDecimal
    - discountPercent : int
  }

  class Attraction {
    - id : String
    - name : String
    - capacity : int
  }

  class Invoice {
    - recipient : String
    - issueDate : LocalDate
  }

  class InvoiceSection {
    - title : String
  }

  class InvoiceLine {
    - description : String
    - amount : BigDecimal
  }
}

package es.upm.parque.persistence {

  class DataDirectory {
    - path : Path
    - temporary : boolean
  }

  class UserStorage {
    - file : Path
  }

  class GroupStorage {
    - file : Path
  }

  class TicketStorage {
    - ticketsFile : Path
    - groupTicketsFile : Path
  }

  class AttractionStorage {
    - file : Path
  }
}

' Presentation -> business
CommandProcessor "1" x--> "1" ParkController : park

' Controller
ParkController "1" x--> "1" UserManager : users
ParkController "1" x--> "1" GroupManager : groups
ParkController "1" x--> "1" TicketManager : tickets
ParkController "1" x--> "1" AttractionManager : attractions

' Users
UserManager "1" x--> "1" UserStorage : storage
UserManager "1" x--> "0..*" User : usersByDni

' Groups
GroupManager "1" x--> "1" UserManager : users
GroupManager "1" x--> "1" GroupStorage : storage
GroupManager "1" x--> "0..*" Group : groupsById
Group "0..*" x--> "0..*" User : members

' Tickets
Admission <|.. Ticket
Ticket <|-- IndividualTicket
Ticket <|-- GroupTicket
TicketManager "1" x--> "1" UserManager : users
TicketManager "1" x--> "1" GroupManager : groups
TicketManager "1" x--> "1" TicketStorage : storage
TicketManager "1" x--> "0..*" Ticket : ticketsById
IndividualTicket "0..*" x--> "0..1" User : owner
GroupTicket "0..*" o--> "0..1" Group : group
GroupTicket "0..1" *--> "1..*" IndividualTicket : components

' Attractions
AttractionManager "1" x--> "1" AttractionStorage : storage
AttractionManager "1" x--> "0..*" Attraction : attractionsById
Attraction "0..*" x--> "0..*" User : present

'' Invoices (Builder)
InvoiceBuilder <|-- UserInvoiceBuilder
InvoiceBuilder <|-- GroupInvoiceBuilder
InvoiceBuilder "0..1" x--> "0..*" InvoiceSection : sections
UserInvoiceBuilder "0..*" x--> "1" User : user
UserInvoiceBuilder "0..*" x--> "0..*" Ticket : tickets
GroupInvoiceBuilder "0..*" x--> "1" Group : group
GroupInvoiceBuilder "0..*" x--> "0..*" Ticket : tickets
Invoice "1" *--> "0..*" InvoiceSection : sections
InvoiceSection "1" *--> "1..*" InvoiceLine : lines

' Usage of types without incoming relationships
App ..> CommandProcessor
App ..> DataDirectory
ParkController ..> DataDirectory
ParkController ..> InvoiceDirector
ParkController ..> UserInvoiceBuilder
ParkController ..> GroupInvoiceBuilder
ParkController ..> Invoice
CommandProcessor ..> UserField
ParkController ..> UserField
UserManager ..> UserField
UserManager ..> UserValidator
GroupManager ..> UserValidator
TicketManager ..> UserValidator
AttractionManager ..> UserValidator

@enduml
