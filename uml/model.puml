    - firstName : String
    - surnames : String
    - dni : String {readOnly}
    - email : String
    - passwordHash : String
    - phone : String
    - card : String
  }

  class UserValidator <<utility>> {
  }

  class Group {
    - identifier : String
    - name : String
  }

  interface Admission {
  }

  interface IndividualAdmission {
  }

  interface GroupAdmission {
  }

  abstract class Ticket {
    - identifier : String
    - date : LocalDate
  }

  class IndividualTicket {
    - price : BigDecimal
  }

  class GroupTicket {
  }

  abstract class Pass {
    - identifier : String
    - price : BigDecimal
    - consumed : boolean
  }

  class SpeedPass {
  }

  class SpecialPass {
  }

  enum AttractionType {
    GENERAL
    INDIVIDUAL
    GROUP
    SPECIAL
  }

  abstract class Attraction<T extends Admission> {
    - identifier : String
    - name : String
    - capacity : int
    - admissionType : Class<T>
  }

  class GeneralAttraction {
  }

  class IndividualAttraction {
  }

  class GroupAttraction {
  }

  class SpecialAttraction {
  }

  class EntryResult <<record>> {
  }
}

package es.upm.etsisi.amusementpark.business.invoice {
  abstract class InvoiceBuilder {
    - title : String
  }

  class UserInvoiceBuilder {
  }

  class GroupInvoiceBuilder {
  }

  class InvoiceDirector {
  }

