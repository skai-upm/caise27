@startuml
title Amusement park - class model (layered packages)
skinparam classAttributeIconSize 0
hide empty methods

package es.upm.amusementpark.business.model {
  class User {
    - firstName : String
    - surnames : String
    - dni : String {readOnly}
    - email : String
    - password : String
    - phone : String
    - card : String
  }

  enum UserField {
    NAME
    SURNAME
    EMAIL
    PASSWORD
    PHONE
    CARD
  }

  class Group {
    - identifier : String {readOnly}
    - name : String
  }

  abstract class Ticket {
    - identifier : String {readOnly}
    - date : LocalDate {readOnly}
  }

  class IndividualTicket {
    - price : BigDecimal {readOnly}
  }

  class GroupTicket {
  }

  class Attraction {
    - identifier : String {readOnly}
    - name : String
    - capacity : int {readOnly}
  }
}

package es.upm.amusementpark.business.invoice {
  class Invoice {
    - title : String
    - header : List<String>
    - total : BigDecimal
  }
  class InvoiceSection <<record>> {
    - title : String
  }
  class InvoiceLine <<record>> {
    - description : String
    - amount : BigDecimal
    - details : List<String>
    - countsInTotal : boolean
  }
  abstract class InvoiceBuilder {
    - title : String
  }
  class UserInvoiceBuilder
  class GroupInvoiceBuilder
}

package es.upm.amusementpark.business.service {
  class ParkController <<singleton>> {
    - {static} INSTANCE : ParkController
    - currentDate : LocalDate
    - currentPrice : BigDecimal
  }
  class UserService
  class UserValidator <<utility>>
  class GroupService
  class TicketService
  class AttractionService
  class InvoiceService
}

package es.upm.amusementpark.business.exception {
  class ParkException
  class UserOperationException
  class GroupOperationException
  class TicketOperationException
  class AttractionOperationException
  class InvoiceOperationException
  class PersistenceException
}

package es.upm.amusementpark.persistence {
  class UserRepository
  class GroupRepository
  class TicketRepository
  class AttractionRepository
  class UserFileStorage {
    - file : Path
  }
  class GroupFileStorage {
    - file : Path
  }
  class TicketFileStorage {
    - file : Path
  }
  class AttractionFileStorage {
    - file : Path
  }
  class TextFiles <<utility>>
  class DataDirectories <<utility>>
}

package es.upm.amusementpark.presentation {
  class App
  class CommandRunner
  class CommandProcessor
  class InvalidCommandException
}

' ----- Ticket hierarchy -----
Ticket <|-- IndividualTicket
Ticket <|-- GroupTicket

' ----- Domain relationships (directed) -----
Group "0..*" --> "0..*" User : members
IndividualTicket "0..*" --> "1" User : user
GroupTicket "1" *-- "1..*" IndividualTicket : composition
IndividualTicket "0..*" --> "0..1" GroupTicket : groupTicket
GroupTicket "0..*" --> "0..1" Group : group
Attraction "0..*" --> "0..*" User : occupants

' ----- Central management -----
ParkController "1" --> "1" UserRepository : users
ParkController "1" --> "1" GroupRepository : groups
ParkController "1" --> "1" TicketRepository : tickets
ParkController "1" --> "1" AttractionRepository : attractions

UserRepository "1" o--> "0..*" User : users
GroupRepository "1" o--> "0..*" Group : groups
TicketRepository "1" o--> "0..*" Ticket : tickets
AttractionRepository "1" o--> "0..*" Attraction : attractions

UserRepository --> "0..1" UserFileStorage : storage
GroupRepository --> "0..1" GroupFileStorage : storage
TicketRepository --> "0..1" TicketFileStorage : storage
AttractionRepository --> "0..1" AttractionFileStorage : storage
GroupFileStorage ..> TextFiles
TicketFileStorage ..> TextFiles
AttractionFileStorage ..> TextFiles

' ----- Services -----
UserService --> "1" UserRepository : repository
UserService ..> UserValidator
UserService ..> UserField
UserService ..> ParkController
GroupService ..> ParkController
TicketService ..> ParkController
AttractionService ..> ParkController

' ----- Command layer -----
App ..> CommandRunner
App ..> ParkController
CommandRunner --> "1" CommandProcessor : processor
CommandProcessor --> "1" UserService
CommandProcessor --> "1" GroupService
CommandProcessor --> "1" TicketService
CommandProcessor --> "1" AttractionService

ParkException <|-- UserOperationException
ParkException <|-- GroupOperationException
ParkException <|-- TicketOperationException
ParkException <|-- AttractionOperationException
ParkController ..> DataDirectories
UserFileStorage ..> PersistenceException
TextFiles ..> PersistenceException
DataDirectories ..> PersistenceException
CommandProcessor ..> InvalidCommandException
CommandProcessor ..> ParkException
CommandProcessor ..> PersistenceException

' ----- Invoices (Builder) -----
InvoiceBuilder <|-- UserInvoiceBuilder
InvoiceBuilder <|-- GroupInvoiceBuilder
InvoiceBuilder ..> Invoice : builds
Invoice "1" *-- "0..*" InvoiceSection : sections
InvoiceSection "1" *-- "1..*" InvoiceLine : lines
UserInvoiceBuilder ..> User
UserInvoiceBuilder ..> IndividualTicket
GroupInvoiceBuilder ..> Group
GroupInvoiceBuilder ..> GroupTicket
InvoiceService ..> UserInvoiceBuilder
InvoiceService ..> GroupInvoiceBuilder
InvoiceService ..> ParkController
InvoiceService ..> InvoiceOperationException
ParkException <|-- InvoiceOperationException
CommandProcessor --> "1" InvoiceService

UserService ..> UserOperationException
GroupService ..> GroupOperationException
TicketService ..> TicketOperationException
AttractionService ..> AttractionOperationException
@enduml
