@startuml model
' Class model of the amusement-park application (package es.upm.park),
' derived from the current implementation.
' Notation: class bodies list attributes only (primitive/value types and enums);
' references to modelled classes are drawn as relationships named after the
' holding attribute, with a cross (association) or diamond (aggregation /
' composition) at the holder end and an arrowhead at the referenced class.
' Dependency arrows are shown only for classes without incoming relationships.
hide empty members
hide circle
skinparam classAttributeIconSize 0

package es.upm.park {

  class App

  class CommandRunner

  class CommandProcessor {
    - currentDate : LocalDate
    - currentPrice : BigDecimal
  }

  class Result <<record>> {
    + success : boolean
    + message : String
    + terminate : boolean
    + verbatim : boolean
  }

  class User {
    - firstName : String
    - surnames : String
    - dni : String
    - email : String
    - password : String
    - phone : String
    - cardNumber : String
  }

  enum UserField {
    NAME
    SURNAME
    EMAIL
    PASSWORD
    PHONE
    CARD
  }

  class UserValidator

  class UserManager

  class UserFileStore {
    - file : Path
  }

  class Group {
    - id : String
    - name : String
  }

  class GroupManager

  class GroupFileStore {
    - file : Path
  }

  abstract class Ticket {
    - id : String
    - date : LocalDate
    - price : BigDecimal
  }

  class IndividualTicket

  class GroupTicket {
    - basePrice : BigDecimal
  }

  class TicketManager {
    - historicalLines : List<String>
    - groupHistoricalLines : List<String>
    - historicalIds : Set<String>
  }

  class TicketFileStore {
    - file : Path
  }

  class "TicketFileStore.Contents" as TicketContents <<record>> {
    + historicalLines : List<String>
  }

  class GroupTicketFileStore {
    - file : Path
  }

  class "GroupTicketFileStore.Contents" as GroupTicketContents <<record>> {
    + historicalLines : List<String>
  }

  class Attraction {
    - id : String
    - name : String
    - capacity : int
  }

  class AttractionManager

  class AttractionFileStore {
    - file : Path
  }
}

' ---- Control ----
CommandRunner "0..1" x--> "1" CommandProcessor : processor
CommandProcessor "0..1" x--> "1" UserManager : users
CommandProcessor "0..1" x--> "1" GroupManager : groups
CommandProcessor "0..1" x--> "1" TicketManager : tickets
CommandProcessor "0..1" x--> "1" AttractionManager : attractions

' ---- Users ----
UserManager "0..1" x--> "1" UserFileStore : store
UserManager "1" *--> "0..*" User : users

' ---- Groups ----
GroupManager "0..1" x--> "1" GroupFileStore : store
GroupManager "0..*" x--> "1" UserManager : users
GroupManager "1" *--> "0..*" Group : groups
Group "0..*" o--> "0..*" User : members

' ---- Tickets ----
Ticket <|-- IndividualTicket
Ticket <|-- GroupTicket
IndividualTicket "0..*" x--> "1" User : user
GroupTicket "0..*" o--> "1" Group : group
GroupTicket "0..1" *--> "1..*" IndividualTicket : tickets
TicketManager "0..1" x--> "1" TicketFileStore : store
TicketManager "0..1" x--> "1" GroupTicketFileStore : groupStore
TicketManager "0..*" x--> "1" UserManager : users
TicketManager "1" *--> "0..*" IndividualTicket : tickets
TicketManager "1" *--> "0..*" GroupTicket : groupTickets
TicketContents "0..*" x--> "0..*" IndividualTicket : tickets
GroupTicketContents "0..*" x--> "0..*" GroupTicket : groupTickets

' ---- Attractions ----
AttractionManager "0..1" x--> "1" AttractionFileStore : store
AttractionManager "1" *--> "0..*" Attraction : attractions
Attraction "0..*" o--> "0..*" User : present

' ---- Usage of classes without incoming relationships ----
App ..> CommandRunner : creates
UserManager ..> UserValidator
GroupManager ..> UserValidator
TicketManager ..> UserValidator
AttractionManager ..> UserValidator
UserManager ..> UserField
CommandProcessor ..> UserField
CommandProcessor ..> Result
CommandRunner ..> Result
UserManager ..> Result
GroupManager ..> Result
TicketManager ..> Result
AttractionManager ..> Result
Attraction ..> Result
TicketFileStore ..> TicketContents
TicketManager ..> TicketContents
GroupTicketFileStore ..> GroupTicketContents
TicketManager ..> GroupTicketContents
@enduml
