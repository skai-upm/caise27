@startuml model
' Delivery 2 class model (es.upm.park). Methods and constructors omitted.
hide empty methods
skinparam classAttributeIconSize 0

package es.upm.park.model {

  class User {
    - firstName : String
    - surnames : String
    - dni : String {readOnly}
    - email : String
    - password : String
    - phone : String
    - card : String
  }

  enum UserField {
    NAME
    SURNAME
    EMAIL
    PASSWORD
    PHONE
    CARD
  }

  class Group {
    - id : String
    - name : String
  }

  class Attraction {
    - id : String
    - name : String
    - capacity : int
  }

  abstract class Ticket {
    - id : String
    - date : LocalDate
  }

  class IndividualTicket {
    - basePrice : BigDecimal
  }

  class GroupTicket {
  }

  enum GroupDiscount {
    NONE (0%)
    SMALL_GROUP (10%)
    MEDIUM_GROUP (20%)
    LARGE_GROUP (50%)
    - percent : int
  }
}

package es.upm.park.service {
  class Park <<singleton>> {
    - currentDate : LocalDate
    - currentPrice : BigDecimal
  }
  class UserService
}

Ticket <|-- IndividualTicket
Ticket <|-- GroupTicket

Group "*" --> "0..*" User : members
Attraction "*" --> "0..*" User : occupants
IndividualTicket "*" --> "1" User : user
IndividualTicket "*" --> "1" GroupDiscount : discount
GroupTicket "1" *--> "1..*" IndividualTicket : composition
GroupTicket "*" --> "0..1" Group : group

Park "1" *--> "1" UserService : users
UserService "1" o--> "*" User : users
Park "1" o--> "*" Group : groups
Park "1" o--> "*" Ticket : tickets
Park "1" o--> "*" Attraction : attractions
UserService ..> UserField : uses

note right of GroupTicket
  The group reference becomes null
  when the group is deleted; the
  composition is fixed at purchase.
end note

note bottom of User
  Users hold no references to
  tickets, groups or attractions.
end note
@enduml
