@startuml model
title Amusement Park - domain model (Phase 2)
hide empty methods
skinparam classAttributeIconSize 0

package es.upm.etsisi.amusementpark.business.controller {
  class ParkController <<singleton>> {
    - {static} INSTANCE : ParkController
    - currentDate : LocalDate
    - currentPrice : BigDecimal
  }
}

package es.upm.etsisi.amusementpark.business.model {
  class User {
    - dni : String
    - email : String
    - passwordHash : String
  }

  class Group {
    - identifier : String
    - name : String
  }

  abstract class Ticket {
    - identifier : String
    - date : LocalDate
  }

  class IndividualTicket {
    - price : BigDecimal
  }

  class GroupTicket {
  }

  abstract class Pass {
    - identifier : String
    - price : BigDecimal
    - consumed : boolean
  }

  class SpeedPass {
  }

  class SpecialPass {
  }

  interface Admission {
  }

  interface IndividualAdmission {
  }

  interface GroupAdmission {
  }

  enum AttractionType {
    GENERAL
    INDIVIDUAL
    GROUP
    SPECIAL
  }

  abstract class Attraction<T extends Admission> {
    - identifier : String
    - name : String
    - capacity : int
    - admissionType : Class<T>
  }

  class EntryResult <<record>> {
  }

  class GeneralAttraction {
  }

  class IndividualAttraction {
  }

  class GroupAttraction {
  }

  class SpecialAttraction {
  }
}

Ticket <|-- IndividualTicket
Ticket <|-- GroupTicket
Admission <|-- IndividualAdmission
Admission <|-- GroupAdmission
Admission <|.. Ticket
IndividualAdmission <|.. IndividualTicket
GroupAdmission <|.. GroupTicket
Attraction <|-- GeneralAttraction : <<bind>> T -> Admission
Attraction <|-- IndividualAttraction : <<bind>> T -> IndividualAdmission
Attraction <|-- GroupAttraction : <<bind>> T -> GroupAdmission
Attraction <|-- SpecialAttraction : <<bind>> T -> IndividualAdmission
Attraction ..> AttractionType : type
Attraction ..> EntryResult : enter
EntryResult --> "1..*" User : users
EntryResult --> "*" Pass : consumedPasses
Pass <|-- SpeedPass
Pass <|-- SpecialPass

IndividualTicket "*" --> "1" User : user
GroupTicket "1" *--> "1..*" IndividualTicket : composition
GroupTicket "*" --> "0..1" Group : group
Group "*" o--> "*" User : members
Attraction "0..1" o--> "0..*" User : occupants
Pass "*" --> "1" IndividualTicket : ticket

ParkController "1" *--> "*" User : users
ParkController "1" *--> "*" Group : groups
ParkController "1" *--> "*" Ticket : tickets
ParkController "1" *--> "*" Attraction : attractions
ParkController "1" *--> "*" Pass : passes

note bottom of Ticket
  price = sum of the prices of
  the individual tickets it consists of
end note
@enduml
