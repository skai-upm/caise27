@startuml model
' Class model of the Amusement Park application (Delivery 3), derived from the implemented code.
' Rules: no methods; attributes only for primitive/value types; object references drawn as
' associations named after the field, navigable from the class holding the field (the cross marks
' the non-owning end); usages (dashed) only for classes without incoming relationships.
hide empty members
skinparam classAttributeIconSize 0

package es.upm.amusementpark.presentation {
  class App
  class ApplicationBootstrap
  class CommandProcessor
  package command {
    class CommandRegistry
    class CommandDefinition <<record>> {
      name : String
      syntaxes : List<String>
      description : String
      minParts : int
      maxParts : int
    }
    class ParkCommands
  }
  package help {
    class HelpGenerator
    interface HelpFormatter
    class ConciseHelpFormatter
    class ExtendedHelpFormatter
  }
}

package es.upm.amusementpark.business {
  package controller {
    class ParkController {
      systemDate : LocalDate
      basePrice : BigDecimal
    }
    class UserController
    class GroupController
    class TicketController
    class PassController
    class AttractionController
    class InvoiceController
  }
  package model {
    class User {
      name : String
      surname : String
      dni : String
      email : String
      passwordHash : String
      phone : String
      card : String
    }
    enum UserField {
      NAME
      SURNAME
      EMAIL
      PASSWORD
      PHONE
      CARD
    }
    class Group {
      id : String
      name : String
    }
    interface AccessTicket
    interface IndividualAccess
    interface GroupAccess
    abstract class Ticket {
      id : String
      date : LocalDate
    }
    class IndividualTicket {
      price : BigDecimal
    }
    class GroupTicket {
      price : BigDecimal
    }
    abstract class Pass {
      id : String
      price : BigDecimal
      consumed : boolean
    }
    class SpeedPass
    class SpecialPass
    abstract class Attraction {
      id : String
      name : String
      capacity : int
    }
    abstract class "TypedAttraction<T extends AccessTicket>" as TypedAttraction {
      ticketKind : Class<T>
    }
    class GeneralAttraction
    class IndividualAttraction
    class GroupAttraction
    class SpecialAttraction
    enum AttractionType {
      GENERAL
      INDIVIDUAL
      GROUP
      SPECIAL
    }
    class AccessDeniedException
    class Formats
  }
  package invoice {
    interface InvoiceBuilder
    class TextInvoiceBuilder {
      recipientType : String
      recipient : String
    }
    class Invoice {
      recipientType : String
      recipient : String
      total : BigDecimal
    }
    class InvoiceSection <<record>> {
      title : String
    }
    class InvoiceLine <<record>> {
      description : String
      amount : BigDecimal
    }
  }
  package security {
    interface PasswordHasher
    class BCryptPasswordHasher {
      logRounds : int
    }
  }
  package validation {
    class UserValidator
  }
}

package es.upm.amusementpark.persistence {
  class StorageLocation {
    baseDir : Path
    temporary : boolean
  }
  interface UserRepository
  interface GroupRepository
  interface TicketRepository
  interface PassRepository
  interface AttractionRepository
  class FileUserRepository {
    file : Path
  }
  class FileGroupRepository {
    file : Path
  }
  class FileTicketRepository {
    ticketsFile : Path
    groupTicketsFile : Path
  }
  class FilePassRepository {
    file : Path
  }
  class FileAttractionRepository {
    file : Path
  }
  class TextFiles
}

' ---- Inheritance and realization
AccessTicket <|-- IndividualAccess
AccessTicket <|-- GroupAccess
AccessTicket <|.. Ticket
Ticket <|-- IndividualTicket
Ticket <|-- GroupTicket
IndividualAccess <|.. IndividualTicket
GroupAccess <|.. GroupTicket
Pass <|-- SpeedPass
Pass <|-- SpecialPass
Attraction <|-- TypedAttraction
TypedAttraction <|-- GeneralAttraction : <<bind>> T -> AccessTicket
TypedAttraction <|-- IndividualAttraction : <<bind>> T -> IndividualAccess
TypedAttraction <|-- GroupAttraction : <<bind>> T -> GroupAccess
TypedAttraction <|-- SpecialAttraction : <<bind>> T -> IndividualAccess
InvoiceBuilder <|.. TextInvoiceBuilder
PasswordHasher <|.. BCryptPasswordHasher
HelpFormatter <|.. ConciseHelpFormatter
HelpFormatter <|.. ExtendedHelpFormatter
UserRepository <|.. FileUserRepository
GroupRepository <|.. FileGroupRepository
TicketRepository <|.. FileTicketRepository
PassRepository <|.. FilePassRepository
AttractionRepository <|.. FileAttractionRepository

' ---- Presentation associations
CommandProcessor "0..*" x--> "1" CommandRegistry : registry
CommandRegistry "1" x--> "0..*" CommandDefinition : commands
HelpGenerator "0..*" x--> "1" CommandRegistry : registry
HelpGenerator "0..*" x--> "1" HelpFormatter : conciseFormatter
HelpGenerator "0..*" x--> "1" HelpFormatter : extendedFormatter

' ---- Controllers (Singletons: static field instance) and injected dependencies
ParkController "1" x--> "0..1" ParkController : instance
UserController "1" x--> "0..1" UserController : instance
GroupController "1" x--> "0..1" GroupController : instance
TicketController "1" x--> "0..1" TicketController : instance
PassController "1" x--> "0..1" PassController : instance
AttractionController "1" x--> "0..1" AttractionController : instance
InvoiceController "1" x--> "0..1" InvoiceController : instance

ParkController "1" x--> "1" UserController : userController
ParkController "1" x--> "1" GroupController : groupController
ParkController "1" x--> "1" TicketController : ticketController
ParkController "1" x--> "1" AttractionController : attractionController
ParkController "1" x--> "1" InvoiceController : invoiceController
ParkController "1" x--> "1" PassController : passController
PassController "1" x--> "1" TicketController : ticketController
AttractionController "1" x--> "1" TicketController : ticketController
InvoiceController "1" x--> "1" TicketController : ticketController

UserController "1" x--> "1" UserRepository : repository
UserController "1" x--> "1" PasswordHasher : passwordHasher
UserController "1" x--> "0..*" User : users
GroupController "1" x--> "1" GroupRepository : repository
GroupController "1" x--> "0..*" Group : groups
TicketController "1" x--> "1" TicketRepository : repository
TicketController "1" x--> "1" PassRepository : passRepository
TicketController "1" x--> "0..*" IndividualTicket : tickets
TicketController "1" x--> "0..*" GroupTicket : groupTickets
AttractionController "1" x--> "1" AttractionRepository : repository
AttractionController "1" x--> "0..*" Attraction : attractions

' ---- Domain associations
Group "0..*" x--> "0..*" User : members
IndividualTicket "0..*" x--> "1" User : user
IndividualTicket "1" *--> "0..*" SpeedPass : speedPasses
IndividualTicket "1" *--> "0..1" SpecialPass : specialPass
GroupTicket "0..*" o--> "1" Group : group
GroupTicket "1" *--> "1..*" IndividualTicket : tickets
Attraction "0..*" x--> "0..*" User : present

' ---- Invoices
TextInvoiceBuilder "1" x--> "0..*" InvoiceSection : sections
Invoice "1" x--> "0..*" InvoiceSection : sections
InvoiceSection "1" x--> "0..*" InvoiceLine : lines

' ---- Usages of classes without incoming relationships
App ..> ApplicationBootstrap
App ..> CommandProcessor
App ..> StorageLocation
ApplicationBootstrap ..> ParkCommands
ApplicationBootstrap ..> HelpGenerator
ApplicationBootstrap ..> FileUserRepository
ApplicationBootstrap ..> FileGroupRepository
ApplicationBootstrap ..> FileTicketRepository
ApplicationBootstrap ..> FilePassRepository
ApplicationBootstrap ..> FileAttractionRepository
ApplicationBootstrap ..> TextInvoiceBuilder
ApplicationBootstrap ..> BCryptPasswordHasher
ParkCommands ..> ParkController
InvoiceController ..> InvoiceBuilder
InvoiceController ..> Invoice
UserController ..> UserField
UserController ..> UserValidator
AttractionController ..> AttractionType
TypedAttraction ..> AccessDeniedException
ParkController ..> Formats
FileUserRepository ..> TextFiles
@enduml
