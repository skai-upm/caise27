@startuml model
' Amusement Park - class model (layered: presentation, business, persistence).
' Only relevant attributes are shown; methods and constructors are omitted.
' Association directions follow the fields that hold the references in the code.

skinparam classAttributeIconSize 0
hide empty members

package es.upm.parque.business.model {

  class User {
    - firstName : String
    - surnames : String
    - dni : String {readOnly}
    - email : String
    - password : String
    - telephone : String
    - cardNumber : String
  }

  enum UserField {
    NAME
    SURNAME
    EMAIL
    PASSWORD
    PHONE
    CARD
  }

  class UserValidator <<utility>> {
  }

  class Group {
    - id : String {readOnly}
    - name : String {readOnly}
  }

  abstract class Ticket {
    - id : String {readOnly}
    - date : LocalDate {readOnly}
    - price : BigDecimal {readOnly}
  }

  class IndividualTicket {
  }

  class GroupTicket {
  }

  class Attraction {
    - id : String {readOnly}
    - name : String {readOnly}
    - capacity : int {readOnly}
  }

  class Invoice {
    - title : String {readOnly}
    - recipient : List<String> {readOnly}
  }

  class InvoiceSection {
    - heading : String {readOnly}
  }

  class InvoiceItem {
    - description : String {readOnly}
    - amount : BigDecimal {readOnly}
    - details : List<String> {readOnly}
  }
}

package es.upm.parque.business {
  class ParkController <<singleton>> {
    - currentDate : LocalDate
    - basePrice : BigDecimal
  }
  class SystemValues <<utility>> {
  }
  interface PasswordProtector {
  }
  class BCryptPasswordProtector {
    - cost : int {readOnly}
  }
  class ParkConfiguration <<composition root>> {
  }
  class ParkSession {
    - ignoredUserLines : int
    - ignoredParkLines : int
  }
  class UserManager <<singleton>> {
  }
  class SystemManager <<singleton>> {
  }
  class GroupManager <<singleton>> {
  }
  class TicketManager <<singleton>> {
  }
  class AttractionManager <<singleton>> {
  }
  class ParkException {
  }
  class NotFoundException {
  }
  class InvalidDataException {
  }
  class RuleViolationException {
  }
  abstract class InvoiceBuilder <<builder>> {
  }
  class UserInvoiceBuilder {
  }
  class GroupInvoiceBuilder {
  }
  class InvoiceManager <<singleton, director>> {
  }
}

package es.upm.parque.persistence {
  class UserRepository {
    - ignoredOnLoad : int
  }
  class GroupRepository {
  }
  class TicketRepository {
  }
  class AttractionRepository {
  }
  class UserFileStore {
    - file : Path
  }
  class ParkFileStore {
    - dataDir : Path
  }
  class ParkRepositories {
  }
  class StorageLocation {
    - directory : Path
    - temporary : boolean
  }
}

' --- Ticket hierarchy ---
Ticket <|-- IndividualTicket
Ticket <|-- GroupTicket

' --- Composition: a group ticket owns its individual tickets ---
GroupTicket "0..1" *-- "1..*" IndividualTicket : composition

' --- Directed associations (users hold no references back) ---
IndividualTicket "*" --> "1" User : user
GroupTicket "*" --> "0..1" Group : group
Group "*" o--> "*" User : members
Attraction "*" o--> "*" User : occupants

' --- Central management and its injected repositories (replaceable dependencies, not singletons) ---
ParkController "1" --> "1" ParkRepositories : repositories
ParkRepositories "1" *--> "1" UserRepository : users
ParkRepositories "1" *--> "1" GroupRepository : groups
ParkRepositories "1" *--> "1" TicketRepository : tickets
ParkRepositories "1" *--> "1" AttractionRepository : attractions
ParkRepositories "1" --> "0..1" ParkFileStore : store

UserRepository "1" o--> "*" User : usersByDni
GroupRepository "1" o--> "*" Group : groupsById
TicketRepository "1" o--> "*" Ticket : ticketsById
AttractionRepository "1" o--> "*" Attraction : attractionsById

' --- Initialization: the composition root injects repositories and collaborators ---
ParkSession ..> ParkRepositories : creates for the storage location
ParkSession ..> ParkConfiguration : initializes
ParkConfiguration ..> ParkController : injects repositories
ParkConfiguration ..> UserManager : injects
ParkConfiguration ..> GroupManager : injects
ParkConfiguration ..> TicketManager : injects
ParkConfiguration ..> AttractionManager : injects
ParkConfiguration ..> SystemManager : injects
ParkConfiguration ..> InvoiceManager : injects
ParkConfiguration ..> PasswordProtector : configures

' --- Password protection (BCrypt through jBCrypt), injected into user management ---
PasswordProtector <|.. BCryptPasswordProtector
UserManager --> "1" PasswordProtector : passwords

' --- Business operations and exceptions ---
UserManager --> "1" ParkController : park
SystemManager --> "1" ParkController : park
GroupManager --> "1" ParkController : park
TicketManager --> "1" ParkController : park
AttractionManager --> "1" ParkController : park
AttractionManager --> "1" TicketManager : tickets
Exception <|-- ParkException
ParkException <|-- NotFoundException
ParkException <|-- InvalidDataException
ParkException <|-- RuleViolationException
ParkSession --> "1" StorageLocation : location

' --- Invoices: Builder pattern (director, abstract builder, concrete builders, product) ---
InvoiceBuilder <|-- UserInvoiceBuilder
InvoiceBuilder <|-- GroupInvoiceBuilder
InvoiceManager ..> InvoiceBuilder : directs
InvoiceManager --> "1" ParkController : park
InvoiceBuilder ..> Invoice : builds
Invoice "1" *--> "*" InvoiceSection : sections
InvoiceSection "1" *--> "1..*" InvoiceItem : items
UserInvoiceBuilder --> "1" User : user
GroupInvoiceBuilder --> "1" Group : group
UserInvoiceBuilder --> "1" ParkController : park
GroupInvoiceBuilder --> "1" ParkController : park

' --- Persistence ---
UserRepository "1" --> "0..1" UserFileStore : store
StorageLocation ..> ParkFileStore : locates data for

@enduml
