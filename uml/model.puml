@startuml model
' Amusement Park - class model derived from the implemented code (Delivery 2),
' all classes live in package es.upm.amusementpark.
' Conventions: no methods; attributes only primitives, strings, dates, decimals
' and enumerations; every object reference is a relationship named after the
' holding field, crossed at the holding end (composition/aggregation diamonds
' mark the holding end themselves). Usage (..>) is drawn only for classes
' without incoming relationships.
hide methods
hide empty members
skinparam classAttributeIconSize 0

class User {
  name : String
  surname : String
  dni : String {readOnly}
  email : String
  password : String
  phone : String
  card : String
}

enum UserField {
  NAME
  SURNAME
  EMAIL
  PASSWORD
  PHONE
  CARD
}

class Group {
  id : String
  name : String
}

abstract class Ticket {
  id : String
  date : LocalDate
  price : BigDecimal
}

class IndividualTicket
class GroupTicket

class Attraction {
  id : String
  name : String
  capacity : int
}

class App
class CommandProcessor
class ParkController {
  systemDate : LocalDate
  basePrice : BigDecimal
}
class UserManager
class GroupManager
class TicketManager
class AttractionManager
class UserValidator

class StoragePaths <<record>>
class TextFileStore
class UserRepository
class GroupRepository
class TicketRepository
class AttractionRepository

' --- inheritance
IndividualTicket --|> Ticket
GroupTicket --|> Ticket

' --- domain relationships
Group x--> "*" User : members
IndividualTicket x--> "1" User : user
GroupTicket o--> "1" Group : group
GroupTicket *--> "1..*" IndividualTicket : tickets
Attraction x--> "*" User : visitors

' --- control relationships
CommandProcessor x--> "1" ParkController : park
ParkController *--> "1" UserManager : users
ParkController *--> "1" GroupManager : groups
ParkController *--> "1" TicketManager : tickets
ParkController *--> "1" AttractionManager : attractions
UserManager x--> "*" User : users
UserManager x--> "1" UserRepository : repository
GroupManager x--> "*" Group : groups
GroupManager x--> "1" GroupRepository : repository
TicketManager x--> "*" IndividualTicket : individualTickets
TicketManager x--> "*" GroupTicket : groupTickets
TicketManager x--> "1" TicketRepository : repository
AttractionManager x--> "*" Attraction : attractions
AttractionManager x--> "1" AttractionRepository : repository
TicketRepository x--> "1" StoragePaths : paths

' --- usage of classes without incoming relationships
App ..> CommandProcessor : <<use>>
App ..> ParkController : <<use>>
App ..> StoragePaths : <<use>>
UserManager ..> UserField : <<use>>
CommandProcessor ..> UserField : <<use>>
UserManager ..> UserValidator : <<use>>
GroupManager ..> UserValidator : <<use>>
TicketManager ..> UserValidator : <<use>>
AttractionManager ..> UserValidator : <<use>>
UserRepository ..> TextFileStore : <<use>>
GroupRepository ..> TextFileStore : <<use>>
TicketRepository ..> TextFileStore : <<use>>
AttractionRepository ..> TextFileStore : <<use>>

@enduml
