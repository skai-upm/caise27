@startuml model
' Class model of the amusement-park application (layered packages under es.upm.park),
' derived from the current implementation.
' Notation: class bodies list attributes only (primitive/value types and enums);
' references to modelled classes are drawn as relationships named after the
' holding attribute, with a cross (association) or diamond (aggregation /
' composition) at the holder end and an arrowhead at the referenced class.
' Dependency arrows are shown only for classes without incoming relationships.
hide empty members
hide circle
skinparam classAttributeIconSize 0

package es.upm.park.presentation {
  class App

  class CommandRunner

  class CommandProcessor
}

package es.upm.park.business {
  class ApplicationContext {
    - dataDirectory : Path
    - temporaryDirectory : Path
    - closed : AtomicBoolean
  }

  class ParkController <<singleton>> {
    - currentDate : LocalDate
    - currentPrice : BigDecimal
  }

  class UserValidator

  class UserManager <<singleton>>

  class GroupManager <<singleton>>

  class TicketManager <<singleton>> {
    - historicalLines : List<String>
    - groupHistoricalLines : List<String>
    - historicalIds : Set<String>
  }

  class AttractionManager <<singleton>>

  abstract class InvoiceBuilder {
    - recipient : String
    - date : LocalDate
  }

  class UserInvoiceBuilder

  class GroupInvoiceBuilder

  class InvoiceDirector
}

package es.upm.park.business.model {
  class Result <<record>> {
    + success : boolean
    + message : String
    + terminate : boolean
    + verbatim : boolean
  }

  class User {
    - firstName : String
    - surnames : String
    - dni : String
    - email : String
    - password : String
    - phone : String
    - cardNumber : String
  }

  enum UserField {
    NAME
    SURNAME
    EMAIL
    PASSWORD
    PHONE
    CARD
  }

  class Group {
    - id : String
    - name : String
  }

  abstract class Ticket {
    - id : String
    - date : LocalDate
    - price : BigDecimal
  }

  class IndividualTicket

  class GroupTicket {
    - basePrice : BigDecimal
  }

  class Attraction {
    - id : String
    - name : String
    - capacity : int
  }

  class Invoice {
    - recipient : String
    - date : LocalDate
  }

  class "Invoice.Section" as InvoiceSection <<record>> {
    + title : String
  }

  class "Invoice.Line" as InvoiceLine <<record>> {
    + description : String
    + amount : BigDecimal
  }
}

package es.upm.park.persistence {
  class DataDirectory

  interface UserRepository

  interface GroupRepository

  interface TicketRepository

  interface GroupTicketRepository

  interface AttractionRepository

  class UserFileStore {
    - file : Path
  }

  class GroupFileStore {
    - file : Path
  }

  class TicketFileStore {
    - file : Path
  }

  class "TicketFileStore.Contents" as TicketContents <<record>> {
    + historicalLines : List<String>
  }

  class GroupTicketFileStore {
    - file : Path
  }

  class "GroupTicketFileStore.Contents" as GroupTicketContents <<record>> {
    + historicalLines : List<String>
  }

  class AttractionFileStore {
    - file : Path
  }
}

' ---- Control ----
CommandRunner "0..1" x--> "1" CommandProcessor : processor
CommandProcessor "0..1" x--> "1" ParkController : controller
ParkController "0..1" x--> "1" UserManager : users
ParkController "0..1" x--> "1" GroupManager : groups
ParkController "0..1" x--> "1" TicketManager : tickets
ParkController "0..1" x--> "1" AttractionManager : attractions
ParkController "0..1" x--> "1" InvoiceDirector : invoiceDirector
ApplicationContext "0..1" x--> "1" ParkController : controller

' ---- Repositories ----
UserRepository <|.. UserFileStore
GroupRepository <|.. GroupFileStore
TicketRepository <|.. TicketFileStore
GroupTicketRepository <|.. GroupTicketFileStore
AttractionRepository <|.. AttractionFileStore

' ---- Users ----
UserManager "0..1" x--> "1" UserRepository : store
UserManager "1" *--> "0..*" User : users

' ---- Groups ----
GroupManager "0..1" x--> "1" GroupRepository : store
GroupManager "0..*" x--> "1" UserManager : users
GroupManager "1" *--> "0..*" Group : groups
Group "0..*" o--> "0..*" User : members

' ---- Tickets ----
Ticket <|-- IndividualTicket
Ticket <|-- GroupTicket
IndividualTicket "0..*" x--> "1" User : user
GroupTicket "0..*" o--> "1" Group : group
GroupTicket "0..1" *--> "1..*" IndividualTicket : tickets
TicketManager "0..1" x--> "1" TicketRepository : store
TicketManager "0..1" x--> "1" GroupTicketRepository : groupStore
TicketManager "0..*" x--> "1" UserManager : users
TicketManager "1" *--> "0..*" IndividualTicket : tickets
TicketManager "1" *--> "0..*" GroupTicket : groupTickets
TicketContents "0..*" x--> "0..*" IndividualTicket : tickets
GroupTicketContents "0..*" x--> "0..*" GroupTicket : groupTickets

' ---- Attractions ----
AttractionManager "0..1" x--> "1" AttractionRepository : store
AttractionManager "1" *--> "0..*" Attraction : attractions
Attraction "0..*" o--> "0..*" User : present

'' ---- Invoices ----
InvoiceBuilder <|-- UserInvoiceBuilder
InvoiceBuilder <|-- GroupInvoiceBuilder
InvoiceBuilder "0..1" *--> "0..*" InvoiceSection : sections
Invoice "0..*" *--> "0..*" InvoiceSection : sections
InvoiceSection "0..*" *--> "1..*" InvoiceLine : lines

' ---- Usage of classes without incoming relationships ----
App ..> CommandRunner : creates
App ..> ApplicationContext
ApplicationContext ..> DataDirectory
ApplicationContext ..> UserFileStore : creates
ApplicationContext ..> GroupFileStore : creates
ApplicationContext ..> TicketFileStore : creates
ApplicationContext ..> GroupTicketFileStore : creates
ApplicationContext ..> AttractionFileStore : creates
InvoiceBuilder ..> Invoice : creates
ParkController ..> Invoice
UserManager ..> UserValidator
GroupManager ..> UserValidator
TicketManager ..> UserValidator
AttractionManager ..> UserValidator
UserManager ..> UserField
CommandProcessor ..> UserField
ParkController ..> UserField
CommandProcessor ..> Result
CommandRunner ..> Result
ParkController ..> Result
UserManager ..> Result
GroupManager ..> Result
TicketManager ..> Result
AttractionManager ..> Result
Attraction ..> Result
TicketFileStore ..> TicketContents
TicketManager ..> TicketContents
GroupTicketFileStore ..> GroupTicketContents
TicketManager ..> GroupTicketContents
@enduml
