@startuml
' Amusement Park - Delivery 2 class model (es.upm.etsisi.amusementpark)
hide methods
skinparam classAttributeIconSize 0

class ParkController <<singleton>> {
  - {static} INSTANCE : ParkController
  - currentDate : LocalDate
  - currentPrice : BigDecimal
}

class User {
  - firstName : String
  - surnames : String
  - dni : String {readOnly}
  - email : String
  - password : String
  - phone : String
  - card : String
}

enum UserField {
  NAME
  SURNAME
  EMAIL
  PASSWORD
  PHONE
  CARD
}

class Group {
  - id : String
  - name : String
}

abstract class Ticket {
  - id : String
  - date : LocalDate
  - basePrice : BigDecimal
  - discountPercent : int
}

class IndividualTicket

class GroupTicket

class GroupDiscount <<utility>>

class Attraction {
  - id : String
  - name : String
  - capacity : int
}

' central management
ParkController "1" --> "*" Group : groups
ParkController "1" --> "*" Ticket : tickets
ParkController "1" --> "*" Attraction : attractions
ParkController "1" --> "*" User : users (via UserService)

' ticket hierarchy
Ticket <|-- IndividualTicket
Ticket <|-- GroupTicket
GroupTicket "1" *-- "1..*" IndividualTicket : composition
IndividualTicket "*" --> "1" User : user
GroupTicket "*" --> "0..1" Group : group
GroupTicket ..> GroupDiscount : uses

' other relationships (unidirectional)
Group "*" --> "*" User : members
Attraction "*" --> "*" User : occupants
User ..> UserField : modifiable fields

@enduml
