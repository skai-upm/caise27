@startuml model
' Amusement park - class model of the current implementation (package es.upm.parque)
hide empty members
hide circle
skinparam classAttributeIconSize 0

class App

class CommandRunner

class CommandProcessor {
  exitRequested : boolean
}

class SystemDate {
  current : LocalDate
}

class UserManager

class UserRepository {
  file : Path
}

class UserValidator

class UserException

class User {
  name : String
  surname : String
  dni : String
  email : String
  password : String
  phone : String
  card : String
}

enum UserField {
  NAME
  SURNAME
  EMAIL
  PASSWORD
  PHONE
  CARD
}

class GroupManager

class GroupRepository {
  file : Path
}

class Group {
  id : String
  name : String
}

class TicketManager {
  currentPrice : BigDecimal
}

class TicketRepository {
  ticketsFile : Path
  groupTicketsFile : Path
}

abstract class Ticket {
  id : String
  date : LocalDate
}

class IndividualTicket {
  price : BigDecimal
}

class GroupTicket {
  discountPercent : int
}

class AttractionManager

class AttractionRepository {
  file : Path
}

class Attraction {
  id : String
  name : String
  capacity : int
}

' Inheritance
Ticket <|-- IndividualTicket
Ticket <|-- GroupTicket
RuntimeException <|-- UserException

' Associations (cross = holder of the attribute, arrow = navigable end)
CommandRunner x--> "1" CommandProcessor : processor
CommandProcessor x--> "1" UserManager : userManager
CommandProcessor x--> "1" GroupManager : groupManager
CommandProcessor x--> "1" TicketManager : ticketManager
CommandProcessor x--> "1" AttractionManager : attractionManager
CommandProcessor x--> "1" SystemDate : systemDate

UserManager x--> "1" UserRepository : repository
UserManager x--> "0..*" User : users

GroupManager x--> "1" GroupRepository : repository
GroupManager x--> "1" UserManager : userManager
GroupManager x--> "0..*" Group : groups
Group x--> "0..*" User : members

TicketManager x--> "1" TicketRepository : repository
TicketManager x--> "1" UserManager : userManager
TicketManager x--> "1" GroupManager : groupManager
TicketManager x--> "1" SystemDate : systemDate
TicketManager x--> "0..*" Ticket : tickets
IndividualTicket x--> "1" User : user
GroupTicket o--> "1" Group : group
GroupTicket "1" *--> "1..*" IndividualTicket : tickets

AttractionManager x--> "1" AttractionRepository : repository
AttractionManager x--> "1" TicketManager : ticketManager
AttractionManager x--> "1" SystemDate : systemDate
AttractionManager x--> "0..*" Attraction : attractions
Attraction x--> "0..*" User : visitors

' Usage of classes without incoming relationships
App ..> CommandRunner
UserManager ..> UserValidator
UserManager ..> UserField
UserManager ..> UserException
GroupManager ..> UserException
TicketManager ..> UserException
AttractionManager ..> UserException
Attraction ..> UserException

@enduml
