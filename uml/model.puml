' holder end; no methods; usage arrows only for classes without incoming relationships.

hide empty members
hide circle
skinparam classAttributeIconSize 0

class App

package presentation {
class CommandRunner
class CommandProcessor {
  exitRequested : boolean
}
}

package presentation.help {
class HelpGenerator
class CommandCatalog
class CommandInfo {
  operation : String
  syntax : String
  description : String
}
interface HelpFormatter
class SyntaxHelpFormatter
class ExtendedHelpFormatter
}

package business.controller {
class ParkController <<Singleton>> {
  currentDate : LocalDate
  ticketPrice : BigDecimal
}
}

package business.model {
class User {
  name : String
  surname : String
  dni : String
  email : String
  password : String
  phone : String
  card : String
}
enum UserField {
  NAME
  SURNAME
  EMAIL
  PASSWORD
  PHONE
  CARD
}
class UserValidator
class UserException
class Group {
  id : String
  name : String
}
abstract class Ticket {
  id : String
  date : LocalDate
}
class IndividualTicket {
  price : BigDecimal
  ownerDni : String
}
class GroupTicket {
  groupId : String
  basePrice : BigDecimal
  totalPrice : BigDecimal
}
class Attraction {
  id : String
  name : String
  capacity : int
}
}

package business.invoice {
abstract class InvoiceBuilder {
  title : String
  total : BigDecimal
}
class UserInvoiceBuilder
class GroupInvoiceBuilder
class InvoiceDirector
class Invoice {
  title : String
  total : BigDecimal
}
class InvoiceSection {
  title : String
}
class InvoiceLine {
  description : String
  amount : BigDecimal
}
}

package business.service {
class UserManager
class GroupManager
class TicketManager
class AttractionManager
}

package persistence {
class UserFileRepository {
  file : Path
}
class GroupFileRepository {
  file : Path
}
class TicketFileRepository {
  file : Path
}
class GroupTicketFileRepository {
  file : Path
}
class AttractionFileRepository {
  file : Path
}
}

class Exception

' ---------- Inheritance ----------
Ticket <|-- IndividualTicket
Ticket <|-- GroupTicket
Exception <|-- UserException
HelpFormatter <|.. SyntaxHelpFormatter
HelpFormatter <|.. ExtendedHelpFormatter
InvoiceBuilder <|-- UserInvoiceBuilder
InvoiceBuilder <|-- GroupInvoiceBuilder

' ---------- Control relationships ----------
CommandRunner "0..1" x--> "1" CommandProcessor : processor
CommandProcessor "0..1" x--> "1" ParkController : controller
CommandProcessor "0..1" x--> "1" HelpGenerator : helpGenerator
HelpGenerator "0..*" x--> "1" CommandCatalog : catalog
HelpGenerator "0..*" x--> "1" HelpFormatter : conciseFormatter
HelpGenerator "0..*" x--> "1" HelpFormatter : extendedFormatter
CommandCatalog "1" *--> "0..*" CommandInfo : commands
ParkController "0..1" x--> "1" UserManager : users
ParkController "0..1" x--> "1" GroupManager : groups
ParkController "0..1" x--> "1" TicketManager : tickets
ParkController "0..1" x--> "1" AttractionManager : attractions
ParkController "0..1" x--> "1" InvoiceDirector : invoiceDirector
ParkController "0..1" x--> "0..1" ParkController : instance

' ---------- Managers and their entities ----------
UserManager "1" *--> "0..*" User : users
UserManager "0..1" x--> "1" UserFileRepository : repository

GroupManager "1" *--> "0..*" Group : groups
GroupManager "0..1" x--> "1" GroupFileRepository : repository
GroupManager "0..*" x--> "1" UserManager : users

TicketManager "1" *--> "0..*" IndividualTicket : tickets
TicketManager "1" *--> "0..*" GroupTicket : groupTickets
TicketManager "0..1" x--> "1" TicketFileRepository : repository
TicketManager "0..1" x--> "1" GroupTicketFileRepository : groupRepository
TicketManager "0..*" x--> "1" UserManager : users

AttractionManager "1" *--> "0..*" Attraction : attractions
AttractionManager "0..1" x--> "1" AttractionFileRepository : repository

' ---------- Domain relationships ----------
Group "0..*" o--> "0..*" User : members
IndividualTicket "0..*" x--> "0..1" User : user
GroupTicket "1" *--> "1..*" IndividualTicket : parts
GroupTicket "0..*" o--> "0..1" Group : group
Attraction "0..*" o--> "0..*" User : present

' ---------- Invoices ----------
InvoiceBuilder "1" *--> "0..*" InvoiceSection : sections
Invoice "1" *--> "0..*" InvoiceSection : sections
InvoiceSection "1" *--> "1..*" InvoiceLine : lines
UserInvoiceBuilder "0..*" x--> "1" User : user
UserInvoiceBuilder "0..*" x--> "0..*" IndividualTicket : tickets
GroupInvoiceBuilder "0..*" x--> "1" Group : group
GroupInvoiceBuilder "0..*" x--> "0..*" GroupTicket : groupTickets

' ---------- Usage of classes without incoming relationships ----------
ParkController ..> UserInvoiceBuilder : <<create>>
ParkController ..> GroupInvoiceBuilder : <<create>>
InvoiceDirector ..> Invoice : <<create>>
App ..> CommandRunner : <<use>>
CommandProcessor ..> UserField : <<use>>
ParkController ..> UserField : <<use>>
UserManager ..> UserField : <<use>>
UserManager ..> UserValidator : <<use>>
GroupManager ..> UserValidator : <<use>>
TicketManager ..> UserValidator : <<use>>
AttractionManager ..> UserValidator : <<use>>
UserManager ..> UserException : <<throw>>
GroupManager ..> UserException : <<throw>>
TicketManager ..> UserException : <<throw>>
AttractionManager ..> UserException : <<throw>>
Attraction ..> UserException : <<throw>>
CommandProcessor ..> UserException : <<catch>>
ParkController ..> UserException : <<throw>>

@enduml
