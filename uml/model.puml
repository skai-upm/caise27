@startuml model
title Amusement Park - Delivery 2 class model

hide empty methods
skinparam classAttributeIconSize 0

package "es.upm.etsisi.park" {
  class Park <<singleton>> {
    - {static} INSTANCE : Park
    - systemDate : LocalDate
    - basePrice : BigDecimal
  }
}

package "es.upm.etsisi.park.user" {
  class User {
    - firstName : String
    - surnames : String
    - dni : String {readOnly}
    - email : String
    - password : String
    - phone : String
    - card : String
  }

  enum UserField {
    NAME
    SURNAME
    EMAIL
    PASSWORD
    PHONE
    CARD
  }

  class UserService
}

package "es.upm.etsisi.park.model.group" {
  class Group {
    - id : String
    - name : String
  }
}

package "es.upm.etsisi.park.model.ticket" {
  abstract class Ticket {
    - id : String
    - date : LocalDate
  }

  class IndividualTicket {
    - basePrice : BigDecimal
    - discountPercent : int
  }

  class GroupTicket

  enum GroupDiscount {
    NONE
    SMALL_GROUP
    MEDIUM_GROUP
    LARGE_GROUP
    - percent : int
  }
}

package "es.upm.etsisi.park.model.attraction" {
  class Attraction {
    - id : String
    - name : String
    - capacity : int
  }
}

package "es.upm.etsisi.park.persistence" {
  class ParkStorage {
    - dataDirectory : Path
  }
  class UserRepository
  class GroupRepository
  class TicketRepository
  class AttractionRepository
}

' --- inheritance
Ticket <|-- IndividualTicket
Ticket <|-- GroupTicket

' --- central management
Park "1" --> "1" UserService : users
Park "1" --> "0..*" Group : groups
Park "1" --> "0..*" Ticket : tickets
Park "1" --> "0..*" Attraction : attractions
Park "1" --> "1" ParkStorage : storage
UserService "1" --> "0..*" User : users
UserService "1" --> "1" UserRepository : repository

' --- domain relationships (directions as required)
Group "0..*" --> "0..*" User : members
IndividualTicket "0..*" --> "1" User : user
GroupTicket "0..*" --> "0..1" Group : group
GroupTicket "1" *-- "1..*" IndividualTicket : members
Attraction "0..*" --> "0..*" User : occupants
Park ..> GroupDiscount : discount at purchase
User ..> UserField : modifiable fields

' --- persistence
ParkStorage "1" *-- "1" UserRepository
ParkStorage "1" *-- "1" GroupRepository
ParkStorage "1" *-- "1" TicketRepository
ParkStorage "1" *-- "1" AttractionRepository

note bottom of Ticket
  Shared identifier space for all tickets.
  getPrice() and getHolders() are abstract:
  IndividualTicket applies the discount to its base price,
  GroupTicket sums the prices of its member tickets.
end note

note right of GroupTicket
  group:
  null once the group is deleted
  (historical tickets are kept)
end note
@enduml
