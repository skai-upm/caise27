@startuml model
' Class model of the amusement park application (current implementation).
hide empty members
skinparam classAttributeIconSize 0

package es.upm.parque {

  class App {
  }

  class CommandProcessor {
    - finished : boolean
  }

  class SystemDate {
    - current : LocalDate
  }

  class UserManager {
  }

  class UserRepository {
    - file : Path
  }

  class User {
    - name : String
    - surname : String
    - dni : String {readOnly}
    - email : String
    - password : String
    - phone : String
    - card : String
  }

  enum UserField {
    NAME
    SURNAME
    EMAIL
    PASSWORD
    PHONE
    CARD
  }

  class UserValidator <<utility>> {
  }

  class GroupManager {
  }

  class GroupRepository {
    - file : Path
  }

  class Group {
    - id : String {readOnly}
    - name : String
  }

  class TicketManager {
    - price : BigDecimal
  }

  class TicketRepository {
    - file : Path
  }

  abstract class Ticket {
    - id : String {readOnly}
    - date : LocalDate {readOnly}
  }

  class IndividualTicket {
    - price : BigDecimal {readOnly}
  }

  class GroupTicket {
    - discountPercent : int {readOnly}
  }

  class GroupTicketRepository {
    - file : Path
  }

  class AttractionManager {
  }

  class AttractionRepository {
    - file : Path
  }

  class Attraction {
    - id : String {readOnly}
    - name : String {readOnly}
    - capacity : int {readOnly}
  }
}

CommandProcessor "1" --> "1" UserManager : users
CommandProcessor "1" --> "1" GroupManager : groups
CommandProcessor "1" --> "1" TicketManager : tickets
CommandProcessor "1" --> "1" AttractionManager : attractions
CommandProcessor "1" --> "1" SystemDate : systemDate
UserManager "1" --> "1" UserRepository : repository
UserManager "1" o--> "0..*" User : usersByDni
GroupManager "1" --> "1" GroupRepository : repository
GroupManager "1" --> "1" UserManager : users
GroupManager "1" o--> "0..*" Group : groupsById
Group "0..*" o--> "0..*" User : members
TicketManager "1" --> "1" TicketRepository : repository
TicketManager "1" --> "1" UserManager : users
TicketManager "1" --> "1" SystemDate : systemDate
TicketManager "1" --> "1" GroupTicketRepository : groupRepository
TicketManager "1" --> "1" GroupManager : groups
TicketManager "1" o--> "0..*" IndividualTicket : ticketsById
TicketManager "1" o--> "0..*" GroupTicket : groupTicketsById
IndividualTicket --|> Ticket
GroupTicket --|> Ticket
IndividualTicket "0..*" --> "1" User : holder
GroupTicket "0..*" o--> "1" Group : group
GroupTicket "1" *--> "1..*" IndividualTicket : tickets
AttractionManager "1" --> "1" AttractionRepository : repository
AttractionManager "1" --> "1" TicketManager : tickets
AttractionManager "1" --> "1" SystemDate : systemDate
AttractionManager "1" o--> "0..*" Attraction : attractionsById
Attraction "0..*" o--> "0..*" User : present

App ..> CommandProcessor : creates
UserManager ..> UserValidator : validates with
UserManager ..> UserField : updates
@enduml
