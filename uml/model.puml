@startuml model
' Amusement Park - class model of the implemented design (layered: presentation / business / persistence).
' Only relevant attributes are shown; methods and constructors are omitted.
hide empty methods
skinparam classAttributeIconSize 0

package es.upm.amusementpark {
  class App {
    {static} FLY : String
  }
}

package es.upm.amusementpark.presentation {
  interface CommandHandler {
  }
  class CommandProcessor {
    - out : PrintStream
    - afterCommand : Runnable
  }
  class InvalidCommandException {
  }
  class CommandSupport {
  }
  class SystemCommands {
  }
  class GroupCommands {
  }
  class TicketCommands {
  }
  class AttractionCommands {
  }
  class InvoiceCommands {
  }
}

package es.upm.amusementpark.business.invoice {
  class Invoice <<record>> {
    - type : String
    - recipient : Map<String, String>
    - total : BigDecimal
  }
  class Section <<record>> {
    - title : String
  }
  class Line <<record>> {
    - text : String
    - amount : BigDecimal
  }
  abstract class InvoiceBuilder {
    - type : String
  }
  class UserInvoiceBuilder {
  }
  class GroupInvoiceBuilder {
  }
}

package es.upm.amusementpark.presentation.help {
  class CommandDescription <<record>> {
    - syntax : String
    - purpose : String
  }
  class CommandCatalog {
  }
  interface HelpFormatter {
  }
  class SyntaxHelpFormatter {
  }
  class ExtendedHelpFormatter {
  }
  class HelpGenerator {
  }
  class HelpCommands {
  }
}

package es.upm.amusementpark.business {
  class ParkController <<singleton>> {
    {static} INITIAL_PRICE : BigDecimal
    {static} - INSTANCE : ParkController
    - currentDate : LocalDate
    - currentPrice : BigDecimal
  }
  class ParkException {
  }
  interface UserDirectory {
  }
  interface GroupTicketDates {
  }
  interface ParkRepository {
  }
  interface PasswordHasher {
  }
  class BCryptPasswordHasher {
  }
  class RepositoryException {
  }
  class Group {
    - id : String
    - name : String
    - members : Set<String> <<user e-mails>>
  }
  abstract class Ticket {
    - id : String
    - date : LocalDate
  }
  class IndividualTicket {
    - userEmail : String
    - price : BigDecimal
  }
  class GroupTicket {
    - groupId : String
  }
  class Attraction {
    - id : String
    - name : String
    - capacity : int
    - occupants : Set<String> <<user e-mails>>
  }
}

package es.upm.amusementpark.persistence {
  class ParkStorage {
    - directory : Path
  }
  class TextFile {
    {static} SEPARATOR : String
    - path : Path
  }
  class GroupRepository {
  }
  class TicketRepository {
  }
  class AttractionRepository {
  }
}

' ---- ticket hierarchy and composition ----
Ticket <|-- IndividualTicket
Ticket <|-- GroupTicket
GroupTicket *-- "1..*" IndividualTicket : components
IndividualTicket --> "0..1" GroupTicket : containingGroupTicket
GroupTicket --> "0..1" Group : group

' ---- central management ----
ParkController --> "0..*" Group : groups
ParkController --> "0..*" Ticket : tickets
ParkController --> "0..*" Attraction : attractions
ParkController --> "1" UserDirectory : userDirectory
ParkController --> "1" GroupTicketDates : groupTicketDates
ParkController ..> ParkException : throws
ParkController --> "1" ParkRepository : repository (injected)
ParkRepository ..> RepositoryException : throws
ParkRepository <|.. ParkStorage
PasswordHasher <|.. BCryptPasswordHasher
ParkController --> "1" PasswordHasher : passwordHasher (injected)

' ---- commands ----
CommandProcessor --> "0..*" CommandHandler : handlers
SystemCommands --> "1" ParkController : park
GroupCommands ..> ParkController : uses
TicketCommands ..> ParkController : uses
AttractionCommands --> "1" ParkController : park
SystemCommands ..> CommandProcessor : registers
GroupCommands ..> CommandProcessor : registers
TicketCommands ..> CommandProcessor : registers
AttractionCommands ..> CommandProcessor : registers
App ..> CommandProcessor : creates
App ..> ParkController : uses
App ..> ParkStorage : creates and injects
CommandProcessor ..> InvalidCommandException : handles
CommandProcessor ..> ParkException : handles
SystemCommands ..> CommandSupport : parses with
GroupCommands ..> CommandSupport : parses with
TicketCommands ..> CommandSupport : parses with
AttractionCommands ..> CommandSupport : parses with

' ---- help (injected formatting strategy) ----
HelpFormatter <|.. SyntaxHelpFormatter
HelpFormatter <|.. ExtendedHelpFormatter
HelpGenerator --> "1" HelpFormatter : formatter (injected)
HelpGenerator --> "1" CommandCatalog : catalog
CommandCatalog *-- "0..*" CommandDescription : commands
HelpCommands ..> HelpGenerator : uses
HelpCommands ..> CommandProcessor : registers
App ..> HelpGenerator : configures

' ---- invoices (Builder) ----
InvoiceBuilder <|-- UserInvoiceBuilder
InvoiceBuilder <|-- GroupInvoiceBuilder
InvoiceBuilder ..> Invoice : builds
Invoice *-- "0..*" Section : sections
Section *-- "1..*" Line : lines
ParkController ..> UserInvoiceBuilder : directs
ParkController ..> GroupInvoiceBuilder : directs
GroupInvoiceBuilder ..> GroupTicket : reads
UserInvoiceBuilder ..> IndividualTicket : reads
InvoiceCommands ..> Invoice : formats
InvoiceCommands ..> CommandSupport : parses with
InvoiceCommands ..> ParkController : uses

' ---- persistence ----
ParkStorage *-- "1" GroupRepository : groups
ParkStorage *-- "1" TicketRepository : tickets
ParkStorage *-- "1" AttractionRepository : attractions
GroupRepository *-- "1" TextFile : file
TicketRepository *-- "1" TextFile : file
AttractionRepository *-- "1" TextFile : file
ParkStorage ..> ParkController : loads/saves

note top of UserDirectory
  Users are identified by e-mail and looked up through
  UserDirectory (exists, dniOf). Individual tickets, groups and
  attractions reference users by e-mail, one-way: users never
  reference tickets, groups or attractions. A User class is not
  part of the code base yet.
end note
@enduml
