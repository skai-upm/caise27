@startuml model
' Amusement park - class model (Delivery 2: users, groups, tickets, system date)
hide empty members
skinparam classAttributeIconSize 0

package es.upm.parque {

  class App

  class CommandRunner

  class CommandProcessor {
    exitRequested : boolean
  }

  class SystemDate {
    current : LocalDate
  }

  class UserManager

  class GroupManager

  class UserRepository {
    file : Path
  }

  class GroupRepository {
    file : Path
  }

  class TicketManager {
    currentPrice : BigDecimal
  }

  class TicketRepository {
    file : Path
  }

  class User {
    name : String
    surname : String
    dni : String
    email : String
    password : String
    phone : String
    card : String
  }

  enum UserField {
    NAME
    SURNAME
    EMAIL
    PASSWORD
    PHONE
    CARD
  }

  class Group {
    id : String
    name : String
  }

  class Ticket {
    id : String
    date : LocalDate
    price : BigDecimal
  }

  class UserException

  class UserValidator
}

CommandRunner "0..*" o--> "1" CommandProcessor : processor
CommandProcessor "0..*" o--> "1" UserManager : userManager
CommandProcessor "0..*" o--> "1" GroupManager : groupManager
CommandProcessor "0..*" o--> "1" TicketManager : ticketManager
CommandProcessor "0..*" o--> "1" SystemDate : systemDate
UserManager "1" o--> "1" UserRepository : repository
UserManager "1" o--> "0..*" User : users
GroupManager "1" o--> "1" GroupRepository : repository
GroupManager "0..*" o--> "1" UserManager : userManager
GroupManager "1" o--> "0..*" Group : groups
Group "0..*" o--> "0..*" User : members
TicketManager "1" o--> "1" TicketRepository : repository
TicketManager "0..*" o--> "1" UserManager : userManager
TicketManager "0..*" o--> "1" SystemDate : systemDate
TicketManager "1" o--> "0..*" Ticket : tickets
Ticket "0..*" o--> "1" User : user

App ..> CommandRunner : <<use>>
UserManager ..> UserField : <<use>>
UserManager ..> UserValidator : <<use>>
UserManager ..> UserException : <<use>>
RuntimeException <|-- UserException

@enduml
