package es.upm.etsisi.amusementpark.business.repository {
  interface UserRepository {
  }

  interface GroupRepository {
  }

  interface TicketRepository {
  }

  interface AttractionRepository {
  }

  interface PassRepository {
  }

  class ParkRepositories <<record>> {
  }
}

package es.upm.etsisi.amusementpark.business.security {
  interface PasswordHasher {
  }

  class BCryptPasswordHasher {
  }

  class PasswordPolicy {
  }
}

package es.upm.etsisi.amusementpark.persistence {
  abstract class TextFileRepository {
    - file : Path
  }

  class TextUserRepository {
  }

  class TextGroupRepository {
  }

  class TextTicketRepository {
  }

  class TextAttractionRepository {
  }

  class TextPassRepository {
  }

  class TextRepositories {
  }
}

' ---- tickets ----
Ticket <|-- IndividualTicket
Ticket <|-- GroupTicket
Admission <|-- IndividualAdmission
Admission <|-- GroupAdmission
Admission <|.. Ticket
IndividualAdmission <|.. IndividualTicket
GroupAdmission <|.. GroupTicket

IndividualTicket "*" --> "1" User : user
GroupTicket "1" *--> "1..*" IndividualTicket : composition
GroupTicket "*" --> "0..1" Group : group
Group "*" o--> "*" User : members

' ---- passes (the ticket reference is declared in Pass) ----
Pass <|-- SpeedPass
Pass <|-- SpecialPass
SpeedPass "0..*" --> "1" IndividualTicket : ticket
SpecialPass "0..1" --> "1" IndividualTicket : ticket

' ---- attractions ----
Attraction <|-- GeneralAttraction : <<bind>> T -> Admission
Attraction <|-- IndividualAttraction : <<bind>> T -> IndividualAdmission
Attraction <|-- GroupAttraction : <<bind>> T -> GroupAdmission
Attraction <|-- SpecialAttraction : <<bind>> T -> IndividualAdmission
Attraction "0..1" o--> "0..*" User : occupants
Attraction ..> AttractionType : type
Attraction ..> EntryResult : enter
EntryResult --> "1..*" User : users
EntryResult --> "*" Pass : consumedPasses

' ---- invoices (Builder) ----
InvoiceBuilder <|-- UserInvoiceBuilder
InvoiceBuilder <|-- GroupInvoiceBuilder
InvoiceDirector ..> InvoiceBuilder : construct
InvoiceBuilder ..> Invoice : getResult
Invoice "1" *--> "*" InvoiceSection : sections
InvoiceSection "1" *--> "1..*" InvoiceItem : items
UserInvoiceBuilder --> "1" User : user
UserInvoiceBuilder --> "*" IndividualTicket : directTickets
UserInvoiceBuilder --> "*" Pass : passes
GroupInvoiceBuilder --> "1" Group : group
GroupInvoiceBuilder --> "*" GroupTicket : groupTickets

' ---- controllers and dependency injection ----
ParkController "1" *--> "*" User : users
ParkController "1" *--> "*" Group : groups
ParkController "1" *--> "*" Ticket : tickets
ParkController "1" *--> "*" Attraction : attractions
ParkController "1" *--> "*" Pass : passes
ParkController --> "0..1" ParkRepositories : repositories
ParkController --> "1" PasswordHasher : passwordHasher
InvoiceController --> "0..1" ParkController : park
InvoiceController --> "1" InvoiceDirector : director
ParkRepositories --> UserRepository : users
ParkRepositories --> GroupRepository : groups
ParkRepositories --> TicketRepository : tickets
ParkRepositories --> AttractionRepository : attractions
ParkRepositories --> PassRepository : passes
PasswordHasher <|.. BCryptPasswordHasher
ParkController ..> PasswordPolicy : validates
UserValidator ..> PasswordPolicy : password rule
UserValidator ..> User : validates data

TextFileRepository <|-- TextUserRepository
TextFileRepository <|-- TextGroupRepository
TextFileRepository <|-- TextTicketRepository
TextFileRepository <|-- TextAttractionRepository
TextFileRepository <|-- TextPassRepository
UserRepository <|.. TextUserRepository
GroupRepository <|.. TextGroupRepository
TicketRepository <|.. TextTicketRepository
AttractionRepository <|.. TextAttractionRepository
PassRepository <|.. TextPassRepository
TextRepositories ..> ParkRepositories : creates

App ..> TextRepositories : inDirectory(data | tmp)
App ..> ParkController : configure(repositories)
App ..> InvoiceController : configure(park)
App ..> CommandProcessor : creates
CommandProcessor --> ParkController : injected
CommandProcessor --> InvoiceController : injected

note bottom of Ticket
  price = sum of the prices of
  the individual tickets it consists of
end note
note right of Pass
  each Pass references one IndividualTicket;
  a ticket has any number of SpeedPasses
  and at most one Special Pass
end note
@enduml
