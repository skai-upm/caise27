@startuml model
title Amusement Park - Delivery 2 class model

hide empty methods
skinparam classAttributeIconSize 0

package core {
  class Park <<singleton>> {
    - {static} INSTANCE : Park
  }
  class SystemState {
    - currentDate : LocalDate
    - basePrice : BigDecimal
  }
  class DataPaths <<record>> {
    - directory : Path
  }
}

package model {
  class User {
    - firstName : String
    - surnames : String
    - dni : String {readOnly}
    - email : String
    - password : String
    - phone : String
    - card : String
  }

  enum UserField {
    NAME
    SURNAME
    EMAIL
    PASSWORD
    PHONE
    CARD
  }

  class Group {
    - id : String
    - name : String
  }

  abstract class Ticket {
    - id : String
    - date : LocalDate
    + {abstract} getPrice() : BigDecimal
    + {abstract} getUsers() : List<User>
  }

  class IndividualTicket {
    - basePrice : BigDecimal
    - discountPercent : int
  }

  class GroupTicket

  class GroupDiscount <<utility>>

  class Attraction {
    - id : String
    - name : String
    - capacity : int
  }
}

package repository {
  class UserRepository
  class GroupRepository
  class TicketRepository
  class AttractionRepository
}

Ticket <|-- IndividualTicket
Ticket <|-- GroupTicket

IndividualTicket "*" --> "1" User : user >
GroupTicket "1" *--> "1..*" IndividualTicket : tickets >
GroupTicket "*" --> "0..1" Group : group >
Group "*" o--> "*" User : members >
Attraction "*" o--> "*" User : occupants >
GroupTicket ..> GroupDiscount : discount at purchase

Park "1" *--> "1" SystemState : state >
Park "1" *--> "1" UserRepository
Park "1" *--> "1" GroupRepository
Park "1" *--> "1" TicketRepository
Park "1" *--> "1" AttractionRepository
Park ..> DataPaths : load(dataDirectory)

UserRepository "1" o--> "*" User
GroupRepository "1" o--> "*" Group
TicketRepository "1" o--> "*" Ticket : top-level tickets
AttractionRepository "1" o--> "*" Attraction

User ..> UserField : updatable fields

note right of GroupTicket
  Composition fixed at purchase:
  one IndividualTicket per member,
  id = <groupTicketId>:<dni>.
  group becomes null when the
  group is deleted.
end note

note bottom of User
  Users hold no references to
  tickets, groups or attractions.
end note
@enduml
