@startuml model
' Class model of the amusement park application, derived from the current implementation.
' Attributes: primitive, value and enumeration fields only. Relationships are named after the
' holding field; the holder end carries a cross (association) or a diamond (aggregation/composition).
hide empty members
hide circle
skinparam classAttributeIconSize 0

package es.upm.parque {
  class App

  class Bootstrap
}

package es.upm.parque.presentation {
  class CommandProcessor {
    finished : boolean
  }

  class CommandInfo {
    syntax : String
    description : String
  }

  class CommandRegistry

  class HelpGenerator

  interface HelpFormat

  class SyntaxHelpFormat

  class ExtendedHelpFormat
}

package es.upm.parque.business.model {
  class SystemDate {
    current : LocalDate
  }

  class User {
    name : String
    surname : String
    dni : String
    email : String
    password : String
    phone : String
    card : String
  }

  enum UserField {
    NAME
    SURNAME
    EMAIL
    PASSWORD
    PHONE
    CARD
  }

  class UserValidator

  class Group {
    id : String
    name : String
  }

  abstract class Ticket {
    id : String
    date : LocalDate
  }

  class IndividualTicket {
    price : BigDecimal
  }

  class GroupTicket {
    discountPercent : int
  }

  abstract class Attraction<T extends Admission> {
    id : String
    name : String
    capacity : int
    admitted : Class
  }

  class GeneralAttraction

  class IndividualAttraction

  class GroupAttraction

  class SpecialAttraction

  enum AttractionType {
    GENERAL
    INDIVIDUAL
    GROUP
    SPECIAL
  }

  interface Admission

  interface IndividualAdmission

  interface GroupAdmission

  class Invoice {
    recipientKind : String
    recipientId : String
    recipientName : String
    issueDate : LocalDate
    total : BigDecimal
  }

  class InvoiceSection {
    title : String
  }

  class InvoiceLine {
    description : String
    amount : BigDecimal
  }

  interface InvoiceBuilder

  class StandardInvoiceBuilder {
    recipientKind : String
    recipientId : String
    recipientName : String
    issueDate : LocalDate
  }

  abstract class PersonalPass {
    id : String
    price : BigDecimal
    consumed : boolean
  }

  class SpeedPass

  class SpecialPass

  class EntryCheck {
    rejection : String
  }
}

package es.upm.parque.business.controller {
  class InvoiceManager

  class UserManager

  class GroupManager

  class TicketManager {
    price : BigDecimal
  }

  class AttractionManager

  class PassManager

  class Controllers
}

package es.upm.parque.business.security {
  interface PasswordHasher

  class BCryptPasswordHasher {
    logRounds : int
  }
}

package es.upm.parque.persistence {
  class TemporaryDirectory

  interface UserRepository

  class TextFileUserRepository {
    file : Path
  }

  interface GroupRepository

  class TextFileGroupRepository {
    file : Path
  }

  interface TicketRepository

  class TextFileTicketRepository {
    file : Path
  }

  interface GroupTicketRepository

  class TextFileGroupTicketRepository {
    file : Path
  }

  interface AttractionRepository

  class TextFileAttractionRepository {
    file : Path
  }

  interface PassRepository

  class TextFilePassRepository {
    file : Path
  }
}

' Inheritance
IndividualTicket --|> Ticket
GroupTicket --|> Ticket
SpeedPass --|> PersonalPass
SpecialPass --|> PersonalPass
GeneralAttraction --|> Attraction
IndividualAttraction --|> Attraction
GroupAttraction --|> Attraction
SpecialAttraction --|> Attraction
IndividualAdmission --|> Admission
GroupAdmission --|> Admission
StandardInvoiceBuilder ..|> InvoiceBuilder
SyntaxHelpFormat ..|> HelpFormat
BCryptPasswordHasher ..|> PasswordHasher
TextFilePassRepository ..|> PassRepository
Ticket ..|> Admission
IndividualTicket ..|> IndividualAdmission
GroupTicket ..|> GroupAdmission
ExtendedHelpFormat ..|> HelpFormat
TextFileUserRepository ..|> UserRepository
TextFileGroupRepository ..|> GroupRepository
TextFileTicketRepository ..|> TicketRepository
TextFileGroupTicketRepository ..|> GroupTicketRepository
TextFileAttractionRepository ..|> AttractionRepository

' Associations held by the command processor
CommandProcessor "1" x--> "1" UserManager : users
CommandProcessor "1" x--> "1" GroupManager : groups
CommandProcessor "1" x--> "1" TicketManager : tickets
CommandProcessor "1" x--> "1" AttractionManager : attractions
CommandProcessor "1" x--> "1" InvoiceManager : invoices
CommandProcessor "1" x--> "1" PassManager : passes
CommandProcessor "1" x--> "1" SystemDate : systemDate
CommandProcessor "1" o--> "1..*" HelpGenerator : helpModes

' Help
HelpGenerator "0..*" x--> "1" CommandRegistry : registry
HelpGenerator "0..*" x--> "1" HelpFormat : format
CommandRegistry "1" *--> "0..*" CommandInfo : commands

' Users
UserManager "1" x--> "1" UserRepository : repository
UserManager "1" o--> "0..*" User : usersByDni
UserManager "1" x--> "1" PasswordHasher : hasher

' Groups
GroupManager "1" x--> "1" GroupRepository : repository
GroupManager "1" x--> "1" UserManager : users
GroupManager "1" o--> "0..*" Group : groupsById
Group "0..*" o--> "0..*" User : members

' Tickets
TicketManager "1" x--> "1" TicketRepository : repository
TicketManager "1" x--> "1" GroupTicketRepository : groupRepository
TicketManager "1" x--> "1" PassRepository : passRepository
TicketManager "1" x--> "1" UserManager : users
TicketManager "1" x--> "1" GroupManager : groups
TicketManager "1" x--> "1" SystemDate : systemDate
TicketManager "1" o--> "0..*" IndividualTicket : ticketsById
TicketManager "1" o--> "0..*" GroupTicket : groupTicketsById
IndividualTicket "0..*" x--> "1" User : holder
GroupTicket "0..*" o--> "1" Group : group
GroupTicket "1" *--> "1..*" IndividualTicket : tickets

' Attractions
AttractionManager "1" x--> "1" AttractionRepository : repository
AttractionManager "1" x--> "1" TicketManager : tickets
AttractionManager "1" x--> "1" PassManager : passes
AttractionManager "1" x--> "1" SystemDate : systemDate
AttractionManager "1" o--> "0..*" Attraction : attractionsById
Attraction "0..*" o--> "0..*" User : present

' Invoices
InvoiceManager "1" x--> "1" UserManager : users
InvoiceManager "1" x--> "1" GroupManager : groups
InvoiceManager "1" x--> "1" TicketManager : tickets
InvoiceManager "1" x--> "1" SystemDate : systemDate
InvoiceManager "1" x--> "1" InvoiceBuilder : builderFactory
Invoice "1" *--> "0..*" InvoiceSection : sections
InvoiceSection "1" *--> "0..*" InvoiceLine : lines
StandardInvoiceBuilder "1" o--> "0..*" InvoiceSection : sections

' Passes
IndividualTicket "1" *--> "0..*" SpeedPass : speedPasses
IndividualTicket "1" *--> "0..1" SpecialPass : specialPass
PassManager "1" x--> "1" PassRepository : repository
PassManager "1" x--> "1" TicketManager : tickets
PassManager "1" x--> "1" SystemDate : systemDate
EntryCheck "0..*" o--> "0..*" PersonalPass : passes

' Controllers handed to the presentation layer at startup
Controllers "0..1" x--> "1" UserManager : users
Controllers "0..1" x--> "1" GroupManager : groups
Controllers "0..1" x--> "1" TicketManager : tickets
Controllers "0..1" x--> "1" AttractionManager : attractions
Controllers "0..1" x--> "1" InvoiceManager : invoices
Controllers "0..1" x--> "1" PassManager : passes

' Usage of classes without incoming relationships
App ..> CommandProcessor : creates and runs
App ..> TemporaryDirectory : uses in --fly mode
App ..> Bootstrap : configures the application
Bootstrap ..> StandardInvoiceBuilder : supplies invoice builders
Bootstrap ..> BCryptPasswordHasher : injects into UserManager
Bootstrap ..> TextFilePassRepository : creates
Bootstrap ..> Controllers : hands to CommandProcessor
AttractionManager ..> AttractionType : creates attractions by type
Attraction ..> EntryCheck : checks pass rules
AttractionType ..> GeneralAttraction : creates
AttractionType ..> IndividualAttraction : creates
AttractionType ..> GroupAttraction : creates
AttractionType ..> SpecialAttraction : creates
Bootstrap ..> SyntaxHelpFormat : injects into HELP
Bootstrap ..> ExtendedHelpFormat : injects into HELP EXTENDED
Bootstrap ..> TextFileUserRepository : creates
Bootstrap ..> TextFileGroupRepository : creates
Bootstrap ..> TextFileTicketRepository : creates
Bootstrap ..> TextFileGroupTicketRepository : creates
Bootstrap ..> TextFileAttractionRepository : creates
StandardInvoiceBuilder ..> Invoice : builds
UserManager ..> UserField : uses
UserManager ..> UserValidator : uses
GroupManager ..> UserValidator : uses
TicketManager ..> UserValidator : uses
AttractionManager ..> UserValidator : uses
@enduml
