@startuml model
' Amusement Park - Delivery 2 class model.
' Only relevant attributes are shown; methods and constructors are omitted.
hide empty methods

package park {
  class Park <<singleton>> {
    + {static} INITIAL_PRICE : BigDecimal
    - currentDate : LocalDate
    - basePrice : BigDecimal
  }
  note right of Park
    Exactly one instance per execution:
    private constructor, obtained with getInstance().
    Group lock and user lock are derived from
    the tickets and currentDate, never stored.
  end note
}

package user {
  class User {
    - firstName : String
    - surnames : String
    - dni : String {readOnly}
    - email : String
    - password : String
    - phone : String
    - card : String
  }
  enum UserField {
    NAME
    SURNAME
    EMAIL
    PASSWORD
    PHONE
    CARD
  }
  class UserService
}

package group {
  class Group {
    - id : String
    - name : String
  }
}

package ticket {
  abstract class Ticket {
    - id : String
    - date : LocalDate
  }
  class IndividualTicket {
    - basePrice : BigDecimal
    - discountPercent : int
  }
  class GroupTicket
}

package attraction {
  class Attraction {
    - id : String
    - name : String
    - capacity : int
  }
}

package persistence {
  interface UserRepository
  class UserFileRepository
  class GroupFileRepository
  class TicketFileRepository
  class AttractionFileRepository
  class ParkStorage {
    - directory : Path
  }
}

' --- inheritance and implementations ---
Ticket <|-- IndividualTicket
Ticket <|-- GroupTicket
UserRepository <|.. UserFileRepository

' --- central management ---
Park "1" --> "1" UserService : users
Park "1" --> "*" Group : groups
Park "1" --> "*" Ticket : tickets
Park "1" --> "*" Attraction : attractions
Park "1" --> "1" ParkStorage : storage
UserService "1" --> "*" User : users
UserService "1" --> "1" UserRepository : repository
UserService ..> UserField

' --- domain relationships (directions as implemented) ---
Group "*" --> "*" User : members
Attraction "*" --> "*" User : occupants
IndividualTicket "*" --> "1" User : user
GroupTicket "*" --> "0..1" Group : group
GroupTicket "1" *-- "1..*" IndividualTicket : composition

' --- persistence configuration (same repositories for normal and --fly) ---
ParkStorage "1" --> "1" UserFileRepository : users
ParkStorage "1" --> "1" GroupFileRepository : groups
ParkStorage "1" --> "1" TicketFileRepository : tickets
ParkStorage "1" --> "1" AttractionFileRepository : attractions
@enduml
