@startuml model
' Amusement park - class model (Delivery 2: users, groups, tickets, attractions, system date)
hide empty members
skinparam classAttributeIconSize 0

package es.upm.parque {

  class App

  class CommandRunner

  class CommandProcessor {
    exitRequested : boolean
  }

  class SystemDate {
    current : LocalDate
  }

  class UserManager

  class GroupManager

  class UserRepository {
    file : Path
  }

  class GroupRepository {
    file : Path
  }

  class TicketManager {
    currentPrice : BigDecimal
  }

  class TicketRepository {
    ticketsFile : Path
    groupTicketsFile : Path
  }

  class User {
    name : String
    surname : String
    dni : String
    email : String
    password : String
    phone : String
    card : String
  }

  enum UserField {
    NAME
    SURNAME
    EMAIL
    PASSWORD
    PHONE
    CARD
  }

  class Group {
    id : String
    name : String
  }

  class AttractionManager

  class AttractionRepository {
    file : Path
  }

  class Attraction {
    id : String
    name : String
    capacity : int
  }

  abstract class Ticket {
    id : String
    date : LocalDate
  }

  class IndividualTicket {
    price : BigDecimal
  }

  class GroupTicket {
    discountPercent : int
  }

  class UserException

  class UserValidator
}

CommandRunner "0..*" o--> "1" CommandProcessor : processor
CommandProcessor "0..*" o--> "1" UserManager : userManager
CommandProcessor "0..*" o--> "1" GroupManager : groupManager
CommandProcessor "0..*" o--> "1" TicketManager : ticketManager
CommandProcessor "0..*" o--> "1" SystemDate : systemDate
UserManager "1" o--> "1" UserRepository : repository
UserManager "1" o--> "0..*" User : users
GroupManager "1" o--> "1" GroupRepository : repository
GroupManager "0..*" o--> "1" UserManager : userManager
GroupManager "1" o--> "0..*" Group : groups
Group "0..*" o--> "0..*" User : members
TicketManager "1" o--> "1" TicketRepository : repository
TicketManager "0..*" o--> "1" UserManager : userManager
TicketManager "0..*" o--> "1" GroupManager : groupManager
TicketManager "0..*" o--> "1" SystemDate : systemDate
TicketManager "1" o--> "0..*" Ticket : tickets
Ticket <|-- IndividualTicket
Ticket <|-- GroupTicket
IndividualTicket "0..*" o--> "1" User : user
GroupTicket "0..*" o--> "1" Group : group
GroupTicket "1" *--> "1..*" IndividualTicket : tickets
CommandProcessor "0..*" o--> "1" AttractionManager : attractionManager
AttractionManager "1" o--> "1" AttractionRepository : repository
AttractionManager "0..*" o--> "1" TicketManager : ticketManager
AttractionManager "0..*" o--> "1" SystemDate : systemDate
AttractionManager "1" o--> "0..*" Attraction : attractions
Attraction "0..*" o--> "0..*" User : visitors

App ..> CommandRunner : <<use>>
UserManager ..> UserField : <<use>>
UserManager ..> UserValidator : <<use>>
UserManager ..> UserException : <<use>>
RuntimeException <|-- UserException

@enduml
