package es.upm.parque.business.model {

  class User {
    name : String
    surname : String
    dni : String
    email : String
    password : String
    phone : String
    card : String
  }

  enum UserField {
    NAME
    SURNAME
    EMAIL
    PASSWORD
    PHONE
    CARD
  }

  class Group {
    id : String
    name : String
  }

  abstract class Ticket {
    id : String
    date : LocalDate
  }

  class IndividualTicket {
    price : BigDecimal
  }

  class GroupTicket {
    totalPrice : BigDecimal
  }

  class Attraction {
    id : String
    name : String
    capacity : int
  }

  class SystemDate {
    date : LocalDate
  }
}

package es.upm.parque.business.controller {

  class UserController <<Singleton>> {
  }

  class GroupController <<Singleton>> {
  }

  class TicketController <<Singleton>> {
    price : BigDecimal
  }

  class AttractionController <<Singleton>> {
  }

  class InvoiceController <<Singleton>> {
  }
}

package es.upm.parque.business.invoice {

  class Invoice {
    recipientType : String
