@startuml model
title Amusement Park - Delivery 3 class model (layered: presentation / business / persistence)

skinparam classAttributeIconSize 0
hide empty members

package es.upm.amusementpark.business.model {
  class User {
    - firstName : String
    - surnames : String
    - dni : String {readOnly}
    - email : String
    - password : String
    - phone : String
    - cardNumber : String
  }

  enum UserField {
    NAME
    SURNAME
    EMAIL
    PASSWORD
    PHONE
    CARD
  }

  class UserValidator <<utility>>

  class Group {
    - id : String {readOnly}
    - name : String
  }

  abstract class Ticket {
    - id : String {readOnly}
    - date : LocalDate {readOnly}
  }

  class IndividualTicket {
    - basePrice : BigDecimal
    - discount : BigDecimal
    - partOfGroupTicket : boolean
  }

  class GroupTicket {
  }

  abstract class Pass {
    - id : String {readOnly}
    - consumed : boolean
  }

  class SpeedPass
  class SpecialPass

  interface AccessTicket
  interface GeneralAccess
  interface IndividualAccess
  interface GroupAccess
  interface PassLookup
  class EntryResult <<record>>

  abstract class Attraction<T extends AccessTicket> {
    - id : String {readOnly}
    - name : String
    - capacity : int {readOnly}
    - accepted : Class<T>
  }
  class GeneralAttraction
  class IndividualAttraction
  class GroupAttraction
  class SpecialAttraction

  enum AttractionType {
    GENERAL
    INDIVIDUAL
    GROUP
    SPECIAL
  }
}

package es.upm.amusementpark.persistence.repository {
  class UserRepository
  class GroupRepository
  class TicketRepository
  class AttractionRepository
  class PassRepository
}

package es.upm.amusementpark.business.invoice {
  class Invoice {
    - title : String
    - header : List<String>
    - total : BigDecimal
  }
  class InvoiceSection <<record>> {
    title : String
  }
  class InvoiceItem {
    - description : String
    - amount : BigDecimal [0..1]
  }
  abstract class InvoiceBuilder
  class UserInvoiceBuilder
  class GroupInvoiceBuilder
}

package es.upm.amusementpark.business.service {
  class PassService <<singleton>>
  class InvoiceService <<singleton>>
  class UserService <<singleton>>
  class GroupService <<singleton>>
  class TicketService <<singleton>>
  class AttractionService <<singleton>>
  interface ActiveGroupTicketCheck
  class AttractionStatus <<record>> {
    id : String
    name : String
    capacity : int
    occupants : int
    available : int
    occupantEmails : List<String>
  }
}

package es.upm.amusementpark.business.exception {
  abstract class ParkException
  class ValidationException
  class NotFoundException
  class ConflictException
  class OperationNotAllowedException
  class DataAccessException
}

package es.upm.amusementpark.persistence.file {
  interface UserStorage
  class UserFileStorage
  class GroupFileStorage
  class TicketFileStorage
  class AttractionFileStorage
  class PassFileStorage
  class ParkStorage <<record>>
  class DataLocation <<record>> {
    directory : Path
  }
}

package es.upm.amusementpark.business {
  class ParkInitializer <<composition root>>
  class ParkDependencies <<record>>
  class ParkController <<singleton>> {
    - {static} INSTANCE : ParkController
    - currentDate : LocalDate
    - basePrice : BigDecimal
  }
}

package es.upm.amusementpark.presentation {
  class App
  class CommandProcessor {
    - exitRequested : boolean
  }
  class CommandSyntaxException
  class InvoiceFormatter
  class CommandCatalog
  class CommandDescriptor <<record>>
  interface HelpFormat
  class BasicHelpFormat
  class ExtendedHelpFormat
  class HelpGenerator
}

' --- ticket hierarchy and composition
Ticket <|-- IndividualTicket
Ticket <|-- GroupTicket
GroupTicket "1" *-- "1..*" IndividualTicket : composition >
IndividualTicket "0..*" --> "1" User : user >
GroupTicket "0..*" --> "0..1" Group : group >

' --- passes (personal add-ons of individual tickets)
Pass <|-- SpeedPass
Pass <|-- SpecialPass
SpeedPass "0..*" --> "1" IndividualTicket : ticket >
SpecialPass "0..1" --> "1" IndividualTicket : ticket >
PassRepository "1" o-- "0..*" Pass
PassService --> "1" PassRepository
PassService --> "1" TicketService

' --- invoices (Builder)
InvoiceBuilder <|-- UserInvoiceBuilder
InvoiceBuilder <|-- GroupInvoiceBuilder
InvoiceBuilder ..> Invoice : builds >
Invoice "1" *-- "0..*" InvoiceSection
InvoiceSection "1" *-- "1..*" InvoiceItem
InvoiceService ..> UserInvoiceBuilder : directs >
InvoiceService ..> GroupInvoiceBuilder : directs >
InvoiceService --> "1" PassService
ParkController "1" --> "1" PassService
ParkController "1" --> "1" InvoiceService

' --- access capabilities and generic attractions
AccessTicket <|-- GeneralAccess
AccessTicket <|-- IndividualAccess
AccessTicket <|-- GroupAccess
Ticket ..|> AccessTicket
IndividualTicket ..|> IndividualAccess
IndividualTicket ..|> GeneralAccess
GroupTicket ..|> GroupAccess
GroupTicket ..|> GeneralAccess
Attraction <|-- GeneralAttraction : <T = GeneralAccess>
Attraction <|-- IndividualAttraction : <T = IndividualAccess>
Attraction <|-- GroupAttraction : <T = GroupAccess>
Attraction <|-- SpecialAttraction : <T = IndividualAccess>
SpecialAttraction ..> PassLookup : requires Special Pass
PassService ..|> PassLookup
AttractionService --> "1" PassLookup
AttractionType ..> Attraction : creates >
Attraction ..> EntryResult : enter() returns >
EntryResult --> "0..*" User : users >
EntryResult --> "0..*" Pass : consumed >

' --- users, groups and attractions
Group "0..*" --> "0..*" User : members >
Attraction "0..1" --> "0..*" User : occupants >
UserService ..> UserField
UserService ..> UserValidator

' --- repositories own the domain objects
UserRepository "1" o-- "0..*" User
GroupRepository "1" o-- "0..*" Group
TicketRepository "1" o-- "0..*" Ticket
AttractionRepository "1" o-- "0..*" Attraction

' --- services
UserService --> "1" UserRepository
UserService --> "0..1" UserStorage
GroupService --> "1" GroupRepository
GroupService --> "1" UserService
GroupService --> "1" ActiveGroupTicketCheck : lock check >
TicketService --> "1" TicketRepository
TicketService --> "1" UserService
AttractionService --> "1" AttractionRepository
AttractionService ..> AttractionStatus

' --- persistence
UserFileStorage ..|> UserStorage
ParkStorage *-- "1" GroupFileStorage
ParkStorage *-- "1" TicketFileStorage
ParkStorage *-- "1" AttractionFileStorage
ParkStorage *-- "1" PassFileStorage
DataLocation <.. ParkStorage : paths >

' --- dependency injection (composition root wires singletons with fresh repositories)
ParkInitializer ..> ParkDependencies : creates >
ParkInitializer ..> ParkController : configure() >
ParkInitializer ..> UserService : configure() >
ParkInitializer ..> GroupService : configure() >
ParkInitializer ..> TicketService : configure() >
ParkInitializer ..> AttractionService : configure() >
ParkInitializer ..> PassService : configure() >
ParkInitializer ..> InvoiceService : configure() >
ParkDependencies --> "1" UserRepository
ParkDependencies --> "1" GroupRepository
ParkDependencies --> "1" TicketRepository
ParkDependencies --> "1" AttractionRepository
ParkDependencies --> "1" PassRepository
ParkDependencies --> "0..1" UserStorage
ParkDependencies --> "0..1" ParkStorage
ParkController --> "1" ParkDependencies

' --- help generation (injected strategy)
HelpGenerator --> "1" HelpFormat : injected >
HelpGenerator --> "1..*" CommandDescriptor
BasicHelpFormat ..|> HelpFormat
ExtendedHelpFormat ..|> HelpFormat
CommandCatalog ..> CommandDescriptor
CommandProcessor --> "2" HelpGenerator : HELP / HELP EXTENDED >
CommandProcessor ..> InvoiceFormatter

' --- central management
ParkController "1" --> "1" UserService
ParkController "1" --> "1" GroupService
ParkController "1" --> "1" TicketService
ParkController "1" --> "1" AttractionService

'' --- exceptions
ParkException <|-- ValidationException
ParkException <|-- NotFoundException
ParkException <|-- ConflictException
ParkException <|-- OperationNotAllowedException
ParkException <|-- DataAccessException
ParkException <|-- CommandSyntaxException
CommandProcessor ..> ParkException : handles >

' --- application layer
App --> "1" CommandProcessor
CommandProcessor --> "1" ParkController
App ..> ParkController : getInstance()
ParkController ..> DataLocation : temporary / delete
@enduml
