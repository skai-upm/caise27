@startuml model
title Amusement Park - Delivery 2 class model

skinparam classAttributeIconSize 0
hide empty methods

package es.upm.amusementpark {

  class ParkController <<singleton>> {
    - {static} INSTANCE : ParkController
    - currentDate : LocalDate
    - price : BigDecimal
  }

  class User {
    - firstName : String
    - surnames : String
    - dni : String {readOnly}
    - email : String
    - password : String
    - phone : String
    - card : String
  }

  enum UserField {
    NAME
    SURNAME
    EMAIL
    PASSWORD
    PHONE
    CARD
  }

  class Group {
    - id : String
    - name : String
  }

  abstract class Ticket {
    - id : String
    - date : LocalDate
  }

  class IndividualTicket {
    - basePrice : BigDecimal
    - discountPercent : int
  }

  class GroupTicket {
  }

  class Attraction {
    - id : String
    - name : String
    - capacity : int
  }

  class UserService
  class UserRepository
  class GroupRepository
  class TicketRepository
  class AttractionRepository
  class CommandProcessor
  class CommandRunner
  class App
}

' Ticket hierarchy
Ticket <|-- IndividualTicket
Ticket <|-- GroupTicket

' Composition: a group ticket owns its individual tickets
GroupTicket "1" *--> "1..*" IndividualTicket : composition

' Unidirectional domain associations
IndividualTicket "*" --> "1" User : user
GroupTicket "*" --> "0..1" Group : group
Group "*" --> "*" User : members
Attraction "*" --> "*" User : occupants

' Central management
ParkController "1" --> "1" UserService : userService
ParkController "1" --> "*" Group : groups
ParkController "1" --> "*" Ticket : tickets
ParkController "1" --> "*" Attraction : attractions
ParkController --> GroupRepository
ParkController --> TicketRepository
ParkController --> AttractionRepository
UserService "1" --> "*" User : users
UserService --> UserRepository
UserService ..> UserField : uses

' Application layer
App ..> ParkController : getInstance()
App ..> CommandRunner
CommandRunner --> CommandProcessor
CommandProcessor --> ParkController

@enduml
