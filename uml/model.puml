  }

  class DefaultInvoiceBuilder {
    recipientType : String
    recipientId : String
    recipientName : String
    issueDate : LocalDate
  }

  class InvoiceDirector {
  }
}

package es.upm.parque.business.repository {

  interface UserRepository {
  }

  interface GroupRepository {
  }

  interface TicketRepository {
  }

  interface AttractionRepository {
  }
}

package es.upm.parque.business.validation {

  class UserValidator {
  }
}

package es.upm.parque.persistence {

  class FileUserRepository {
    file : Path
  }

  class FileGroupRepository {
    file : Path
  }

  class FileTicketRepository {
    individualFile : Path
    groupFile : Path
  }

  class FileAttractionRepository {
    file : Path
  }

  class TemporaryDataDirectory {
    path : Path
  }
}

' Inheritance
Ticket <|-- IndividualTicket
Ticket <|-- GroupTicket

' Associations, aggregations and compositions (named after the owning field)
CommandProcessor x--> "1" UserController : userController
CommandProcessor x--> "1" GroupController : groupController
CommandProcessor x--> "1" TicketController : ticketController
CommandProcessor x--> "1" AttractionController : attractionController
CommandProcessor x--> "1" InvoiceController : invoiceController
CommandProcessor x--> "1" SystemDate : systemDate
CommandProcessor x--> "0..*" HelpGenerator : helpGenerators
HelpGenerator x--> "1" CommandCatalog : catalog
HelpGenerator x--> "1" HelpFormat : format
HelpFormat <|.. ConciseHelpFormat
HelpFormat <|.. ExtendedHelpFormat
CommandCatalog x--> "0..*" CommandDescriptor : commands

UserController x--> "1" UserRepository : repository
UserController x--> "0..*" User : users

GroupController x--> "1" GroupRepository : repository
GroupController x--> "1" UserController : userController
GroupController x--> "0..*" Group : groups
Group x--> "0..*" User : members

TicketController x--> "1" TicketRepository : repository
TicketController x--> "1" UserController : userController
TicketController x--> "1" GroupController : groupController
TicketController x--> "1" SystemDate : systemDate
TicketController x--> "0..*" Ticket : tickets
IndividualTicket x--> "1" User : user
GroupTicket o--> "1" Group : group
GroupTicket *--> "1..*" IndividualTicket : tickets

AttractionController x--> "1" AttractionRepository : repository
AttractionController x--> "1" TicketController : ticketController
AttractionController x--> "1" SystemDate : systemDate
AttractionController x--> "0..*" Attraction : attractions
Attraction x--> "0..*" User : present

InvoiceController x--> "1" UserController : userController
InvoiceController x--> "1" GroupController : groupController
InvoiceController x--> "1" TicketController : ticketController
InvoiceController x--> "1" SystemDate : systemDate
InvoiceController x--> "1" InvoiceBuilder : builder
InvoiceController x--> "1" InvoiceDirector : director
InvoiceBuilder <|.. DefaultInvoiceBuilder
DefaultInvoiceBuilder x--> "0..*" InvoiceSection : sections
Invoice x--> "0..*" InvoiceSection : sections
InvoiceSection x--> "0..*" InvoiceLine : lines

UserRepository <|.. FileUserRepository
GroupRepository <|.. FileGroupRepository
TicketRepository <|.. FileTicketRepository
AttractionRepository <|.. FileAttractionRepository

' Usage, only for classes without incoming relationships
App ..> CommandProcessor
App ..> TemporaryDataDirectory
App ..> ConciseHelpFormat
App ..> ExtendedHelpFormat
App ..> FileUserRepository
App ..> FileGroupRepository
App ..> FileTicketRepository
App ..> FileAttractionRepository
DefaultInvoiceBuilder ..> Invoice
CommandProcessor ..> UserField
UserController ..> UserField
UserController ..> UserValidator
GroupController ..> UserValidator
TicketController ..> UserValidator
AttractionController ..> UserValidator

@enduml
