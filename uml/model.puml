@startuml model
' Delivery 3 class model of es.upm.etsisi.amusementpark (attributes only).
hide empty methods
skinparam classAttributeIconSize 0

package es.upm.etsisi.amusementpark {
  class App <<composition root>> {
    {static} DATA_DIRECTORY : Path
    {static} FLY_OPTION : String
  }
}

package es.upm.etsisi.amusementpark.presentation {
  class CommandProcessor {
    - out : PrintStream
  }
  class CommandCatalog
  class "CommandCatalog.CommandInfo" as CommandInfo <<record>> {
    syntax : String
    purpose : String
  }
  class HelpGenerator
  interface HelpFormat
  class SyntaxHelpFormat
  class ExtendedHelpFormat
}

package es.upm.etsisi.amusementpark.business {
  abstract class ParkException
  class InvalidDataException
  class NotFoundException
  class RuleViolationException
  class StorageException

  class User {
    - firstName : String
    - surnames : String
    - dni : String {readOnly}
    - email : String
    - passwordHash : String
    - phone : String
    - card : String
  }
  enum UserField {
    NAME
    SURNAME
    EMAIL
    PASSWORD
    PHONE
    CARD
  }
  interface PasswordHasher
}

package es.upm.etsisi.amusementpark.business.group {
  class Group {
    - identifier : String {readOnly}
    - name : String {readOnly}
  }
}

package es.upm.etsisi.amusementpark.business.ticket {
  interface AccessTicket
  interface IndividualAccess
  interface GroupAccess

  abstract class Ticket {
    - identifier : String {readOnly}
    - date : LocalDate {readOnly}
  }
  class IndividualTicket {
    - basePrice : BigDecimal {readOnly}
    - discount : BigDecimal {readOnly}
  }
  class GroupTicket

  abstract class Pass {
    - identifier : String {readOnly}
    - price : BigDecimal {readOnly}
    - consumed : boolean
  }
  class SpeedPass
  class SpecialPass
}

package es.upm.etsisi.amusementpark.business.attraction {
  interface Attraction
  abstract class "AbstractAttraction<T extends AccessTicket>" as AbstractAttraction {
    - identifier : String {readOnly}
    - name : String {readOnly}
    - capacity : int {readOnly}
    - accessType : Class<T> {readOnly}
  }
  class "GeneralAttraction" as GeneralAttraction
  class "IndividualAttraction" as IndividualAttraction
  class "GroupAttraction" as GroupAttraction
  class "SpecialAttraction" as SpecialAttraction
  enum AttractionType {
    GENERAL
    INDIVIDUAL
    GROUP
    SPECIAL
  }
  interface PassLookup
  class EntryResult <<record>>
}

package es.upm.etsisi.amusementpark.business.repository {
  class ParkRepositories <<record>>
  interface UserRepository
  interface GroupRepository
  interface TicketRepository
  interface AttractionRepository
  interface PassRepository
}

package es.upm.etsisi.amusementpark.business.controller {
  class ParkController <<singleton>> {
    {static} INITIAL_PRICE : BigDecimal
    {static} - INSTANCE : ParkController
    - today : LocalDate
    - basePrice : BigDecimal
  }
  class InvoiceController <<singleton>> {
    {static} - INSTANCE : InvoiceController
  }
}

package es.upm.etsisi.amusementpark.business.invoice {
  abstract class "InvoiceBuilder<B extends InvoiceBuilder<B>>" as InvoiceBuilder {
    - title : String {readOnly}
    - header : List<String>
  }
  class UserInvoiceBuilder
  class GroupInvoiceBuilder
  class Invoice {
    - title : String
    - header : List<String>
    - total : BigDecimal
  }
  class "Invoice.Section" as InvoiceSection <<record>> {
    title : String
  }
  class "Invoice.Item" as InvoiceItem <<record>> {
    description : String
    amount : BigDecimal
    details : List<String>
  }
}

package es.upm.etsisi.amusementpark.persistence {
  class TextRepositories <<factory>>
  class TextUserRepository {
    - file : Path
  }
  class TextGroupRepository {
    - file : Path
  }
  class TextTicketRepository {
    - file : Path
  }
  class TextAttractionRepository {
    - file : Path
  }
  class TextPassRepository {
    - file : Path
  }
  class BCryptPasswordHasher {
    - logRounds : int {readOnly}
  }
  class FlyWorkspace {
    - root : Path
    - directory : Path
  }
}

' exceptions
ParkException <|-- InvalidDataException
ParkException <|-- NotFoundException
ParkException <|-- RuleViolationException
ParkException <|-- StorageException

' access capabilities and ticket hierarchy
AccessTicket <|-- IndividualAccess
AccessTicket <|-- GroupAccess
AccessTicket <|.. Ticket
Ticket <|-- IndividualTicket
Ticket <|-- GroupTicket
IndividualAccess <|.. IndividualTicket
GroupAccess <|.. GroupTicket

IndividualTicket "*" --> "1" User : user
GroupTicket "*" --> "0..1" Group : group
GroupTicket "0..1" *--> "1..*" IndividualTicket : composition
Group "*" --> "*" User : members

' passes (unidirectional pass -> ticket)
Pass <|-- SpeedPass
Pass <|-- SpecialPass
SpeedPass "0..*" --> "1" IndividualTicket : ticket
SpecialPass "0..1" --> "1" IndividualTicket : ticket

' generic attraction types (bound T shown on each realisation)
Attraction <|.. AbstractAttraction
AbstractAttraction <|-- GeneralAttraction : <<bind>> T -> AccessTicket
AbstractAttraction <|-- IndividualAttraction : <<bind>> T -> IndividualAccess
AbstractAttraction <|-- GroupAttraction : <<bind>> T -> GroupAccess
AbstractAttraction <|-- SpecialAttraction : <<bind>> T -> IndividualAccess
AbstractAttraction "*" --> "*" User : occupants
AbstractAttraction ..> AccessTicket : T
Attraction ..> AttractionType
Attraction ..> PassLookup
Attraction ..> EntryResult
SpecialAttraction ..> SpecialPass
EntryResult --> "*" User : admitted
EntryResult --> "*" Pass : consumedPasses

' central management (repositories and hasher injected by App)
PassLookup <|.. ParkController
ParkController "1" --> "*" User : users
ParkController "1" --> "*" Group : groups
ParkController "1" --> "*" Ticket : tickets
ParkController "1" --> "*" Pass : passes
ParkController "1" --> "*" Attraction : attractions
ParkController "1" --> "1" ParkRepositories : repositories <<injected>>
ParkController "1" --> "1" PasswordHasher : passwordHasher <<injected>>
InvoiceController "1" --> "1" ParkController : park <<injected>>

ParkRepositories --> "1" UserRepository : users
ParkRepositories --> "1" GroupRepository : groups
ParkRepositories --> "1" TicketRepository : tickets
ParkRepositories --> "1" AttractionRepository : attractions
ParkRepositories --> "1" PassRepository : passes

' invoices (Builder)
InvoiceBuilder <|-- UserInvoiceBuilder
InvoiceBuilder <|-- GroupInvoiceBuilder
InvoiceBuilder "1" *--> "*" InvoiceSection : sections
InvoiceBuilder ..> Invoice : builds
Invoice "1" *--> "*" InvoiceSection : sections
InvoiceSection "1" *--> "*" InvoiceItem : items
InvoiceController ..> UserInvoiceBuilder
InvoiceController ..> GroupInvoiceBuilder

' presentation
CommandProcessor "*" --> "1" ParkController : park <<injected>>
CommandProcessor "*" --> "1" InvoiceController : invoices <<injected>>
CommandProcessor "1" --> "*" HelpGenerator : helpGenerators <<injected>>
HelpGenerator "*" --> "1" CommandCatalog : catalog
HelpGenerator "*" --> "1" HelpFormat : format <<injected>>
CommandCatalog "1" *--> "*" CommandInfo : commands
HelpFormat <|.. SyntaxHelpFormat
HelpFormat <|.. ExtendedHelpFormat

' persistence implementations
UserRepository <|.. TextUserRepository
GroupRepository <|.. TextGroupRepository
TicketRepository <|.. TextTicketRepository
AttractionRepository <|.. TextAttractionRepository
PassRepository <|.. TextPassRepository
PasswordHasher <|.. BCryptPasswordHasher
TextRepositories ..> ParkRepositories : creates

' composition root
App ..> TextRepositories
App ..> BCryptPasswordHasher
App ..> FlyWorkspace
App ..> CommandProcessor
App ..> ParkController
App ..> InvoiceController
@enduml
