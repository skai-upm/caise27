@startuml model
title Amusement park - class model (current implementation)

package es.upm.parque.presentation {

  class App {
  }

  class CommandProcessor {
    exitRequested : boolean
  }
}

package es.upm.parque.business.model {

  class User {
    name : String
    surname : String
    dni : String
    email : String
    password : String
    phone : String
    card : String
  }

  enum UserField {
    NAME
    SURNAME
    EMAIL
    PASSWORD
    PHONE
    CARD
  }

  class Group {
    id : String
    name : String
  }

  abstract class Ticket {
    id : String
    date : LocalDate
  }

  class IndividualTicket {
    price : BigDecimal
  }

  class GroupTicket {
    totalPrice : BigDecimal
  }

  class Attraction {
    id : String
    name : String
    capacity : int
  }

  class SystemDate {
    date : LocalDate
  }
}

package es.upm.parque.business.controller {

  class UserController {
  }

  class GroupController {
  }

  class TicketController {
    price : BigDecimal
  }

  class AttractionController {
  }
}

package es.upm.parque.business.validation {

  class UserValidator {
  }
}

package es.upm.parque.persistence {

  class UserRepository {
    file : Path
  }

  class GroupRepository {
    file : Path
  }

  class TicketRepository {
    individualFile : Path
    groupFile : Path
  }

  class AttractionRepository {
    file : Path
  }

  class TemporaryDataDirectory {
    path : Path
  }
}

' Inheritance
Ticket <|-- IndividualTicket
Ticket <|-- GroupTicket

' Associations, aggregations and compositions (named after the owning field)
CommandProcessor x--> "1" UserController : userController
CommandProcessor x--> "1" GroupController : groupController
CommandProcessor x--> "1" TicketController : ticketController
CommandProcessor x--> "1" AttractionController : attractionController
CommandProcessor x--> "1" SystemDate : systemDate

UserController x--> "1" UserRepository : repository
UserController x--> "0..*" User : users

GroupController x--> "1" GroupRepository : repository
GroupController x--> "1" UserController : userController
GroupController x--> "0..*" Group : groups
Group x--> "0..*" User : members

TicketController x--> "1" TicketRepository : repository
TicketController x--> "1" UserController : userController
TicketController x--> "1" GroupController : groupController
TicketController x--> "1" SystemDate : systemDate
TicketController x--> "0..*" Ticket : tickets
IndividualTicket x--> "1" User : user
GroupTicket o--> "1" Group : group
GroupTicket *--> "1..*" IndividualTicket : tickets

AttractionController x--> "1" AttractionRepository : repository
AttractionController x--> "1" TicketController : ticketController
AttractionController x--> "1" SystemDate : systemDate
AttractionController x--> "0..*" Attraction : attractions
Attraction x--> "0..*" User : present

' Usage, only for classes without incoming relationships
App ..> CommandProcessor
App ..> TemporaryDataDirectory
CommandProcessor ..> UserField
UserController ..> UserField
UserController ..> UserValidator
GroupController ..> UserValidator
TicketController ..> UserValidator
AttractionController ..> UserValidator

@enduml
