@startuml model
' Amusement Park - Delivery 3 design (es.upm.amusementpark), layered packages
hide methods
hide empty members
skinparam classAttributeIconSize 0

package presentation {
  class App
  class ApplicationInitializer <<composition root>>
  class CommandProcessor
  class HelpGenerator
  interface HelpFormat
  class SyntaxHelpFormat
  class ExtendedHelpFormat
}

package business.control {
  class Park <<singleton>> {
    - currentDate : LocalDate
    - currentPrice : BigDecimal
    {static} + INITIAL_PRICE : BigDecimal = 40.00
  }
}

package business.service {
  class UserService <<singleton>>
  class GroupService <<singleton>>
  class TicketService <<singleton>>
  class AttractionService <<singleton>>
  class PassService <<singleton>>
  class InvoiceService <<singleton>> <<director>>
}

package business.security {
  interface PasswordEncoder
  class BCryptPasswordEncoder
}

package business.invoice {
  abstract class InvoiceBuilder<B extends InvoiceBuilder<B>> {
    - title : String
  }
  class UserInvoiceBuilder
  class GroupInvoiceBuilder
  class Invoice {
    - title : String
    - total : BigDecimal
  }
  class InvoiceLine <<record>> {
    - description : String
    - amount : BigDecimal
    - counted : boolean
  }
}

package business.model {
  class User {
    - firstName : String
    - surnames : String
    - dni : String {readOnly}
    - email : String
    - password : String (BCrypt)
    - telephone : String
    - cardNumber : String
  }

  enum UserField {
    NAME
    SURNAME
    EMAIL
    PASSWORD
    PHONE
    CARD
  }

  class UserValidator <<utility>>

  class Group {
    - identifier : String {readOnly}
    - name : String
  }

  interface TicketAccess
  interface IndividualAccess
  interface GroupAccess

  abstract class Ticket {
    - identifier : String {readOnly}
    - date : LocalDate {readOnly}
  }

  class IndividualTicket {
    - price : BigDecimal {readOnly}
  }

  class GroupTicket {
    - groupIdentifier : String {readOnly}
  }

  enum GroupDiscount {
    NONE (0..2 : 0%)
    SMALL (3..5 : 10%)
    MEDIUM (6..10 : 20%)
    LARGE (11.. : 50%)
    - percent : int
  }

  abstract class Pass {
    - identifier : String {readOnly}
    - price : BigDecimal {readOnly}
    - consumed : boolean
  }

  class SpeedPass {
    {static} + RATE : BigDecimal = 0.20
  }

  class SpecialPass

  interface PassLookup
  class EntryResult <<record>>

  abstract class Attraction<T extends TicketAccess> {
    - identifier : String {readOnly}
    - name : String
    - capacity : int {readOnly}
    - accessType : Class<T> {readOnly}
  }

  class GeneralAttraction
  class IndividualAttraction
  class GroupAttraction
  class SpecialAttraction

  enum AttractionType {
    GENERAL
    INDIVIDUAL
    GROUP
    SPECIAL
  }
}

package persistence.repository {
  class Repositories <<record>>
  class UserRepository
  class GroupRepository
  class TicketRepository
  class AttractionRepository
  class PassRepository
}

package persistence.storage {
  interface UserStorage
  interface GroupStorage
  interface TicketStorage
  interface AttractionStorage
  interface PassStorage
  class UserFileStorage
  class GroupFileStorage
  class TicketFileStorage
  class AttractionFileStorage
  class PassFileStorage
  class DataDirectory
}

' --- ticket hierarchy and access capabilities
TicketAccess <|-- IndividualAccess
TicketAccess <|-- GroupAccess
TicketAccess <|.. Ticket
Ticket <|-- IndividualTicket
Ticket <|-- GroupTicket
IndividualAccess <|.. IndividualTicket
GroupAccess <|.. GroupTicket

' --- generic attractions
Attraction <|-- GeneralAttraction : <T = TicketAccess>
Attraction <|-- IndividualAttraction : <T = IndividualAccess>
Attraction <|-- GroupAttraction : <T = GroupAccess>
Attraction <|-- SpecialAttraction : <T = IndividualAccess>
Attraction ..> AttractionType : type
Attraction ..> PassLookup : uses on entry
Attraction ..> EntryResult : creates
EntryResult --> "0..*" Pass : consumedPasses
EntryResult --> "1..*" User : users

' --- passes
Pass <|-- SpeedPass
Pass <|-- SpecialPass
SpeedPass "0..*" --> "1" IndividualTicket : ticket
SpecialPass "0..1" --> "1" IndividualTicket : ticket

' --- model relationships (all unidirectional; User references nothing)
IndividualTicket --> "1" User : user
GroupTicket *-- "1..*" IndividualTicket : composition
GroupTicket --> "0..1" Group : group
Group --> "0..*" User : members
Attraction --> "0..*" User : occupants
GroupTicket ..> GroupDiscount : price rule
UserValidator ..> User : validates
UserField ..> User : modifiable field of

' --- invoice Builder
InvoiceBuilder <|-- UserInvoiceBuilder
InvoiceBuilder <|-- GroupInvoiceBuilder
InvoiceBuilder ..> Invoice : builds
Invoice *-- "0..*" InvoiceLine : sections
InvoiceService ..> UserInvoiceBuilder : directs
InvoiceService ..> GroupInvoiceBuilder : directs

' --- security
PasswordEncoder <|.. BCryptPasswordEncoder
UserService --> "1" PasswordEncoder : injected

' --- help strategies
HelpFormat <|.. SyntaxHelpFormat
HelpFormat <|.. ExtendedHelpFormat
HelpGenerator --> "1" HelpFormat : injected

' --- composition root and dependency injection
App ..> ApplicationInitializer : initialize(Repositories)
App ..> DataDirectory : --fly
ApplicationInitializer ..> Repositories : receives
ApplicationInitializer ..> Park : injects
ApplicationInitializer ..> UserService : injects
ApplicationInitializer ..> GroupService : injects
ApplicationInitializer ..> TicketService : injects
ApplicationInitializer ..> AttractionService : injects
ApplicationInitializer ..> PassService : injects
ApplicationInitializer ..> InvoiceService : injects
ApplicationInitializer ..> CommandProcessor : creates
CommandProcessor --> "1" UserService
CommandProcessor --> "1" GroupService
CommandProcessor --> "1" TicketService
CommandProcessor --> "1" AttractionService
CommandProcessor --> "1" PassService
CommandProcessor --> "1" InvoiceService
CommandProcessor --> "2" HelpGenerator : HELP / HELP EXTENDED

' --- central management and storage
Park --> "1" UserRepository : users
Park --> "1" GroupRepository : groups
Park --> "1" TicketRepository : tickets
Park --> "1" AttractionRepository : attractions
Park --> "1" PassRepository : passes
Repositories o-- UserRepository
Repositories o-- GroupRepository
Repositories o-- TicketRepository
Repositories o-- AttractionRepository
Repositories o-- PassRepository
UserService --> UserRepository
TicketService --> TicketRepository
TicketService --> PassRepository : cascade
AttractionService --> AttractionRepository
AttractionService --> PassRepository
PassService --> PassRepository
UserRepository o-- "0..*" User
GroupRepository o-- "0..*" Group
TicketRepository o-- "0..*" Ticket
AttractionRepository o-- "0..*" Attraction
PassRepository o-- "0..*" Pass
UserRepository --> "1" UserStorage
GroupRepository --> "1" GroupStorage
TicketRepository --> "1" TicketStorage
AttractionRepository --> "1" AttractionStorage
PassRepository --> "1" PassStorage
UserStorage <|.. UserFileStorage
GroupStorage <|.. GroupFileStorage
TicketStorage <|.. TicketFileStorage
AttractionStorage <|.. AttractionFileStorage
PassStorage <|.. PassFileStorage
@enduml
