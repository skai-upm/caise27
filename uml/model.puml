@startuml model
' Amusement Park - class model of the current implementation (package es.upm.parque).
' Conventions: attributes only of primitive/value/enum types, no methods, no visibility labels.
' Relationships follow field navigability: cross (or diamond) at the class holding the attribute,
' arrowhead at the referenced class, named after the holding attribute.
' Usage (..>) is shown only for classes without any incoming relationship.
hide empty methods
skinparam classAttributeIconSize 0

class App

class CommandProcessor

class "CommandProcessor.Command" as Command {
  syntax : String
  parameters : int
}

class ParkController {
  currentDate : LocalDate
  ticketPrice : BigDecimal
}

class TemporaryStorage {
  base : Path
  directory : Path
}

class UserManager
class GroupManager
class TicketManager
class AttractionManager

class UserRepository {
  file : Path
}
class GroupRepository {
  file : Path
}
class TicketRepository {
  ticketsFile : Path
  groupTicketsFile : Path
}
class AttractionRepository {
  file : Path
}
class TextStore

class User {
  name : String
  surnames : String
  dni : String
  email : String
  password : String
  phone : String
  card : String
}

enum UserField {
  NAME
  SURNAME
  EMAIL
  PASSWORD
  PHONE
  CARD
}

class UserValidator

class Group {
  id : String
  name : String
}

abstract class Ticket {
  id : String
  date : LocalDate
  price : BigDecimal
}

class IndividualTicket
class GroupTicket

class Attraction {
  id : String
  name : String
  capacity : int
}

class ParkException
class UserException

' ---- Inheritance ----
Ticket <|-- IndividualTicket
Ticket <|-- GroupTicket
ParkException <|-- UserException

' ---- Associations, aggregation and composition ----
CommandProcessor x--> "*" Command : commands
ParkController x--> "1" UserManager : userManager
ParkController x--> "1" GroupManager : groupManager
ParkController x--> "1" TicketManager : ticketManager
ParkController x--> "1" AttractionManager : attractionManager

UserManager x--> "1" UserRepository : repository
UserManager x--> "*" User : users
GroupManager x--> "1" GroupRepository : repository
GroupManager x--> "*" Group : groups
TicketManager x--> "1" TicketRepository : repository
TicketManager x--> "*" IndividualTicket : individualTickets
TicketManager x--> "*" GroupTicket : groupTickets
AttractionManager x--> "1" AttractionRepository : repository
AttractionManager x--> "*" Attraction : attractions

Group x--> "*" User : members
IndividualTicket x--> "1" User : user
GroupTicket o--> "1" Group : group
GroupTicket *--> "*" IndividualTicket : tickets
Attraction x--> "*" User : present

' ---- Usage of classes without incoming relationships ----
App ..> CommandProcessor
App ..> ParkController
App ..> TemporaryStorage
UserManager ..> UserField
UserManager ..> UserValidator
UserManager ..> UserException
ParkController ..> ParkException
UserRepository ..> TextStore
GroupRepository ..> TextStore
TicketRepository ..> TextStore
AttractionRepository ..> TextStore

@enduml
