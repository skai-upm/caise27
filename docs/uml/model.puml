@startuml model
title Parque - class model

skinparam classAttributeIconSize 0
hide empty members

package es.upm.parque {

  class App {
    {static} ~USERS_FILE : Path
    {static} ~GROUPS_FILE_NAME : String
    +{static} main(args : String[]) : void
    ~{static} run(args : String[], stdin : InputStream, out : PrintStream, usersFile : Path) : void
  }

  class CommandProcessor {
    -currentDate : LocalDate
    -exitRequested : boolean
    +run(in : BufferedReader, out : PrintStream) : void
    +execute(line : String) : String
    +getCurrentDate() : LocalDate
    +isExitRequested() : boolean
  }

  class UserManager {
    -usersByDni : Map<String, User>
    +create(name, surname, dni, email, password, phone, card) : User
    +delete(email : String, password : String) : User
    +update(email : String, password : String, field : UserField, value : String) : void
    +findByEmail(email : String) : User
    +findByDni(dni : String) : User
    +getUsers() : Collection<User>
  }

  class UserStorage {
    -file : Path
    +load() : List<User>
    +save(users : Collection<User>) : void
  }

  class User {
    -name : String
    -surname : String
    -dni : String {readOnly}
    -email : String
    -password : String
    -phone : String
    -card : String
    +checkPassword(candidate : String) : boolean
  }

  enum UserField {
    NAME
    SURNAME
    EMAIL
    PASSWORD
    PHONE
    CARD
  }

  class UserValidator <<utility>> {
    +{static} isValidDni(dni : String) : boolean
    +{static} isValidEmail(email : String) : boolean
    +{static} isValidPassword(password : String) : boolean
    +{static} isValidCard(card : String) : boolean
    +{static} isNotBlank(value : String) : boolean
  }

  class GroupManager {
    -groupsById : Map<String, Group>
    +create(id : String, name : String) : Group
    +delete(id : String) : void
    +addMember(id : String, email : String) : void
    +removeMember(id : String, email : String) : void
    +removeUserFromAll(user : User) : void
    +find(id : String) : Group
  }

  class GroupStorage {
    -file : Path
    +load(userByDni : Function<String, User>) : List<Group>
    +save(groups : Collection<Group>) : void
  }

  class Group {
    -id : String {readOnly}
    -name : String
    +addMember(user : User) : boolean
    +removeMember(user : User) : boolean
    +isMember(user : User) : boolean
  }
}

App ..> CommandProcessor : creates
CommandProcessor "1" --> "1" UserManager : users
CommandProcessor "1" --> "1" GroupManager : groups
UserManager "1" --> "1" UserStorage : storage
UserManager "1" o--> "0..*" User : users
UserManager ..> UserValidator
UserManager ..> UserField
GroupManager "1" --> "1" GroupStorage : storage
GroupManager "1" --> "1" UserManager : users
GroupManager "1" o--> "0..*" Group : groups
Group "0..*" o--> "0..*" User : members
UserStorage ..> User
GroupStorage ..> Group

@enduml
