@startuml model
title Parque - class model

skinparam classAttributeIconSize 0
hide empty members

package es.upm.parque {

  class App {
    {static} ~USERS_FILE : Path
    {static} ~GROUPS_FILE_NAME : String
    {static} ~TICKETS_FILE_NAME : String
    {static} ~GROUP_TICKETS_FILE_NAME : String
    {static} ~ATTRACTIONS_FILE_NAME : String
    +{static} main(args : String[]) : void
    ~{static} run(args : String[], stdin : InputStream, out : PrintStream, usersFile : Path) : void
  }

  class CommandProcessor {
    -currentDate : LocalDate
    -currentPrice : BigDecimal
    -exitRequested : boolean
    +run(in : BufferedReader, out : PrintStream) : void
    +execute(line : String) : String
    +getCurrentDate() : LocalDate
    +getCurrentPrice() : BigDecimal
    +isExitRequested() : boolean
  }

  class UserManager {
    -usersByDni : Map<String, User>
    +create(name, surname, dni, email, password, phone, card) : User
    +delete(email : String, password : String) : User
    +authenticate(email : String, password : String) : User
    +update(email : String, password : String, field : UserField, value : String) : void
    +findByEmail(email : String) : User
    +findByDni(dni : String) : User
    +getUsers() : Collection<User>
  }

  class UserStorage {
    -file : Path
    +load() : List<User>
    +save(users : Collection<User>) : void
  }

  class User {
    -name : String
    -surname : String
    -dni : String {readOnly}
    -email : String
    -password : String
    -phone : String
    -card : String
    +checkPassword(candidate : String) : boolean
  }

  enum UserField {
    NAME
    SURNAME
    EMAIL
    PASSWORD
    PHONE
    CARD
  }

  class UserValidator <<utility>> {
    +{static} isValidDni(dni : String) : boolean
    +{static} isValidEmail(email : String) : boolean
    +{static} isValidPassword(password : String) : boolean
    +{static} isValidCard(card : String) : boolean
    +{static} isNotBlank(value : String) : boolean
  }

  class GroupManager {
    -groupsById : Map<String, Group>
    +create(id : String, name : String) : Group
    +delete(id : String) : void
    +addMember(id : String, email : String) : void
    +removeMember(id : String, email : String) : void
    +removeUserFromAll(user : User) : void
    +find(id : String) : Group
  }

  class GroupStorage {
    -file : Path
    +load(userByDni : Function<String, User>) : List<Group>
    +save(groups : Collection<Group>) : void
  }

  class Group {
    -id : String {readOnly}
    -name : String
    +addMember(user : User) : boolean
    +removeMember(user : User) : boolean
    +isMember(user : User) : boolean
  }

  class TicketManager {
    -ticketsById : Map<String, Ticket>
    +create(id : String, email : String, date : LocalDate, today : LocalDate, price : BigDecimal) : Ticket
    +createGroupTicket(id : String, groupId : String, date : LocalDate, today : LocalDate, price : BigDecimal) : GroupTicket
    +delete(id : String, today : LocalDate) : void
    +deleteGroupTicket(id : String, today : LocalDate) : void
    +hasTicketOnOrAfter(user : User, today : LocalDate) : boolean
    +isGroupLocked(group : Group, today : LocalDate) : boolean
    +detachOwner(user : User) : void
    +detachGroup(group : Group) : void
    +find(id : String) : Ticket
    +findAdmission(id : String) : Ticket
  }

  class TicketStorage {
    -ticketsFile : Path
    -groupTicketsFile : Path
    +load(userByDni : Function<String, User>, groupById : Function<String, Group>) : List<Ticket>
    +save(tickets : Collection<Ticket>) : void
  }

  interface Admission {
    +getAdmittedUsers() : List<User>
    +isValidOn(day : LocalDate) : boolean
  }

  abstract class Ticket {
    -id : String {readOnly}
    -date : LocalDate {readOnly}
    +isCurrentOrFuture(today : LocalDate) : boolean
    +isValidOn(day : LocalDate) : boolean
    +{abstract} getPrice() : BigDecimal
  }

  class IndividualTicket {
    -price : BigDecimal {readOnly}
    -ownerDni : String {readOnly}
    -groupTicketId : String {readOnly}
    +getPrice() : BigDecimal
    +getAdmittedUsers() : List<User>
    +isOwnedBy(user : User) : boolean
    +detachOwner() : void
  }

  class GroupTicket {
    -groupId : String {readOnly}
    -basePrice : BigDecimal {readOnly}
    -discountPercent : int {readOnly}
    +{static} discountFor(members : int) : int
    +getPrice() : BigDecimal
    +getAdmittedUsers() : List<User>
    +isForGroup(group : Group) : boolean
    +detachGroup() : void
  }

  class AttractionManager {
    -attractionsById : Map<String, Attraction>
    +create(id : String, name : String, capacity : String) : Attraction
    +delete(id : String) : void
    +enter(id : String, admission : Admission, today : LocalDate) : void
    +exit(id : String, admission : Admission) : int
    +removeUserEverywhere(user : User) : void
    +require(id : String) : Attraction
  }

  class AttractionStorage {
    -file : Path
    +load() : List<Attraction>
    +save(attractions : Collection<Attraction>) : void
  }

  class Attraction {
    -id : String {readOnly}
    -name : String {readOnly}
    -capacity : int {readOnly}
    +enter(admission : Admission, today : LocalDate) : void
    +exit(admission : Admission) : int
    +remove(user : User) : void
    +getAvailable() : int
  }
}

App ..> CommandProcessor : creates
CommandProcessor "1" --> "1" UserManager : users
CommandProcessor "1" --> "1" GroupManager : groups
CommandProcessor "1" --> "1" TicketManager : tickets
CommandProcessor "1" --> "1" AttractionManager : attractions
UserManager "1" --> "1" UserStorage : storage
UserManager "1" o--> "0..*" User : users
UserManager ..> UserValidator
UserManager ..> UserField
GroupManager "1" --> "1" GroupStorage : storage
GroupManager "1" --> "1" UserManager : users
GroupManager "1" o--> "0..*" Group : groups
Group "0..*" o--> "0..*" User : members
UserStorage ..> User
GroupStorage ..> Group
TicketManager "1" --> "1" TicketStorage : storage
TicketManager "1" --> "1" UserManager : users
TicketManager "1" --> "1" GroupManager : groups
TicketManager "1" o--> "0..*" Ticket : tickets
Admission <|.. Ticket
Ticket <|-- IndividualTicket
Ticket <|-- GroupTicket
IndividualTicket "0..*" --> "0..1" User : owner
GroupTicket "0..*" o--> "0..1" Group : group
GroupTicket "1" *-- "1..*" IndividualTicket : components
TicketStorage ..> Ticket
AttractionManager "1" --> "1" AttractionStorage : storage
AttractionManager "1" o--> "0..*" Attraction : attractions
Attraction "0..*" o--> "0..*" User : present
Attraction ..> Admission : enter/exit
AttractionStorage ..> Attraction

@enduml
