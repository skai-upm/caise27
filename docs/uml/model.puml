@startuml model
' Class model of the amusement-park application (package es.upm.park)
skinparam classAttributeIconSize 0
hide empty members

package es.upm.park {

  class App {
    {static} +main(args : String[]) : void
  }

  class CommandRunner {
    +run(in : BufferedReader, out : PrintStream) : void
  }

  class CommandProcessor {
    -exitRequested : boolean
    -currentDate : LocalDate
    -currentPrice : BigDecimal
    +process(line : String) : String
    +isExitRequested() : boolean
    +getCurrentDate() : LocalDate
    +getCurrentPrice() : BigDecimal
  }

  class UserManager {
    +create(...) : void
    +delete(email : String, password : String) : User
    +update(email : String, password : String, field : UserField, value : String) : void
    +authenticate(email : String, password : String) : User
    +findByEmail(email : String) : User
    +findByDni(dni : String) : User
  }

  class UserFileStorage {
    -file : Path
    +load() : List<User>
    +save(users : List<User>) : void
  }

  class UserValidator <<utility>> {
    {static} +isValidDni(dni : String) : boolean
    {static} +isValidEmail(email : String) : boolean
    {static} +isValidPassword(password : String) : boolean
    {static} +isValidCard(card : String) : boolean
    {static} +isNonBlank(value : String) : boolean
  }

  class User {
    -name : String
    -surnames : String
    -dni : String {readOnly}
    -email : String
    -password : String
    -phone : String
    -card : String
  }

  enum UserField {
    NAME
    SURNAME
    EMAIL
    PASSWORD
    PHONE
    CARD
  }

  class GroupManager {
    +create(id : String, name : String) : void
    +delete(id : String) : void
    +addMember(id : String, email : String) : void
    +removeMember(id : String, email : String) : void
    +removeUserFromAllGroups(user : User) : void
    +find(id : String) : Group
  }

  class GroupFileStorage {
    -file : Path
    +load(userByDni : Function<String, User>) : List<Group>
    +save(groups : Collection<Group>) : void
  }

  class Group {
    -id : String {readOnly}
    -name : String {readOnly}
    +contains(user : User) : boolean
  }

  class TicketManager {
    +create(id : String, owner : User, date : LocalDate, price : BigDecimal, today : LocalDate) : IndividualTicket
    +delete(id : String, today : LocalDate) : void
    +createGroupTicket(id : String, group : Group, date : LocalDate, price : BigDecimal, today : LocalDate) : GroupTicket
    +deleteGroupTicket(id : String, today : LocalDate) : void
    +hasTicketOnOrAfter(user : User, today : LocalDate) : boolean
    +hasGroupTicketOnOrAfter(group : Group, today : LocalDate) : boolean
    +getAllTickets() : List<Ticket>
    +findAnyTicket(id : String) : Ticket
  }

  class TicketFileStorage {
    -file : Path
    +load(userByDni : Function<String, User>) : List<IndividualTicket>
    +save(tickets : Collection<IndividualTicket>) : void
  }

  class GroupTicketFileStorage {
    -file : Path
    +load(groupById : Function<String, Group>, userByDni : Function<String, User>) : List<GroupTicket>
    +save(tickets : Collection<GroupTicket>) : void
  }

  abstract class Ticket {
    -id : String {readOnly}
    -date : LocalDate {readOnly}
    +isOnOrAfter(day : LocalDate) : boolean
    {abstract} +getHolders() : List<User>
    {abstract} +getPrice() : BigDecimal
  }

  class IndividualTicket {
    -price : BigDecimal {readOnly}
    -ownerDni : String {readOnly}
    +getHolders() : List<User>
    +getPrice() : BigDecimal
  }

  class GroupTicket {
    -groupId : String {readOnly}
    -individualPrice : BigDecimal {readOnly}
    -total : BigDecimal {readOnly}
    {static} +discountPercent(members : int) : int
    +getHolders() : List<User>
    +getPrice() : BigDecimal
  }

  class AttractionManager {
    +create(id : String, name : String, capacity : String) : Attraction
    +find(id : String) : Attraction
  }

  class AttractionFileStorage {
    -file : Path
    +load() : List<Attraction>
    +save(attractions : Collection<Attraction>) : void
  }

  class Attraction {
    -id : String {readOnly}
    -name : String {readOnly}
    -capacity : int {readOnly}
    +enter(ticket : Ticket, today : LocalDate) : void
    +exit(ticket : Ticket) : int
    +getPresentCount() : int
    +getAvailablePlaces() : int
  }
}

App ..> CommandRunner : creates
CommandRunner --> "1" CommandProcessor : processor
CommandProcessor --> "1" UserManager : users
CommandProcessor --> "1" GroupManager : groups
UserManager --> "1" UserFileStorage : storage
UserManager "1" *-- "0..*" User : users
UserManager ..> UserValidator
UserManager ..> UserField
GroupManager --> "1" GroupFileStorage : storage
GroupManager --> "1" UserManager : users
GroupManager "1" *-- "0..*" Group : groups
Group "0..*" o-- "0..*" User : members
CommandProcessor --> "1" TicketManager : tickets
TicketManager --> "1" TicketFileStorage : storage
TicketManager "1" *-- "0..*" IndividualTicket : standalone tickets
TicketManager "1" *-- "0..*" GroupTicket : group tickets
TicketManager --> "1" GroupTicketFileStorage : groupStorage
TicketManager ..> UserManager : resolves owners
TicketManager ..> GroupManager : resolves groups
Ticket <|-- IndividualTicket
Ticket <|-- GroupTicket
IndividualTicket "0..*" --> "0..1" User : owner
GroupTicket "0..*" o-- "0..1" Group : group
GroupTicket "1" *-- "1..*" IndividualTicket : constituents
CommandProcessor --> "1" AttractionManager : attractions
AttractionManager --> "1" AttractionFileStorage : storage
AttractionManager "1" *-- "0..*" Attraction : attractions
Attraction "0..*" o-- "0..*" User : present
Attraction ..> Ticket : admits holders
@enduml
